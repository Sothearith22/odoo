<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_public_holiday_import_wizard_form" model="ir.ui.view">
        <field name="name">public.holiday.import.wizard.form</field>
        <field name="model">public.holiday.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Cambodia Public Holidays">
                <field name="state" invisible="1"/>
                <div invisible="state != 'draft'">
                    <p class="text-muted">
                        Upload a CSV or Excel (.xlsx) file containing holiday details.
                        Required columns: <code>name, name_km, date_from, date_to, holiday_type</code>.
                    </p>
                    <div class="mb-3">
                        <button name="action_download_template"
                                type="object"
                                string="Download Sample CSV Template"
                                class="btn-link"
                                icon="fa-download"/>
                    </div>
                    <group>
                        <field name="file" filename="filename" widget="binary"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </div>
                <div invisible="state != 'done'">
                    <div class="alert alert-info" role="alert">
                        <h4>Import Finished</h4>
                        <div class="row text-center mt-3 mb-2">
                            <div class="col-4">
                                <span class="d-block text-success fs-3 fw-bold"><field name="created_count"/></span>
                                <span class="text-muted">Created</span>
                            </div>
                            <div class="col-4">
                                <span class="d-block text-warning fs-3 fw-bold"><field name="skipped_count"/></span>
                                <span class="text-muted">Skipped (Duplicates)</span>
                            </div>
                            <div class="col-4">
                                <span class="d-block text-danger fs-3 fw-bold"><field name="error_count"/></span>
                                <span class="text-muted">Errors</span>
                            </div>
                        </div>
                    </div>
                    <group string="Log / Details">
                        <field name="result_summary" nolabel="1" readonly="1"/>
                    </group>
                </div>
                <footer>
                    <button name="action_import"
                            string="Import Holidays"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            invisible="state != 'draft'"/>
                    <button string="Close"
                            class="btn-primary"
                            special="cancel"
                            invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_public_holiday_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Public Holidays</field>
        <field name="res_model">public.holiday.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
