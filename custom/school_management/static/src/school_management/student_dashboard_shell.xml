<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="school_management.StudentDashboardShell" owl="1">
        <main class="o_student_dashboard h-100 overflow-auto bg-view">
            <t t-if="state.loading">
                <div class="o_student_dashboard_empty text-muted">Loading your dashboard...</div>
            </t>
            <t t-elif="state.error">
                <div class="o_student_dashboard_empty text-danger">
                    <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"></i>
                    <t t-esc="state.error"/>
                </div>
            </t>
            <t t-elif="!state.student">
                <div class="o_student_dashboard_empty">
                    <i class="fa fa-user-o fa-2x mb-3 text-muted" aria-hidden="true"></i>
                    <h2 class="h4">Student profile not linked</h2>
                    <p class="text-muted mb-0">Ask an administrator to link this login to your student record.</p>
                </div>
            </t>
            <t t-else="">
                <header class="o_student_dashboard_header px-4 py-4 border-bottom">
                    <div class="container-fluid px-0">
                        <div class="text-uppercase small fw-semibold text-muted">Student Portal</div>
                        <h1 class="h2 mb-1 mt-2">Welcome, <t t-esc="state.student.name"/></h1>
                        <div class="text-muted">
                            <span t-esc="state.student.student_id || 'Student ID not assigned'"/>
                            <span class="mx-2">•</span>
                            <span t-esc="state.student.status"/>
                        </div>
                    </div>
                </header>

                <div class="container-fluid px-4 py-4">
                    <div class="row g-4 mb-4">
                        <!-- Profile Card -->
                        <div class="col-12 col-xl-4">
                            <section class="card border-0 shadow-sm h-100 o_student_profile_card">
                                <div class="card-body text-center py-4">
                                    <!-- Avatar -->
                                    <div class="o_student_avatar_wrap mx-auto mb-3">
                                        <t t-if="state.student.image_1920">
                                            <img t-att-src="'/web/image/university.student/' + state.student.id + '/image_1920'"
                                                 class="o_student_avatar rounded-circle"
                                                 alt="Student photo"/>
                                        </t>
                                        <t t-else="">
                                            <div class="o_student_avatar_placeholder rounded-circle d-flex align-items-center justify-content-center">
                                                <i class="fa fa-user fa-3x text-white" aria-hidden="true"></i>
                                            </div>
                                        </t>
                                    </div>
                                    <h2 class="h4 mb-1" t-esc="state.student.name"/>
                                    <div class="text-muted small mb-2" t-esc="state.student.student_id || '—'"/>
                                    <!-- Status badge -->
                                    <span t-if="state.student.status === 'active'" class="badge text-bg-success">Active</span>
                                    <span t-elif="state.student.status === 'suspended'" class="badge text-bg-warning">Suspended</span>
                                    <span t-elif="state.student.status === 'graduated'" class="badge text-bg-info">Graduated</span>
                                    <span t-elif="state.student.status === 'dropped'" class="badge text-bg-danger">Dropped</span>
                                </div>
                                <div class="card-footer bg-transparent border-top-0 pb-4 px-4">
                                    <dl class="row mb-0 text-start">
                                        <t t-if="state.student.email">
                                            <dt class="col-sm-4 text-muted fw-normal small">Email</dt>
                                            <dd class="col-sm-8 small text-truncate" t-esc="state.student.email"/>
                                        </t>
                                        <t t-if="state.student.phone">
                                            <dt class="col-sm-4 text-muted fw-normal small">Phone</dt>
                                            <dd class="col-sm-8 small" t-esc="state.student.phone"/>
                                        </t>
                                        <t t-if="state.student.gender">
                                            <dt class="col-sm-4 text-muted fw-normal small">Gender</dt>
                                            <dd class="col-sm-8 small text-capitalize" t-esc="state.student.gender"/>
                                        </t>
                                        <t t-if="state.student.date_of_birth">
                                            <dt class="col-sm-4 text-muted fw-normal small">Birthday</dt>
                                            <dd class="col-sm-8 small" t-esc="state.student.date_of_birth"/>
                                        </t>
                                    </dl>
                                    <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-3"
                                            t-on-click="() => this.openMyProfile()">
                                        <i class="fa fa-user me-2" aria-hidden="true"/>View My Full Profile
                                    </button>
                                </div>
                            </section>
                        </div>

                        <!-- Stats + Academic + Fee -->
                        <div class="col-12 col-xl-8">
                            <!-- Stat Cards -->
                            <div class="row g-3 mb-4">
                                <div class="col-12 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm o_student_stat_card">
                                        <div class="card-body">
                                            <div class="text-muted small">Enrollments</div>
                                            <div class="fs-2 fw-bold mt-2" t-esc="state.enrollmentCount"/>
                                            <i class="fa fa-book text-primary o_student_stat_icon" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm o_student_stat_card">
                                        <div class="card-body">
                                            <div class="text-muted small">Fee invoices</div>
                                            <div class="fs-2 fw-bold mt-2" t-esc="state.feeCount"/>
                                            <i class="fa fa-file-text-o text-warning o_student_stat_icon" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="card h-100 border-0 shadow-sm o_student_stat_card">
                                        <div class="card-body">
                                            <div class="text-muted small">Payments</div>
                                            <div class="fs-2 fw-bold mt-2" t-esc="state.paymentCount"/>
                                            <i class="fa fa-credit-card text-success o_student_stat_icon" aria-hidden="true"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-4">
                                <!-- Academic profile -->
                                <div class="col-12 col-md-6">
                                    <section class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-transparent py-3">
                                            <h2 class="h5 mb-0">
                                                <i class="fa fa-graduation-cap me-2 text-primary" aria-hidden="true"/>
                                                Academic Profile
                                            </h2>
                                        </div>
                                        <div class="card-body">
                                            <dl class="row mb-0">
                                                <dt class="col-sm-5 text-muted fw-normal">Program</dt>
                                                <dd class="col-sm-7" t-esc="this.relationLabel(state.student.program_id)"/>
                                                <dt class="col-sm-5 text-muted fw-normal">Department</dt>
                                                <dd class="col-sm-7" t-esc="this.relationLabel(state.student.department_id)"/>
                                                <dt class="col-sm-5 text-muted fw-normal">Faculty</dt>
                                                <dd class="col-sm-7" t-esc="this.relationLabel(state.student.faculty_id)"/>
                                                <dt class="col-sm-5 text-muted fw-normal">Academic year</dt>
                                                <dd class="col-sm-7" t-esc="this.relationLabel(state.student.academic_year_id)"/>
                                                <dt class="col-sm-5 text-muted fw-normal">Semester</dt>
                                                <dd class="col-sm-7 mb-0" t-esc="this.relationLabel(state.student.current_semester_id)"/>
                                            </dl>
                                        </div>
                                    </section>
                                </div>

                                <!-- Fee Summary -->
                                <div class="col-12 col-md-6">
                                    <section class="card border-0 shadow-sm h-100">
                                        <div class="card-header bg-transparent py-3">
                                            <h2 class="h5 mb-0">
                                                <i class="fa fa-money me-2 text-success" aria-hidden="true"/>
                                                Fee Summary
                                            </h2>
                                        </div>
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between py-2 border-bottom">
                                                <span class="text-muted">Total</span>
                                                <strong t-esc="state.student.fee_total"/>
                                            </div>
                                            <div class="d-flex justify-content-between py-2 border-bottom">
                                                <span class="text-muted">Paid</span>
                                                <strong class="text-success" t-esc="state.student.fee_paid"/>
                                            </div>
                                            <div class="d-flex justify-content-between py-2">
                                                <span class="text-muted">Balance</span>
                                                <strong class="text-danger" t-esc="state.student.fee_balance"/>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" class="btn btn-primary" t-on-click="() => this.navigate('school_management.action_university_enrollment_student')">
                            <i class="fa fa-book me-2" aria-hidden="true"></i>My Enrollments
                        </button>
                        <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.navigate('school_management.action_university_fee_student')">
                            <i class="fa fa-file-text-o me-2" aria-hidden="true"></i>My Fees
                        </button>
                        <button type="button" class="btn btn-outline-secondary" t-on-click="() => this.navigate('school_management.action_university_payment_student')">
                            <i class="fa fa-credit-card me-2" aria-hidden="true"></i>My Payments
                        </button>
                    </div>
                </div>
            </t>
        </main>
    </t>

</templates>
