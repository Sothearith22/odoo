<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.WebClient" t-inherit-mode="extension" owl="1">
        <!-- Hide standard navbar conditionally -->
        <xpath expr="//NavBar" position="attributes">
            <attribute name="t-if">!state.fullscreen and !schoolState.isActive</attribute>
        </xpath>
        
        <!-- Conditionally wrap ActionContainer -->
        <xpath expr="//ActionContainer" position="replace">
            <t t-if="schoolState.isActive">
                <SchoolLayout>
                    <ActionContainer/>
                </SchoolLayout>
            </t>
            <t t-else="">
                <ActionContainer/>
            </t>
        </xpath>
    </t>
</templates>
