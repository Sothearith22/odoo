<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="school_management.TeacherDashboardShell">
        <div class="o_action o_view_controller teacher_dashboard_shell">
            <!-- Loading State -->
            <div t-if="state.loading" class="o_view_nocontent d-flex align-items-center justify-content-center py-5">
                <div class="text-center">
                    <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted fw-medium">Loading your teacher dashboard...</p>
                </div>
            </div>

            <!-- Error State -->
            <div t-elif="state.error" class="o_view_nocontent d-flex align-items-center justify-content-center py-5">
                <div class="text-center p-4 rounded-3 border bg-white shadow-sm" style="max-width: 480px;">
                    <div class="o_empty_icon text-danger mb-3">
                        <i class="fa fa-exclamation-triangle fa-3x" aria-hidden="true"/>
                    </div>
                    <h5 class="text-danger fw-bold mb-2">Error Loading Dashboard</h5>
                    <p class="text-muted mb-3" t-esc="state.error"/>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="loadData">
                        <i class="fa fa-refresh me-1" aria-hidden="true"/> Retry
                    </button>
                </div>
            </div>

            <!-- Unlinked Account State -->
            <div t-elif="!state.teacher" class="o_view_nocontent d-flex align-items-center justify-content-center py-5">
                <div class="text-center p-4 rounded-3 border bg-white shadow-sm" style="max-width: 480px;">
                    <div class="o_empty_icon text-warning mb-3">
                        <i class="fa fa-user-circle-o fa-3x" aria-hidden="true"/>
                    </div>
                    <h5 class="fw-bold mb-2">No Teacher Profile Found</h5>
                    <p class="text-muted mb-0">Your user account is not linked to an active academic staff member profile. Please contact your system administrator.</p>
                </div>
            </div>

            <!-- Main Dashboard Content -->
            <div t-else="" class="container-fluid px-4 py-4">
                <!-- Top Welcome & Actions Header -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <div>
                        <h2 class="h3 fw-bold mb-1 text-dark">Teacher &amp; Advisor Dashboard</h2>
                        <p class="text-muted mb-0 small">
                            Welcome, <strong class="text-dark" t-esc="state.teacher.name"/>
                            <t t-if="state.teacher.department_id"> · <span t-esc="state.teacher.department_id[1]"/></t>
                        </p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-primary btn-sm shadow-sm" t-on-click="openAdvisees">
                            <i class="fa fa-graduation-cap me-1" aria-hidden="true"/> My Advisees (<t t-esc="state.stats.adviseeCount"/>)
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm shadow-sm" t-on-click="openMyProfile">
                            <i class="fa fa-user me-1" aria-hidden="true"/> My Profile
                        </button>
                        <button type="button" class="btn btn-primary btn-sm shadow-sm" t-on-click="openAttendanceSheet">
                            <i class="fa fa-calendar-check-o me-1" aria-hidden="true"/> Student Attendance Management
                        </button>
                    </div>
                </div>

                <!-- 1. Responsive 4-Column KPI Section -->
                <div class="row g-3 mb-4">
                    <!-- KPI 1: Scheduled Classes -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card cursor-pointer" t-on-click="openTimetable">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary">
                                    <i class="fa fa-calendar-check-o fa-lg" aria-hidden="true"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <span class="o_kpi_label text-uppercase text-muted fw-semibold small d-block mb-1">Scheduled Classes</span>
                                    <div class="o_kpi_val h4 fw-bold mb-0 text-dark" t-esc="state.stats.totalClasses"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 2: Active Advisees -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card cursor-pointer" t-on-click="openAdvisees">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center bg-info-subtle text-info">
                                    <i class="fa fa-graduation-cap fa-lg" aria-hidden="true"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="o_kpi_label text-uppercase text-muted fw-semibold small d-block mb-1">Assigned Advisees</span>
                                        <span t-if="state.stats.highRiskAdvisees > 0" class="badge rounded-pill bg-danger text-white px-2 py-1 small"><t t-esc="state.stats.highRiskAdvisees"/> At Risk</span>
                                    </div>
                                    <div class="o_kpi_val h4 fw-bold mb-0 text-dark" t-esc="state.stats.adviseeCount"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 3: Pending Reviews -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card cursor-pointer" t-on-click="openSubmissions">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center bg-warning-subtle text-warning">
                                    <i class="fa fa-clock-o fa-lg" aria-hidden="true"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="o_kpi_label text-uppercase text-muted fw-semibold small d-block mb-1">Pending Reviews</span>
                                        <span t-if="state.stats.pendingReviews > 0" class="badge rounded-pill bg-warning text-dark px-2 py-1 small">Action</span>
                                    </div>
                                    <div class="o_kpi_val h4 fw-bold mb-0" t-att-class="state.stats.pendingReviews > 0 ? 'text-warning' : 'text-dark'" t-esc="state.stats.pendingReviews"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 4: Attendance Rate -->
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card cursor-pointer" t-on-click="openAttendanceRecords">
                            <div class="card-body p-3 d-flex align-items-center gap-3">
                                <div class="o_kpi_icon_wrapper rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success">
                                    <i class="fa fa-check-circle-o fa-lg" aria-hidden="true"/>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <span class="o_kpi_label text-uppercase text-muted fw-semibold small d-block mb-1">Attendance Rate</span>
                                    <div class="o_kpi_val h4 fw-bold mb-0 text-dark">
                                        <t t-if="state.hasAttendanceData">
                                            <span t-esc="state.attendanceRate"/>%
                                        </t>
                                        <t t-else="">
                                            <span class="text-muted fw-normal fs-6">No data</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Balanced 2-Column Layout (8:4 / 7:5 ratio) -->
                <div class="row g-4">
                    <!-- Left Column (Primary Daily Work: 8 cols) -->
                    <div class="col-12 col-lg-7 col-xl-8">
                        <div class="d-flex flex-column gap-4">
                            <!-- Widget 1: Classes & Schedule with Attendance Triggers -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-calendar text-primary" aria-hidden="true"/>
                                        <h5 class="h6 mb-0 fw-bold text-dark">Classes &amp; Schedule</h5>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold" t-on-click="openTimetable">
                                        Full Timetable <i class="fa fa-angle-right ms-1" aria-hidden="true"/>
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="state.schedule.length">
                                        <div class="list-group list-group-flush o_schedule_list">
                                            <div t-foreach="state.schedule" t-as="slot" t-key="slot.id"
                                                 class="list-group-item p-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3 o_slot_item">
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="o_time_badge px-3 py-2 rounded-3 text-center">
                                                        <div class="fw-bold text-dark small" t-esc="formatTime(slot.start_time)"/>
                                                        <div class="text-muted very-small" t-esc="formatTime(slot.end_time)"/>
                                                        <div t-if="slot.start_time" class="text-muted very-small mt-1" t-esc="formatDate(slot.start_time)"/>
                                                    </div>
                                                    <div>
                                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                            <strong class="text-dark fs-6" t-esc="slot.subject_id ? slot.subject_id[1] : 'Subject'"/>
                                                            <span t-if="slot.section_id" class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small">
                                                                <i class="fa fa-users me-1" aria-hidden="true"/>
                                                                <span t-esc="'Section ' + slot.section_id[1]"/>
                                                            </span>
                                                        </div>
                                                        <div class="text-muted small d-flex flex-wrap align-items-center gap-2">
                                                            <span t-if="slot.classroom_id" class="badge bg-light text-secondary border px-2 py-1">
                                                                <i class="fa fa-map-marker text-danger me-1" aria-hidden="true"/>
                                                                <span t-esc="'Room ' + slot.classroom_id[1]"/>
                                                            </span>
                                                            <span t-elif="slot.location" class="badge bg-light text-secondary border px-2 py-1">
                                                                <i class="fa fa-map-marker text-danger me-1" aria-hidden="true"/>
                                                                <span t-esc="slot.location"/>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div>
                                                    <button type="button" class="btn btn-sm btn-outline-primary shadow-sm o_btn_track_att"
                                                            title="Track attendance for this section today"
                                                            t-on-click="() => this.trackAttendanceForSlot(slot)">
                                                        <i class="fa fa-calendar-check-o me-1" aria-hidden="true"/> Track Attendance
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_dashboard_empty text-center py-4 px-3">
                                            <p class="text-muted small mb-0">No classes scheduled for today.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Widget 2: Assigned Advisees & Academic Risk -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-graduation-cap text-primary" aria-hidden="true"/>
                                        <h5 class="h6 mb-0 fw-bold text-dark">Assigned Advisees &amp; Academic Progress</h5>
                                        <span t-if="state.stats.highRiskAdvisees > 0" class="badge rounded-pill bg-danger text-white ms-1" t-esc="state.stats.highRiskAdvisees + ' High Risk'"/>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold" t-on-click="openAdvisees">
                                        View All Advisees <i class="fa fa-angle-right ms-1" aria-hidden="true"/>
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="state.advisees.length">
                                        <div class="table-responsive mb-0">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small text-uppercase text-muted">
                                                    <tr>
                                                        <th class="ps-4">Advisee</th>
                                                        <th>ID</th>
                                                        <th>GPA</th>
                                                        <th>Attendance</th>
                                                        <th>Standing</th>
                                                        <th class="text-end pe-4">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="small">
                                                    <tr t-foreach="state.advisees" t-as="adv" t-key="adv.id">
                                                        <td class="ps-4 fw-semibold text-dark" t-esc="adv.name"/>
                                                        <td class="text-muted" t-esc="adv.student_id || '—'"/>
                                                        <td class="fw-bold text-primary" t-esc="adv.gpa || 0.0"/>
                                                        <td class="text-muted"><t t-esc="adv.attendance_rate || 0.0"/>%</td>
                                                        <td>
                                                            <span t-if="adv.risk_level === 'low'" class="badge text-bg-success">On Track</span>
                                                            <span t-elif="adv.risk_level === 'medium'" class="badge text-bg-warning">Watch</span>
                                                            <span t-elif="adv.risk_level === 'high'" class="badge text-bg-danger">High Risk</span>
                                                            <span t-else="" class="badge text-bg-secondary">Good</span>
                                                        </td>
                                                        <td class="text-end pe-4">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2"
                                                                    t-on-click="() => this.openStudentProfile(adv.id)">
                                                                Profile <i class="fa fa-external-link ms-1" aria-hidden="true"/>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_dashboard_empty text-center py-4 px-3">
                                            <div class="o_empty_icon rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted mb-2" style="width: 48px; height: 48px;">
                                                <i class="fa fa-user-o fa-2x" aria-hidden="true"/>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">No Advisees Assigned</h6>
                                            <p class="text-muted small mb-0">You currently have no students assigned for academic advising.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Widget 3: Pending Reviews & Grading -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-check-square-o text-warning" aria-hidden="true"/>
                                        <h5 class="h6 mb-0 fw-bold text-dark">Pending Reviews &amp; Grading</h5>
                                        <span t-if="state.pendingSubmissions.length" class="badge bg-warning text-dark rounded-pill ms-1" t-esc="state.pendingSubmissions.length"/>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold" t-on-click="openSubmissions">
                                        View All <i class="fa fa-angle-right ms-1" aria-hidden="true"/>
                                    </button>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="state.pendingSubmissions.length">
                                        <div class="table-responsive mb-0">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small text-uppercase text-muted">
                                                    <tr>
                                                        <th class="ps-4">Student</th>
                                                        <th>Assignment</th>
                                                        <th>Submitted</th>
                                                        <th class="text-end pe-4">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="small">
                                                    <tr t-foreach="state.pendingSubmissions" t-as="sub" t-key="sub.id">
                                                        <td class="ps-4 fw-semibold text-dark" t-esc="sub.student_id ? sub.student_id[1] : 'Student'"/>
                                                        <td class="text-muted" t-esc="sub.assignment_id ? sub.assignment_id[1] : 'Assignment'"/>
                                                        <td class="text-muted" t-esc="formatDate(sub.create_date)"/>
                                                        <td class="text-end pe-4">
                                                            <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2"
                                                                    t-on-click="() => this.openSubmission(sub.id)">
                                                                Grade <i class="fa fa-pencil ms-1" aria-hidden="true"/>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_dashboard_empty text-center py-4 px-3">
                                            <div class="o_empty_icon rounded-circle d-inline-flex align-items-center justify-content-center bg-success-subtle text-success mb-2" style="width: 48px; height: 48px;">
                                                <i class="fa fa-check-circle-o fa-2x" aria-hidden="true"/>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">All Caught Up!</h6>
                                            <p class="text-muted small mb-0">No student submissions or tasks are currently waiting for your review.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Widget 4: Lesson Plans -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-file-text-o text-info" aria-hidden="true"/>
                                        <h5 class="h6 mb-0 fw-bold text-dark">Lesson Plans</h5>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-1" t-on-click="createLessonPlan">
                                            <i class="fa fa-plus me-1" aria-hidden="true"/> New Plan
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold" t-on-click="openLessonPlans">
                                            View All <i class="fa fa-angle-right ms-1" aria-hidden="true"/>
                                        </button>
                                    </div>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="state.lessonPlans.length">
                                        <div class="table-responsive mb-0">
                                            <table class="table table-hover align-middle mb-0">
                                                <thead class="table-light small text-uppercase text-muted">
                                                    <tr>
                                                        <th class="ps-4">Title</th>
                                                        <th>Subject</th>
                                                        <th class="text-end pe-4">Created</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="small">
                                                    <tr t-foreach="state.lessonPlans" t-as="plan" t-key="plan.id">
                                                        <td class="ps-4 fw-semibold text-dark" t-esc="plan.name"/>
                                                        <td>
                                                            <span class="badge bg-light text-secondary border px-2 py-1" t-esc="plan.subject_id ? plan.subject_id[1] : 'Subject'"/>
                                                        </td>
                                                        <td class="text-end pe-4 text-muted" t-esc="formatDate(plan.create_date)"/>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_dashboard_empty text-center py-4 px-3">
                                            <div class="o_empty_icon rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted mb-2" style="width: 48px; height: 48px;">
                                                <i class="fa fa-file-text-o fa-2x" aria-hidden="true"/>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">No Lesson Plans Yet</h6>
                                            <p class="text-muted small mb-3">Organize your course syllabus and track curriculum coverage.</p>
                                            <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="createLessonPlan">
                                                <i class="fa fa-plus me-1" aria-hidden="true"/> Create Lesson Plan
                                            </button>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column (Analytics, Announcements, Quick Actions: 4 cols) -->
                    <div class="col-12 col-lg-5 col-xl-4">
                        <div class="d-flex flex-column gap-4">
                            <!-- Widget 5: Students Attendance Analytics Card -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-pie-chart text-success" aria-hidden="true"/>
                                        <h5 class="h6 mb-0 fw-bold text-dark">Attendance Overview</h5>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 fw-semibold" t-on-click="openAttendanceRecords">
                                        Records <i class="fa fa-angle-right ms-1" aria-hidden="true"/>
                                    </button>
                                </div>
                                <div class="card-body p-3">
                                    <t t-if="state.hasAttendanceData">
                                        <div class="o_chart_wrapper position-relative" style="height: 200px;">
                                            <canvas t-ref="attendanceChart"></canvas>
                                        </div>
                                        <div class="d-flex justify-content-around text-center pt-2 border-top mt-2 small">
                                            <div>
                                                <div class="text-success fw-bold" t-esc="state.presentCount"/>
                                                <div class="text-muted very-small">Present</div>
                                            </div>
                                            <div>
                                                <div class="text-warning fw-bold" t-esc="state.lateCount"/>
                                                <div class="text-muted very-small">Late</div>
                                            </div>
                                            <div>
                                                <div class="text-danger fw-bold" t-esc="state.absentCount"/>
                                                <div class="text-muted very-small">Absent</div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_dashboard_empty text-center py-4 px-3">
                                            <div class="o_empty_icon rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted mb-2" style="width: 48px; height: 48px;">
                                                <i class="fa fa-pie-chart fa-2x" aria-hidden="true"/>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">No Attendance Logged</h6>
                                            <p class="text-muted small mb-3">No student attendance has been recorded for your sections yet.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Widget 6: Quick Shortcuts -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4">
                                    <h5 class="h6 mb-0 fw-bold text-dark">Advising &amp; Quick Actions</h5>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-grid gap-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between"
                                                t-on-click="openAdvisees">
                                            <span><i class="fa fa-graduation-cap text-primary me-2" aria-hidden="true"/> My Advisees</span>
                                            <span class="badge bg-primary-subtle text-primary" t-esc="state.stats.adviseeCount"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between"
                                                t-on-click="openAdvisingNotes">
                                            <span><i class="fa fa-comments text-info me-2" aria-hidden="true"/> Advising Notes</span>
                                            <i class="fa fa-chevron-right text-muted very-small" aria-hidden="true"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between"
                                                t-on-click="openFollowups">
                                            <span><i class="fa fa-check-square-o text-warning me-2" aria-hidden="true"/> Follow-up Actions</span>
                                            <i class="fa fa-chevron-right text-muted very-small" aria-hidden="true"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between"
                                                t-on-click="openAttendanceSheet">
                                            <span><i class="fa fa-calendar-check-o text-primary me-2" aria-hidden="true"/> Student Attendance Management</span>
                                            <i class="fa fa-chevron-right text-muted very-small" aria-hidden="true"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between"
                                                t-on-click="openAssignments">
                                            <span><i class="fa fa-tasks text-info me-2" aria-hidden="true"/> Manage Assignments</span>
                                            <i class="fa fa-chevron-right text-muted very-small" aria-hidden="true"/>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm text-start py-2 px-3 d-flex align-items-center justify-content-between"
                                                t-on-click="createLessonPlan">
                                            <span><i class="fa fa-plus-circle text-warning me-2" aria-hidden="true"/> Create New Lesson Plan</span>
                                            <i class="fa fa-chevron-right text-muted very-small" aria-hidden="true"/>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Widget 7: Notice Board & Announcements -->
                            <div class="card border-0 shadow-sm rounded-3">
                                <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-bell-o text-primary" aria-hidden="true"/>
                                        <h5 class="h6 mb-0 fw-bold text-dark">Notice Board</h5>
                                    </div>
                                    <span class="badge bg-light text-muted border small">Bulletins</span>
                                </div>
                                <div class="card-body p-0">
                                    <t t-if="state.noticeBoard.length">
                                        <div class="list-group list-group-flush">
                                            <div t-foreach="state.noticeBoard" t-as="notice" t-key="notice.id"
                                                 class="list-group-item p-3 px-4">
                                                <div class="d-flex align-items-start justify-content-between gap-2">
                                                    <span class="fw-semibold text-dark small" t-esc="notice.name"/>
                                                    <span class="badge bg-light text-muted border very-small text-nowrap" t-esc="notice.date"/>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="o_dashboard_empty text-center py-4 px-3">
                                            <div class="o_empty_icon rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted mb-2" style="width: 48px; height: 48px;">
                                                <i class="fa fa-bell-o fa-2x" aria-hidden="true"/>
                                            </div>
                                            <h6 class="fw-bold text-dark mb-1">No Notices Published</h6>
                                            <p class="text-muted small mb-0">University announcements and faculty circulars will appear here.</p>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
