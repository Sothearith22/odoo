<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="school_management.TeacherDashboardShell">
        <div class="o_action o_view_controller school_dashboard_shell">
            <div t-if="state.loading" class="o_view_nocontent">
                <div class="o_nocontent_help">
                    <p class="o_view_nocontent_empty_folder">Loading your dashboard...</p>
                </div>
            </div>
            <div t-elif="state.error" class="o_view_nocontent">
                <div class="o_nocontent_help">
                    <p class="o_view_nocontent_empty_folder text-danger">Error Loading Dashboard</p>
                    <p t-esc="state.error"/>
                </div>
            </div>
            <div t-elif="!state.teacher" class="o_view_nocontent">
                <div class="o_nocontent_help">
                    <p class="o_view_nocontent_empty_folder">No Teacher Profile Found</p>
                    <p>Your user account is not linked to an active teacher record.</p>
                </div>
            </div>
            <div t-else="" class="school_dashboard_container container-fluid py-4">
                <h2 class="mb-4">Teacher Dashboard</h2>
                
                <!-- Stat Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card h-100 cursor-pointer" t-on-click="() => this.navigate('school_management.action_university_timetable_slot')">
                            <div class="card-body">
                                <span class="o_kpi_label d-block mb-2">Scheduled Classes</span>
                                <div class="o_kpi_value" t-esc="state.stats.totalClasses"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 cursor-pointer" t-on-click="() => this.navigate('school_management.action_university_grade_assignment')">
                            <div class="card-body">
                                <span class="o_kpi_label d-block mb-2">Assigned Assignments</span>
                                <div class="o_kpi_value" t-esc="state.stats.assignedAssignments"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100 cursor-pointer" t-on-click="() => this.navigate('school_management.action_university_student_assignment')">
                            <div class="card-body">
                                <span class="o_kpi_label d-block mb-2">Student Assignments</span>
                                <div class="o_kpi_value" t-esc="state.stats.studentAssignments"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <span class="o_kpi_label d-block mb-2">Pending Service Hours</span>
                                <div class="o_kpi_value text-warning" t-esc="state.stats.pendingServiceHours"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Profile Card -->
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center bg-white">
                                <h5 class="mb-0">My Profile</h5>
                                <button class="btn btn-sm btn-link" t-on-click="openMyProfile">View Profile</button>
                            </div>
                            <div class="card-body d-flex align-items-center">
                                <div class="o_teacher_avatar me-4" t-esc="state.teacher.name[0]"/>
                                <div>
                                    <h4 t-esc="state.teacher.name" class="mb-1"/>
                                    <p class="text-muted mb-1"><i class="fa fa-envelope me-2"/> <t t-esc="state.teacher.email || 'N/A'"/></p>
                                    <p class="text-muted mb-0"><i class="fa fa-phone me-2"/> <t t-esc="state.teacher.phone || 'N/A'"/></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Attendance Chart -->
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header bg-white">
                                <h5 class="mb-0">Students Attendance</h5>
                            </div>
                            <div class="card-body">
                                <div style="height: 200px;">
                                    <canvas t-ref="attendanceChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <!-- Notice Board -->
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center bg-white">
                                <h5 class="mb-0">Notice Board</h5>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="state.noticeBoard.length">
                                    <table class="table mb-0">
                                        <thead class="bg-light">
                                            <tr>
                                                <th>Title</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.noticeBoard" t-as="notice" t-key="notice.id">
                                                <td t-esc="notice.name"/>
                                                <td t-esc="notice.date"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="o_empty_state py-4">
                                        <div class="o_empty_icon">
                                            <i class="fa fa-bell-o" aria-hidden="true"/>
                                        </div>
                                        <div class="o_empty_title">No Notices Yet</div>
                                        <div class="o_empty_desc">University notices will appear here as they are published.</div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Lesson Plans -->
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center bg-white">
                                <h5 class="mb-0">Lesson Plans</h5>
                                <button class="btn btn-sm btn-link" t-on-click="() => this.navigate('school_management.action_university_lesson_plan')">View All</button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="state.lessonPlans.length">
                                    <table class="table mb-0">
                                        <thead class="bg-light">
                                            <tr>
                                                <th>Title</th>
                                                <th>Subject</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="state.lessonPlans" t-as="plan" t-key="plan.id">
                                                <td t-esc="plan.name"/>
                                                <td t-esc="plan.subject_id[1]"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <div class="o_empty_state py-4">
                                        <div class="o_empty_icon">
                                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                                        </div>
                                        <div class="o_empty_title">No Lesson Plans Yet</div>
                                        <div class="o_empty_desc">Plan your subjects to keep every class on track.</div>
                                        <button class="btn btn-sm btn-brand-primary mt-3"
                                                t-on-click="() => this.navigate('school_management.action_university_lesson_plan')">
                                            <i class="fa fa-plus me-1" aria-hidden="true"/>Create Lesson Plan
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
