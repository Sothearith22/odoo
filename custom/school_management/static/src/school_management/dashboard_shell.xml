<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <!-- ========================================================= -->
  <!-- UNIVERSITY EXECUTIVE & LEADERSHIP DASHBOARD               -->
  <!-- Clean, Unified Full-Width Architecture (Admin/Dean/HOD/Teacher) -->
  <!-- Design System: Slate #1E293B, Light #F8FAFC, 16px Radius  -->
  <!-- ========================================================= -->
  <t t-name="school_management.DashboardShell" owl="1">
    <div class="o_exec_portal_root d-flex h-100 w-100 overflow-hidden">
      <!-- Main Dashboard Canvas Container (Full Width, No Sidebar) -->
      <div class="o_executive_dashboard_container flex-grow-1 h-100 overflow-y-auto" aria-label="University Executive Dashboard">
      <div class="o_dashboard_canvas p-3 p-md-4 d-flex flex-column gap-3 gap-md-4">

        <!-- ======================================================= -->
        <!-- 1. UNIFIED CLEAN TOP HEADER CARD                        -->
        <!-- ======================================================= -->
        <header class="o_exec_header_card p-4 shadow-sm" aria-label="Executive Dashboard Header">
          <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            
            <!-- Left: Greeting, Live Status & Real-Time Subtitle -->
            <div class="o_exec_header_left min-w-0">
              <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <span class="badge o_badge_live">
                  <span class="o_pulse_dot me-1"></span> Live System
                </span>
                <span class="text-muted small fw-semibold" t-esc="state.academicPeriod.label"></span>
              </div>
              <h1 class="o_exec_title text-truncate mb-1" t-esc="this.userGreeting">Good morning, Sothearith Kim</h1>
              <p class="o_exec_subtitle text-secondary mb-0" t-esc="this.subtitle">University Executive Dashboard • Real-time Academic &amp; Administrative Analytics</p>
            </div>

            <!-- Right: Global Academic Filters (Year & Semester) + Refresh -->
            <div class="o_exec_filters d-flex align-items-center gap-2 flex-shrink-0 flex-wrap">
              <!-- Academic Year Selector -->
              <div class="o_filter_group">
                <label class="o_filter_label small text-muted fw-bold mb-1 d-block">Academic Year</label>
                <select class="form-select form-select-sm o_filter_select"
                        t-att-value="state.filters.yearId || ''"
                        t-on-change="(ev) => this.changeFilter('yearId', ev.target.value)">
                  <t t-foreach="state.filterOptions.academicYears" t-as="year" t-key="year.id">
                    <option t-att-value="year.id" t-esc="year.name"/>
                  </t>
                </select>
              </div>

              <!-- Semester Switcher -->
              <div class="o_filter_group">
                <label class="o_filter_label small text-muted fw-bold mb-1 d-block">Semester</label>
                <select class="form-select form-select-sm o_filter_select"
                        t-att-value="state.filters.semesterId || ''"
                        t-on-change="(ev) => this.changeFilter('semesterId', ev.target.value)">
                  <t t-foreach="state.filterOptions.semesters" t-as="sem" t-key="sem.id">
                    <option t-att-value="sem.id" t-esc="sem.name"/>
                  </t>
                </select>
              </div>

              <!-- Refresh Button -->
              <div class="o_filter_group align-self-end">
                <button class="btn btn-sm o_btn_refresh d-flex align-items-center gap-1"
                        type="button"
                        t-att-class="{ 'is-refreshing': state.isRefreshing }"
                        t-on-click="() => this.reload()"
                        title="Refresh Live Metrics">
                  <i class="fa fa-refresh" aria-hidden="true"></i>
                  <span class="d-none d-sm-inline">Refresh</span>
                </button>
              </div>
            </div>

          </div>
        </header>

        <!-- ======================================================= -->
        <!-- 2. EXECUTIVE "ACTION CENTER" BANNER                     -->
        <!-- Surfaces urgent bottlenecks immediately                 -->
        <!-- ======================================================= -->
        <section t-if="state.dashboard and state.dashboard.urgent_actions" class="o_action_center_banner p-3 shadow-sm" aria-label="Executive Action Center">
          <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            
            <div class="d-flex align-items-center gap-3 flex-wrap flex-grow-1">
              <div class="o_action_center_tag d-flex align-items-center gap-2">
                <i class="fa fa-bolt text-warning" aria-hidden="true"></i>
                <span class="fw-bold text-dark small text-uppercase tracking-wider">Action Center</span>
              </div>

              <!-- Dynamic Role-Based Alerts -->
              <t t-if="state.dashboard.urgent_actions.alerts and state.dashboard.urgent_actions.alerts.length">
                <t t-foreach="state.dashboard.urgent_actions.alerts" t-as="alert" t-key="alert.id">
                  <div class="o_alert_pill d-flex align-items-center gap-2 p-2 rounded-2">
                    <i t-attf-class="fa #{alert.icon} #{alert.iconColor}" aria-hidden="true"></i>
                    <span class="small fw-semibold text-dark" t-esc="alert.text"/>
                    <button type="button" t-attf-class="btn btn-sm o_alert_btn #{alert.btnClass} ms-1" t-on-click="() => this.handleActionClick(alert.action)">
                      <t t-esc="alert.btnLabel"/>
                    </button>
                  </div>
                </t>
              </t>
              <t t-else="">
                <!-- Fallback to default two alerts -->
                <div t-if="state.dashboard.urgent_actions.pending_admissions_count" class="o_alert_pill d-flex align-items-center gap-2 p-2 rounded-2">
                  <i class="fa fa-exclamation-triangle text-warning" aria-hidden="true"></i>
                  <span class="small fw-semibold text-dark" t-esc="state.dashboard.urgent_actions.pending_admissions_text">4 Pending Student Admissions need review</span>
                  <button type="button" class="btn btn-sm o_alert_btn o_alert_btn_amber ms-1" t-on-click="() => this.openAdmissions()">
                    Review Admissions
                  </button>
                </div>

                <div t-if="state.dashboard.urgent_actions.schedule_conflicts_count" class="o_alert_pill d-flex align-items-center gap-2 p-2 rounded-2">
                  <i class="fa fa-exclamation-circle text-danger" aria-hidden="true"></i>
                  <span class="small fw-semibold text-dark" t-esc="state.dashboard.urgent_actions.schedule_conflicts_text">1 Room Schedule Conflict needs resolution</span>
                  <button type="button" class="btn btn-sm o_alert_btn o_alert_btn_danger ms-1" t-on-click="() => this.openConflicts()">
                    Resolve Conflicts
                  </button>
                </div>
              </t>
            </div>

            <!-- Current Time Badge -->
            <div class="text-muted small text-nowrap flex-shrink-0 d-none d-lg-block">
              <i class="fa fa-clock-o me-1"></i> Updated at <t t-esc="state.lastUpdated"/>
            </div>

          </div>
        </section>

        <!-- ======================================================= -->
        <!-- LOADING SKELETON STATE                                  -->
        <!-- ======================================================= -->
        <div t-if="state.isLoading or !state.dashboard" class="d-flex flex-column gap-3" aria-busy="true">
          <div class="row g-3">
            <t t-foreach="[1,2,3,4]" t-as="i" t-key="i">
              <div class="col-12 col-md-6 col-xl-3"><div class="o_skeleton_box" style="height: 140px; border-radius: 16px;"></div></div>
            </t>
          </div>
          <div class="row g-3">
            <div class="col-12 col-lg-8"><div class="o_skeleton_box" style="height: 360px; border-radius: 16px;"></div></div>
            <div class="col-12 col-lg-4"><div class="o_skeleton_box" style="height: 360px; border-radius: 16px;"></div></div>
          </div>
        </div>

        <!-- ======================================================= -->
        <!-- MAIN DASHBOARD CONTENT                                  -->
        <!-- ======================================================= -->
        <div t-else="" class="d-flex flex-column gap-3 gap-md-4">
          
          <!-- ===================================================== -->
          <!-- 3. STREAMLINED KPI SUMMARY BLOCK                      -->
          <!-- 4 Categorized Blocks Matching Admin/Dean/HOD/Teacher -->
          <!-- ===================================================== -->
          <section class="o_kpi_summary_section" aria-label="Key Performance Metrics">
            <div class="row g-3">
              <t t-foreach="this.kpiCards" t-as="card" t-key="card.key">
                <div class="col-12 col-md-6 col-xl-3">
                  <div class="o_kpi_block_card h-100 p-3 p-xl-4 shadow-sm" t-on-click="() => this.handleActionClick(card.action)" role="button" tabindex="0">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span t-attf-class="o_kpi_category_tag text-#{card.color}" t-esc="card.category"/>
                      <div t-attf-class="o_kpi_icon_bubble bg-#{card.color}-subtle text-#{card.color}">
                        <i t-attf-class="fa #{card.icon}" aria-hidden="true"></i>
                      </div>
                    </div>
                    
                    <!-- Metric 1 -->
                    <div class="mb-3">
                      <div class="d-flex align-items-baseline justify-content-between">
                        <span class="small text-muted fw-semibold" t-esc="card.metric1.label"/>
                        <span t-if="card.metric1.growthText" t-attf-class="badge #{card.metric1.growthClass || 'bg-success-subtle text-success'} small fw-bold" t-esc="card.metric1.growthText"/>
                      </div>
                      <div class="d-flex align-items-baseline gap-2">
                        <span t-attf-class="o_kpi_value_large text-#{card.color == 'indigo' ? 'indigo' : (card.color == 'success' ? 'success' : (card.color == 'danger' ? 'danger' : 'dark'))}" t-esc="card.metric1.value"/>
                        <span t-if="card.metric1.targetText" class="small text-muted" t-esc="card.metric1.targetText"/>
                      </div>
                      <div class="o_mini_track mt-1">
                        <div t-attf-class="o_mini_fill bg-#{card.color}" t-attf-style="width: #{card.metric1.progress}%;"></div>
                      </div>
                    </div>

                    <!-- Metric 2 -->
                    <div class="pt-2 border-top">
                      <div class="d-flex align-items-baseline justify-content-between">
                        <span class="small text-muted fw-semibold" t-esc="card.metric2.label"/>
                        <span t-if="card.metric2.statusText" t-attf-class="badge #{card.metric2.statusClass || 'bg-light text-secondary border'} small fw-bold" t-esc="card.metric2.statusText"/>
                      </div>
                      <div class="d-flex align-items-baseline gap-2">
                        <span class="fs-5 fw-bold text-dark" t-esc="card.metric2.value"/>
                        <span t-if="card.metric2.targetText" class="small text-muted" t-esc="card.metric2.targetText"/>
                      </div>
                    </div>

                  </div>
                </div>
              </t>
            </div>
          </section>

          <!-- ===================================================== -->
          <!-- 4. MODERN ANALYTICS & DISTRIBUTION GRID (8 + 4 COLS)  -->
          <!-- ===================================================== -->
          <section class="o_analytics_grid_section" aria-label="Visual Analytics">
            <div class="row g-3 g-md-4">
              
              <!-- LEFT COLUMN (8 COLS): ENROLLMENT OVERVIEW TREND CHART -->
              <div class="col-12 col-lg-8">
                <div class="o_chart_card h-100 p-4 shadow-sm d-flex flex-column">
                  <div class="d-flex flex-column flex-sm-row align-items-sm-start justify-content-between mb-3 gap-2">
                    <div>
                      <h3 class="o_card_title mb-1" t-esc="this.trendTitle">Enrollment Overview</h3>
                      <p class="o_card_subtitle text-muted mb-0" t-esc="this.trendSubtitle">Historical term comparisons with calibrated vertical scaling</p>
                    </div>
                    <div class="o_legend_pill d-flex align-items-center gap-2 flex-shrink-0">
                      <span class="o_legend_box bg-indigo"></span>
                      <span class="small fw-semibold text-secondary" t-esc="this.trendLegend">Enrolled Students</span>
                    </div>
                  </div>
                  
                  <!-- Chart Canvas -->
                  <div class="o_chart_canvas_wrap flex-grow-1" style="height: 280px;">
                    <canvas t-ref="chart_enrollment"></canvas>
                  </div>
                </div>
              </div>

              <!-- RIGHT COLUMN (4 COLS): STUDENT DISTRIBUTION DOUGHNUT CHART -->
              <div class="col-12 col-lg-4">
                <div class="o_chart_card h-100 p-4 shadow-sm d-flex flex-column">
                  <div class="d-flex align-items-start justify-content-between mb-2">
                    <div>
                      <h3 class="o_card_title mb-1" t-esc="this.distributionTitle">Student Distribution</h3>
                      <p class="o_card_subtitle text-muted mb-0" t-esc="this.distributionSubtitle">By academic faculty &amp; program</p>
                    </div>
                  </div>
                  
                  <!-- Doughnut Chart Canvas -->
                  <div class="o_chart_canvas_wrap my-2" style="height: 180px;">
                    <canvas t-ref="chart_program"></canvas>
                  </div>

                  <!-- Program Breakdown Legend List -->
                  <div class="o_program_breakdown_list mt-auto pt-2 border-top">
                    <t t-if="state.chartData and state.chartData.program_distribution and state.chartData.program_distribution.breakdown">
                      <div class="d-flex flex-column gap-2">
                        <t t-foreach="state.chartData.program_distribution.breakdown" t-as="prog" t-key="prog.name">
                          <div class="d-flex align-items-center justify-content-between small">
                            <div class="d-flex align-items-center gap-2 text-truncate">
                              <span class="o_prog_dot flex-shrink-0" t-attf-style="background-color: #{prog.color};"></span>
                              <span class="o_prog_name text-truncate text-secondary fw-semibold" t-esc="prog.name"></span>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                              <span class="text-muted fw-bold"><t t-esc="prog.count"/></span>
                              <span class="o_prog_badge fw-bold" t-attf-style="color: #{prog.color}; background-color: #{prog.color}15;">
                                <t t-esc="prog.percentage"/>%
                              </span>
                            </div>
                          </div>
                        </t>
                      </div>
                    </t>
                  </div>
                </div>
              </div>

            </div>
          </section>

          <!-- ===================================================== -->
          <!-- 5. BOTTOM ROW: QUICK OPERATIONS SHORTCUTS              -->
          <!-- Role-Tailored Administrative & Academic Actions       -->
          <!-- ===================================================== -->
          <section class="o_quick_ops_section" aria-label="Quick Operations">
            <div class="o_quick_ops_container p-4 shadow-sm rounded-4 bg-white border">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div>
                  <h3 class="o_card_title mb-0">Quick Operations</h3>
                  <p class="small text-muted mb-0">Frequently used administrative actions and entry points</p>
                </div>
                <span class="badge bg-light text-secondary border small px-2 py-1" t-esc="this.quickOpsBadge">Executive Shortcuts</span>
              </div>
              
              <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-6">
                <t t-foreach="this.quickOps" t-as="op" t-key="op.id">
                  <div class="col">
                    <button type="button" class="btn o_quick_op_tile w-100 p-3 text-start d-flex flex-column gap-2" t-on-click="() => this.handleActionClick(op.action)">
                      <div t-attf-class="o_op_icon_wrap bg-#{op.color}-subtle text-#{op.color}">
                        <i t-attf-class="fa #{op.icon}" aria-hidden="true"></i>
                      </div>
                      <div>
                        <div class="o_op_title fw-bold text-dark text-truncate" t-esc="op.title"/>
                        <div class="o_op_desc small text-muted text-truncate" t-esc="op.desc"/>
                      </div>
                    </button>
                  </div>
                </t>
              </div>
            </div>
          </section>

        </div>

      </div>
    </div>
    </div>
  </t>

</templates>
