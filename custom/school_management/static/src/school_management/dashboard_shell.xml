<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="school_management.DashboardShell" owl="1">
      <div class="flex-grow-1 d-flex flex-column h-100 o_school_dashboard_layout bg-view" t-if="state.dashboard">
        
        <!-- Top Header -->
        <div class="px-4 py-3 d-flex justify-content-between align-items-center sticky-top z-1 dashboard-header bg-view border-bottom">
            <div class="d-flex align-items-center">
                <div>
                    <h3 class="fw-bold mb-0 dashboard-title">University Management</h3>
                    <div class="text-muted small d-none d-md-block">Overview of academic structure, people, courses, and operations</div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button t-on-click="() => this.navigate('school_management.action_university_student')" class="btn btn-sm px-3 btn-brand-primary text-white" style="background-color: var(--brand-900, #1b2a4a);">
                    <i class="fa fa-user-plus me-1" aria-hidden="true"></i><span class="d-none d-md-inline">New Student</span>
                </button>
                <button t-on-click="() => this.navigate('school_management.action_university_enrollment')" class="btn btn-sm px-3 btn-outline-secondary d-none d-md-inline-block">
                    <i class="fa fa-check-square-o me-1" aria-hidden="true"></i>Enroll Student
                </button>
                <button t-on-click="() => this.navigate('school_management.action_university_fee')" class="btn btn-sm px-3 btn-outline-secondary d-none d-md-inline-block">
                    <i class="fa fa-money me-1" aria-hidden="true"></i>New Fee Invoice
                </button>
            </div>
        </div>

        <div class="p-4 pt-4 flex-grow-1 overflow-auto dashboard-canvas">
            <!-- 1. PRIMARY METRICS (CLICKABLE KPI CARDS) -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.navigate('school_management.action_university_student')" role="button">
                    <div class="card shadow-sm h-100 o_school_kpi_card border-0" style="--kpi-accent:#1b2a4a; --kpi-accent-soft:#e8eaf0; border-top: 3px solid #1b2a4a !important;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold small d-block mb-1">Students</span>
                                <div class="fs-2 fw-bold section-title" t-esc="state.dashboard.student_count"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 44px; height: 44px; background-color: #e8eaf0; color: #1b2a4a;">
                                <i class="fa fa-graduation-cap fa-lg" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.navigate('school_management.action_university_teacher')" role="button">
                    <div class="card shadow-sm h-100 o_school_kpi_card border-0" style="--kpi-accent:#1f7a5c; --kpi-accent-soft:#e3f2ec; border-top: 3px solid #1f7a5c !important;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold small d-block mb-1">Teachers</span>
                                <div class="fs-2 fw-bold section-title" t-esc="state.dashboard.teacher_count"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 44px; height: 44px; background-color: #e3f2ec; color: #1f7a5c;">
                                <i class="fa fa-user fa-lg" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.navigate('school_management.action_university_program')" role="button">
                    <div class="card shadow-sm h-100 o_school_kpi_card border-0" style="--kpi-accent:#b8863f; --kpi-accent-soft:#f6ead4; border-top: 3px solid #b8863f !important;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold small d-block mb-1">Programs</span>
                                <div class="fs-2 fw-bold section-title" t-esc="state.dashboard.program_count"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 44px; height: 44px; background-color: #f6ead4; color: #b8863f;">
                                <i class="fa fa-certificate fa-lg" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3" t-on-click="() => this.navigate('school_management.action_university_department')" role="button">
                    <div class="card shadow-sm h-100 o_school_kpi_card border-0" style="--kpi-accent:#3a6ea5; --kpi-accent-soft:#e6eef7; border-top: 3px solid #3a6ea5 !important;">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fw-semibold small d-block mb-1">Departments</span>
                                <div class="fs-2 fw-bold section-title" t-esc="state.dashboard.department_count"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 44px; height: 44px; background-color: #e6eef7; color: #3a6ea5;">
                                <i class="fa fa-building fa-lg" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHARTS ROW -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-4">
                    <div class="card o_school_panel h-100 border-0 shadow-sm">
                        <div class="card-header o_school_panel_header px-3 py-3 bg-white border-bottom">
                            <span class="fw-bold"><i class="fa fa-pie-chart me-2" style="color: #1b2a4a;"></i>Student Demographics</span>
                        </div>
                        <div class="card-body p-3 d-flex justify-content-center align-items-center" style="position: relative; height: 280px;">
                            <canvas t-ref="chart_status"></canvas>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-lg-8">
                    <div class="card o_school_panel h-100 border-0 shadow-sm">
                        <div class="card-header o_school_panel_header px-3 py-3 bg-white border-bottom">
                            <span class="fw-bold"><i class="fa fa-bar-chart me-2" style="color: #1b2a4a;"></i>Program Enrollments</span>
                        </div>
                        <div class="card-body p-3" style="position: relative; height: 280px;">
                            <canvas t-ref="chart_program"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FEE STATUS & RECENT ACTIVITY -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-6">
                    <div class="card o_school_panel h-100 border-0 shadow-sm">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold fs-6">
                                <i class="fa fa-money me-2" style="color: #b8863f;" aria-hidden="true"></i>Fee Status
                            </h5>
                            <button t-on-click="() => this.navigate('school_management.action_university_fee')" class="btn btn-sm btn-link text-decoration-none p-0 text-muted">
                                View Invoices <i class="fa fa-arrow-right ms-1"></i>
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4 text-center">
                                <div class="col-4 border-end">
                                    <div class="text-muted small fw-semibold mb-2">Invoices</div>
                                    <div class="fs-3 fw-bold" t-esc="state.dashboard.fee_count"/>
                                </div>
                                <div class="col-4 border-end">
                                    <div class="text-muted small fw-semibold mb-2">Paid</div>
                                    <div class="fs-4 fw-bold text-success" t-esc="state.dashboard.total_paid_fees"/>
                                </div>
                                <div class="col-4">
                                    <div class="text-muted small fw-semibold mb-2">Unpaid</div>
                                    <div class="fs-4 fw-bold text-danger" t-esc="state.dashboard.total_unpaid_fees"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-12 col-lg-6">
                    <div class="card o_school_panel h-100 border-0 shadow-sm">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold fs-6">
                                <i class="fa fa-history me-2" style="color: #1f7a5c;" aria-hidden="true"></i>Recent Payments
                            </h5>
                            <button t-on-click="() => this.navigate('school_management.action_university_payment')" class="btn btn-sm btn-link text-decoration-none p-0 text-muted">
                                View All <i class="fa fa-arrow-right ms-1"></i>
                            </button>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <t t-if="state.chartData and state.chartData.recent_payments.length > 0">
                                    <t t-foreach="state.chartData.recent_payments" t-as="payment" t-key="payment.id">
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                            <div class="d-flex flex-column">
                                                <span class="fw-semibold text-dark" t-esc="payment.student_name"/>
                                                <span class="small text-muted" t-esc="payment.date"/>
                                            </div>
                                            <span class="badge bg-success rounded-pill px-3 py-2 fs-6" t-esc="payment.amount"/>
                                        </li>
                                    </t>
                                </t>
                                <t t-else="">
                                    <li class="list-group-item text-center py-4 text-muted">No recent payments</li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BOTTOM ROW: OPERATIONS -->
            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="card o_school_panel h-100 border-0 shadow-sm">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="mb-0 fw-bold fs-6">
                                <i class="fa fa-bolt me-2" style="color: #b8863f;" aria-hidden="true"></i>Quick Operations
                            </h5>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-grid gap-2">
                                <button t-on-click="() => this.navigate('school_management.action_university_academic_year')" class="btn text-start d-flex justify-content-between align-items-center py-2 px-3 border rounded shadow-sm bg-light">
                                    <span><i class="fa fa-calendar-check-o me-2" style="color: #1b2a4a;" aria-hidden="true"></i>Academic Years &amp; Semesters</span>
                                    <i class="fa fa-chevron-right text-muted small" aria-hidden="true"></i>
                                </button>
                                <button t-on-click="() => this.navigate('school_management.action_university_class_section')" class="btn text-start d-flex justify-content-between align-items-center py-2 px-3 border rounded shadow-sm bg-light">
                                    <span><i class="fa fa-users me-2" style="color: #1b2a4a;" aria-hidden="true"></i>Class Sections &amp; Schedules</span>
                                    <i class="fa fa-chevron-right text-muted small" aria-hidden="true"></i>
                                </button>
                                <button t-on-click="() => this.navigate('school_management.action_university_enrollment')" class="btn text-start d-flex justify-content-between align-items-center py-2 px-3 border rounded shadow-sm bg-light">
                                    <span><i class="fa fa-list-alt me-2" style="color: #1b2a4a;" aria-hidden="true"></i>Student Course Enrollments</span>
                                    <i class="fa fa-chevron-right text-muted small" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="card o_school_panel h-100 border-0 shadow-sm">
                        <div class="card-header bg-white py-3 border-bottom">
                            <h5 class="mb-0 fw-bold fs-6">
                                <i class="fa fa-cubes me-2" style="color: #b8863f;" aria-hidden="true"></i>System Capabilities
                            </h5>
                        </div>
                        <div class="card-body p-3">
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                    <span><i class="fa fa-check-circle text-success me-2" aria-hidden="true"></i>Structure (Faculties, Depts, Programs)</span>
                                    <span class="badge bg-success">Active</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                    <span><i class="fa fa-check-circle text-success me-2" aria-hidden="true"></i>Academic Calendar &amp; Sections</span>
                                    <span class="badge bg-success">Active</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                    <span><i class="fa fa-clock-o text-muted me-2" aria-hidden="true"></i>Attendance &amp; Exams</span>
                                    <span class="badge bg-secondary">Next Phase</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                    <span><i class="fa fa-check-circle text-success me-2" aria-hidden="true"></i>Fees, Invoicing &amp; Payments</span>
                                    <span class="badge bg-success">Active</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
      </div>
  </t>

</templates>