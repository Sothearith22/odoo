<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.CalendarCommonPopover.footer" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='isEventEditable or isEventViewable']" position="before">
            <button t-if="isTimetableSlot"
                    type="button"
                    class="btn btn-outline-primary btn-sm me-1 o_timetable_lesson_plans"
                    t-on-click="onViewLessonPlans">
                <i class="fa fa-book me-1" title="Lesson Plans"/> Lesson Plans
            </button>
            <button t-if="canTrackAttendance"
                    type="button"
                    class="btn btn-primary btn-sm me-1 o_timetable_track_attendance"
                    t-on-click="onTrackAttendance">
                <i class="fa fa-calendar-check-o me-1" title="Track Attendance"/> Track Attendance
            </button>
        </xpath>
    </t>

</templates>
