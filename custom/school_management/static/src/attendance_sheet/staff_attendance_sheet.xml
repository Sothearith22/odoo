<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="school_management.StaffAttendanceSheet">
    <t t-set="visibleRows" t-value="visibleLines"/>
    <t t-set="tally"       t-value="counts"/>

    <div class="o_att_sheet" t-ref="root">
        <!-- 1. Breadcrumb Matching Student Attendance -->
        <nav class="o_att_breadcrumb" aria-label="Breadcrumb">
            <button type="button" class="o_att_breadcrumb_link" t-on-click="onBack" title="Back to Attendance List">
                <i class="fa fa-arrow-left" aria-hidden="true"/> Staff Attendance
            </button>
            <span aria-hidden="true">/</span>
            <span class="o_att_breadcrumb_record" aria-current="page" t-esc="recordLabel"/>
        </nav>

        <div class="o_att_layout">
            <div class="o_att_shell">
                <!-- 2. Header Matching Student Attendance -->
                <header class="o_att_hdr">
                    <div class="o_att_hdr_main">
                        <div class="o_att_title_row">
                            <h1 class="o_att_h1">Staff Attendance</h1>
                            <span t-att-class="'o_att_badge ' + (state.taken ? 'o_att_badge--recorded' : 'o_att_badge--pending')">
                                <span class="o_att_badge_dot" aria-hidden="true"/>
                                <span t-esc="state.taken ? 'Recorded' : 'Not recorded'"/>
                            </span>
                        </div>
                        <p class="o_att_meta">
                            <t t-if="state.lastSaved">
                                <i class="fa fa-check-circle text-success me-1"/> Last saved at <strong t-esc="state.lastSaved"/>
                            </t>
                            <t t-else="">
                                <i class="fa fa-clock-o text-muted me-1"/> Not saved yet
                            </t>
                        </p>
                    </div>
                </header>

                <!-- 3. Department & Schedule Info Section -->
                <section class="o_att_info" aria-label="Department information">
                    <div class="o_att_info_group">
                        <h2 class="o_att_section_heading">Department Information</h2>
                        <div class="o_att_info_row">
                            <label for="satt_dept">Department</label>
                            <select id="satt_dept" class="o_att_select_clean" t-on-change="onDepartmentChange"
                                    t-att-disabled="state.loading || state.saving">
                                <option value="" t-att-selected="!state.departmentId">Select department...</option>
                                <option value="all" t-att-selected="state.departmentId === 'all'">All Departments</option>
                                <option t-foreach="state.departments" t-as="dept" t-key="dept.id"
                                        t-att-value="dept.id"
                                        t-att-selected="dept.id === state.departmentId"
                                        t-esc="dept.display_name"/>
                            </select>
                        </div>
                        <div class="o_att_info_row" t-if="currentFacultyName">
                            <span class="o_att_info_label">Faculty</span>
                            <span t-esc="currentFacultyName"/>
                        </div>
                        <div class="o_att_info_row" t-if="currentHeadName">
                            <span class="o_att_info_label">Head of Dept</span>
                            <span t-esc="currentHeadName"/>
                        </div>
                    </div>
                    <div class="o_att_info_group">
                        <h2 class="o_att_section_heading">Schedule &amp; Working Hours</h2>
                        <div class="o_att_info_row">
                            <label for="satt_date">Date</label>
                            <input id="satt_date" type="date" class="o_att_input_clean"
                                   t-att-value="state.date"
                                   t-att-disabled="state.loading || state.saving"
                                   t-on-change="onDateChange"/>
                        </div>
                        <div class="o_att_info_row">
                            <span class="o_att_info_label">Working Hours</span>
                            <span><t t-esc="expectedHoursLabel"/></span>
                        </div>
                        <div class="o_att_info_row">
                            <span class="o_att_info_label">Late Grace Period</span>
                            <span><t t-esc="state.graceMinutes"/> minutes</span>
                        </div>
                    </div>
                </section>

                <!-- Holiday Banner -->
                <div t-if="state.holidayName" class="alert alert-warning d-flex align-items-center gap-2 shadow-sm mb-4" role="status">
                    <i class="fa fa-calendar-check-o fa-lg text-warning" aria-hidden="true"/>
                    <span><strong>University Holiday:</strong> This date is marked as <strong t-esc="state.holidayName"/>.</span>
                </div>

                <!-- Read-Only Notice for non-admin -->
                <div t-if="!state.isAdmin" class="alert alert-info d-flex align-items-center gap-2 shadow-sm mb-4" role="status">
                    <i class="fa fa-info-circle fa-lg text-info" aria-hidden="true"/>
                    <span><strong>View-only mode:</strong> Only School Administrators have permission to record or modify staff attendance.</span>
                </div>

                <!-- Error Banner -->
                <div t-if="state.error" class="o_att_error shadow-sm mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-exclamation-triangle fa-lg text-danger" aria-hidden="true"/>
                        <span class="fw-medium text-danger" t-esc="state.error"/>
                    </div>
                </div>

                <!-- 4. 4 KPI Stat Cards Matching Student Attendance -->
                <section class="o_att_stats" aria-label="Attendance summary">
                    <div class="o_att_stat o_att_stat--present">
                        <div class="o_att_stat_icon_wrap">
                            <i class="fa fa-check fa-lg" aria-hidden="true"/>
                        </div>
                        <div class="o_att_stat_body">
                            <span class="o_att_stat_value text-dark" t-esc="tally.present"/>
                            <span class="o_att_stat_label text-muted">Present</span>
                        </div>
                    </div>
                    <div class="o_att_stat o_att_stat--absent">
                        <div class="o_att_stat_icon_wrap">
                            <i class="fa fa-times fa-lg" aria-hidden="true"/>
                        </div>
                        <div class="o_att_stat_body">
                            <span class="o_att_stat_value text-dark" t-esc="tally.absent"/>
                            <span class="o_att_stat_label text-muted">Absent</span>
                        </div>
                    </div>
                    <div class="o_att_stat o_att_stat--late">
                        <div class="o_att_stat_icon_wrap">
                            <i class="fa fa-clock-o fa-lg" aria-hidden="true"/>
                        </div>
                        <div class="o_att_stat_body">
                            <span class="o_att_stat_value text-dark" t-esc="tally.late"/>
                            <span class="o_att_stat_label text-muted">Late</span>
                        </div>
                    </div>
                    <div class="o_att_stat o_att_stat--total">
                        <div class="o_att_stat_icon_wrap">
                            <i class="fa fa-users fa-lg" aria-hidden="true"/>
                        </div>
                        <div class="o_att_stat_body">
                            <span class="o_att_stat_value text-dark" t-esc="tally.total"/>
                            <span class="o_att_stat_label text-muted">Total staff</span>
                        </div>
                    </div>
                </section>

                <!-- 5. Two Tabs Matching Student Attendance -->
                <div class="o_att_tabs" role="tablist" aria-label="Attendance session" t-on-keydown="onTabKeydown">
                    <button id="satt_staff_tab" type="button" role="tab" class="o_att_tab" data-tab="attendance"
                            t-att-aria-selected="state.tab === 'attendance' ? 'true' : 'false'"
                            t-att-tabindex="state.tab === 'attendance' ? 0 : -1" aria-controls="satt_staff_panel"
                            t-on-click="() => this.setTab('attendance')">Staff Attendance</button>
                    <button id="satt_details_tab" type="button" role="tab" class="o_att_tab" data-tab="details"
                            t-att-aria-selected="state.tab === 'details' ? 'true' : 'false'"
                            t-att-tabindex="state.tab === 'details' ? 0 : -1" aria-controls="satt_details_panel"
                            t-on-click="() => this.setTab('details')">Department &amp; Policy Details</button>
                </div>

                <!-- 6. Tab 1: Staff Attendance Grid -->
                <section t-if="state.tab === 'attendance'" id="satt_staff_panel" class="o_att_card"
                         role="tabpanel" aria-labelledby="satt_staff_tab">
                    <!-- Toolbar: Search + Filter Tabs + View Mode Toggle + Report Link -->
                    <div class="o_att_toolbar">
                        <div class="o_att_toolbar_left">
                            <div class="o_att_search">
                                <i class="fa fa-search o_att_search_icon" aria-hidden="true"/>
                                <input type="search"
                                       t-att-value="state.query"
                                       class="o_att_search_input"
                                       placeholder="Search staff by name or ID..."
                                       aria-label="Search staff by name or ID"
                                       t-on-input="onSearchInput"/>
                            </div>
                            <div class="o_att_filter" role="group" aria-label="Filter staff">
                                <button t-foreach="filters" t-as="opt" t-key="opt.value"
                                        type="button"
                                        t-att-class="'o_att_filter_btn' + (state.filter === opt.value ? ' o_att_filter_btn--active' : '')"
                                        t-att-data-filter="opt.value"
                                        t-att-aria-pressed="state.filter === opt.value ? 'true' : 'false'"
                                        t-on-click="() => this.setFilter(opt.value)">
                                    <span t-esc="opt.label"/>
                                    <span class="o_att_filter_count" t-esc="filterCount(opt.value)"/>
                                </button>
                            </div>
                        </div>
                        <div class="o_att_toolbar_right d-flex align-items-center gap-2">
                            <!-- View Mode Switcher -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="View Mode">
                                <button type="button"
                                        t-att-class="'btn ' + (state.viewMode === 'timeline' ? 'btn-primary' : 'btn-outline-secondary')"
                                        t-on-click="() => this.setViewMode('timeline')"
                                        title="Day Schedule Timeline View">
                                    <i class="fa fa-calendar-check-o me-1" aria-hidden="true"/> Timeline
                                </button>
                                <button type="button"
                                        t-att-class="'btn ' + (state.viewMode === 'table' ? 'btn-primary' : 'btn-outline-secondary')"
                                        t-on-click="() => this.setViewMode('table')"
                                        title="Table / Grid View">
                                    <i class="fa fa-th-list me-1" aria-hidden="true"/> Table
                                </button>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary"
                                    t-on-click="openAttendanceReport"
                                    title="Open Attendance Report (Calendar, List, Pivot, Graph)">
                                <i class="fa fa-line-chart me-1" aria-hidden="true"/> Attendance Report
                            </button>
                        </div>
                    </div>

                    <!-- ==================== TIMELINE VIEW (Image 1) ==================== -->
                    <div t-if="state.viewMode === 'timeline' and visibleRows.length" class="o_att_tl_wrapper mb-4">
                        <!-- Top Bar matching Image 1: Navigation + Day view dropdown + Today + Fullscreen -->
                        <div class="o_att_tl_topbar d-flex align-items-center justify-content-between p-2 bg-light border rounded-top">
                            <div class="d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light border" t-on-click="onPrevDay" title="Previous Day">
                                        <i class="fa fa-arrow-left" aria-hidden="true"/>
                                    </button>
                                    <button type="button" class="btn btn-light border" t-on-click="onNextDay" title="Next Day">
                                        <i class="fa fa-arrow-right" aria-hidden="true"/>
                                    </button>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-light border dropdown-toggle" data-bs-toggle="dropdown">
                                        Day
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item active" href="#">Day</a></li>
                                    </ul>
                                </div>
                                <button type="button" class="btn btn-sm btn-light border fw-semibold px-3" t-on-click="onToday">
                                    Today
                                </button>
                                <button type="button" class="btn btn-sm btn-light border" t-on-click="toggleFullscreen" title="Fullscreen">
                                    <i t-att-class="'fa ' + (state.isFullscreen ? 'fa-compress' : 'fa-arrows-alt')" aria-hidden="true"/>
                                </button>
                            </div>
                            <div class="text-muted small">
                                <span class="badge bg-success-subtle text-success border border-success-subtle me-2">
                                    <i class="fa fa-circle me-1" style="font-size: 7px;"/> Live Presence Highlight
                                </span>
                            </div>
                        </div>

                        <!-- Timeline Grid Container -->
                        <div class="o_att_tl_container border border-top-0 rounded-bottom overflow-auto">
                            <table class="o_att_tl_table w-100">
                                <thead>
                                    <!-- Row 1: "Days" + Date -->
                                    <tr class="o_att_tl_row_date">
                                        <th class="o_att_tl_col_days py-2 px-3 fw-bold text-center border-bottom border-end bg-light" style="width: 220px; min-width: 200px;">
                                            Days
                                        </th>
                                        <th t-att-colspan="timelineHours.length" class="py-2 px-3 border-bottom bg-light">
                                            <div class="d-flex align-items-center gap-2">
                                                <i class="fa fa-caret-left text-muted cursor-pointer" t-on-click="onPrevDay"/>
                                                <span class="fw-bold fs-6 text-dark" t-esc="timelineFormattedDate"/>
                                                <i class="fa fa-caret-right text-muted cursor-pointer" t-on-click="onNextDay"/>
                                            </div>
                                        </th>
                                    </tr>
                                    <!-- Row 2: Hour Headers 7am to 5pm -->
                                    <tr class="o_att_tl_row_hours">
                                        <th class="border-end border-bottom bg-light"/>
                                        <t t-foreach="timelineHours" t-as="h" t-key="h">
                                            <th t-att-class="'o_att_tl_col_h py-1 text-center small text-muted border-bottom border-end' + (isCurrentHour(h) ? ' o_att_tl_col--current' : '')" style="min-width: 60px;">
                                                <span t-esc="formatHourLabel(h)"/>
                                            </th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="visibleRows" t-as="line" t-key="line.teacher_id">
                                        <t t-set="tl" t-value="getLineTimeline(line)"/>
                                        <tr class="o_att_tl_row_staff border-bottom">
                                            <!-- Left Staff Cell with avatar & name (green highlight if present!) -->
                                            <td t-att-class="'o_att_tl_cell_staff py-2 px-3 border-end' + (isLinePresent(line) ? ' o_att_tl_staff--present' : '')"
                                                t-on-click="() => this.setActive(line)">
                                                <div class="d-flex align-items-center gap-2">
                                                    <t t-if="line.has_image">
                                                        <img class="o_att_avatar rounded-circle flex-shrink-0" t-att-src="'/web/image/university.teacher/' + line.teacher_id + '/image_1920'" alt="" style="width: 28px; height: 28px; object-fit: cover;"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span t-att-class="'o_att_avatar o_att_avatar--' + teacherTone(line) + ' rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0 text-white fw-bold'"
                                                              style="width: 28px; height: 28px; font-size: 11px;"
                                                              t-esc="teacherInitial(line)"/>
                                                    </t>
                                                    <div class="d-flex flex-column text-truncate">
                                                        <span class="fw-semibold text-truncate small text-dark" t-att-title="line.name" t-esc="line.name"/>
                                                        <span class="text-muted" style="font-size: 10px;" t-esc="line.code"/>
                                                    </div>
                                                </div>
                                            </td>

                                            <!-- Right Timeline Track Cell -->
                                            <td t-att-colspan="timelineHours.length" class="o_att_tl_cell_track position-relative p-0" style="height: 48px;">
                                                <!-- Background vertical hour grid lines -->
                                                <div class="o_att_tl_grid_bg position-absolute top-0 bottom-0 start-0 end-0 d-flex pointer-events-none">
                                                    <t t-foreach="timelineHours" t-as="h" t-key="h">
                                                        <div t-att-class="'flex-grow-1 border-end' + (isCurrentHour(h) ? ' o_att_tl_col--current' : '')"/>
                                                    </t>
                                                </div>

                                                <!-- Schedule Pill -->
                                                <div t-if="tl.hasPill"
                                                     t-att-class="'o_att_pill position-absolute ' + tl.pillClass"
                                                     t-att-style="'left: ' + tl.left + '; width: ' + tl.width + ';'"
                                                     t-att-title="line.name + ' | ' + tl.label + ' | Status: ' + line.status + (line.remark ? ' (' + line.remark + ')' : '')"
                                                     t-on-click="() => this.setActive(line)">
                                                    <span class="o_att_pill_label text-truncate" t-esc="tl.label"/>
                                                </div>
                                                <!-- Badges for Leave, Absent, Official Duty -->
                                                <div t-elif="tl.statusText" class="position-absolute start-0 ms-2" style="top: 10px; z-index: 2;">
                                                    <span t-att-class="'badge ' + (line.status === 'leave' ? 'bg-primary-subtle text-primary border' : line.status === 'absent' ? 'bg-danger-subtle text-danger border' : 'bg-info-subtle text-info border')" t-esc="tl.statusText"/>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- ==================== TABLE VIEW ==================== -->
                    <t t-if="state.viewMode === 'table'">
                        <!-- Column Headings -->
                        <div class="o_att_listhead o_att_listhead--staff" t-if="visibleRows.length" aria-hidden="true">
                            <span class="o_att_listhead_label">Staff Member</span>
                            <span class="o_att_listhead_label o_att_listhead_label--center">Attendance Status</span>
                            <span class="o_att_listhead_label o_att_listhead_label--center">Check-In</span>
                            <span class="o_att_listhead_label o_att_listhead_label--center">Check-Out</span>
                            <span class="o_att_listhead_label o_att_listhead_label--center">Hours</span>
                            <span class="o_att_listhead_label o_att_listhead_label--center">Note</span>
                        </div>

                        <!-- Staff Rows -->
                        <ul class="o_att_rows" t-if="visibleRows.length">
                            <t t-foreach="visibleRows" t-as="line" t-key="line.teacher_id">
                                <li t-att-class="'o_att_row o_att_row--staff' + (line.teacher_id === state.activeId ? ' o_att_row--active' : '')">
                                <!-- Staff Info Column -->
                                <div class="o_att_student" t-on-click="() => this.setActive(line)">
                                    <t t-if="line.has_image">
                                        <img class="o_att_avatar" t-att-src="'/web/image/university.teacher/' + line.teacher_id + '/image_1920'" alt=""/>
                                    </t>
                                    <t t-else="">
                                        <span t-att-class="'o_att_avatar o_att_avatar--' + teacherTone(line)"
                                              aria-hidden="true"
                                              t-esc="teacherInitial(line)"/>
                                    </t>
                                    <span class="o_att_student_text">
                                        <span class="o_att_student_name">
                                            <t t-esc="line.name"/>
                                            <span t-if="line.state === 'approved'" class="badge rounded-pill bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.7rem;">Approved</span>
                                            <span t-elif="line.state === 'submitted'" class="badge rounded-pill bg-info-subtle text-info border border-info-subtle ms-1" style="font-size: 0.7rem;">Submitted</span>
                                            <span t-elif="line.state === 'rejected'" class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle ms-1" style="font-size: 0.7rem;">Rejected</span>
                                        </span>
                                        <span class="o_att_student_meta">
                                            <span t-esc="line.code || 'No ID'"/>
                                            <span class="o_att_student_sep" aria-hidden="true">·</span>
                                            <span t-if="line.department" class="o_att_chip" t-esc="line.department"/>
                                        </span>
                                    </span>
                                </div>

                                <!-- Segmented Status Buttons -->
                                <div class="o_att_seg o_att_seg--staff" role="radiogroup"
                                     t-att-aria-label="'Status for ' + line.name">
                                    <button t-foreach="statusOptions" t-as="opt" t-key="opt.value"
                                            type="button"
                                            t-att-class="'o_att_seg__btn o_att_seg__btn--' + opt.value + (line.status === opt.value ? ' o_att_seg__btn--on' : '')"
                                            role="radio"
                                            t-att-data-teacher="line.teacher_id"
                                            t-att-data-status="opt.value"
                                            t-att-aria-checked="line.status === opt.value ? 'true' : 'false'"
                                            t-att-title="opt.label"
                                            t-att-disabled="line.state === 'approved' || !state.isAdmin || state.loading || state.saving"
                                            t-on-click="() => this.setStatus(line, opt.value)">
                                        <i t-if="line.status === opt.value" class="fa fa-check me-1" aria-hidden="true"/>
                                        <span t-esc="opt.label"/>
                                    </button>
                                </div>

                                <!-- Check-In Time Input -->
                                <div class="o_att_timecell">
                                    <div t-att-class="'o_att_time_wrap' + (line.state === 'approved' || line.status === 'absent' || line.status === 'leave' || !state.isAdmin ? ' o_att_time_wrap--disabled' : '')">
                                        <i class="fa fa-sign-in text-success o_att_time_icon" aria-hidden="true"/>
                                        <input type="time"
                                               class="o_att_time_input"
                                               t-att-value="line.check_in"
                                               t-att-disabled="line.state === 'approved' || line.status === 'absent' || line.status === 'leave' || !state.isAdmin || state.loading || state.saving"
                                               t-att-aria-label="'Check-in for ' + line.name"
                                               t-on-change="(ev) => this.onCheckInChange(line, ev)"/>
                                    </div>
                                </div>

                                <!-- Check-Out Time Input -->
                                <div class="o_att_timecell">
                                    <div t-att-class="'o_att_time_wrap' + (line.state === 'approved' || line.status === 'absent' || line.status === 'leave' || !state.isAdmin ? ' o_att_time_wrap--disabled' : '')">
                                        <i class="fa fa-sign-out text-danger o_att_time_icon" aria-hidden="true"/>
                                        <input type="time"
                                               class="o_att_time_input"
                                               t-att-value="line.check_out"
                                               t-att-disabled="line.state === 'approved' || line.status === 'absent' || line.status === 'leave' || !state.isAdmin || state.loading || state.saving"
                                               t-att-aria-label="'Check-out for ' + line.name"
                                               t-on-change="(ev) => this.onCheckOutChange(line, ev)"/>
                                    </div>
                                </div>

                                <!-- Hours Badge -->
                                <div class="o_att_hourscell">
                                    <span t-att-class="'o_att_hours_badge' + (line.worked_hours > 0 ? ' o_att_hours_badge--filled' : '')"
                                          t-esc="fmtHours(line.worked_hours)"/>
                                </div>

                                <!-- Note Button -->
                                <div class="o_att_notecell">
                                    <button type="button"
                                            t-att-class="'o_att_notebtn' + (line.remark ? ' o_att_notebtn--has-note' : (state.openNoteId === line.teacher_id ? ' o_att_notebtn--open' : ''))"
                                            t-att-aria-expanded="state.openNoteId === line.teacher_id ? 'true' : 'false'"
                                            t-att-aria-label="(line.remark ? 'Edit note' : 'Add note') + ' for ' + line.name"
                                            t-on-click="() => this.toggleNote(line)">
                                        <i class="fa fa-comment-o" aria-hidden="true"/>
                                        <span t-if="line.remark" class="o_att_notebtn_dot" aria-hidden="true"/>
                                    </button>
                                </div>
                            </li>

                            <!-- Inline Note Drawer -->
                            <li t-if="state.openNoteId === line.teacher_id" class="o_att_row o_att_noterow">
                                <div class="o_att_noterow_inner">
                                    <div class="o_att_noterow_field">
                                        <input type="text"
                                               class="o_att_note_input"
                                               t-att-value="line.remark"
                                               t-att-disabled="!state.isAdmin || state.loading || state.saving"
                                               t-att-placeholder="'Add an attendance note for ' + line.name + '...'"
                                               t-on-input="(ev) => this.updateNote(line, ev)"
                                               t-on-keydown="(ev) => ev.key === 'Enter' || ev.key === 'Escape' ? this.closeNote() : null"/>
                                    </div>
                                    <button type="button" class="o_att_linkbtn" t-on-click="closeNote">Done</button>
                                    <button t-if="line.remark and state.isAdmin" type="button" class="o_att_linkbtn o_att_linkbtn--danger"
                                            t-on-click="() => this.clearNote(line)">Clear</button>
                                </div>
                            </li>
                        </t>
                    </ul>
                    </t>

                    <!-- Polished Empty States Matching Student Attendance -->
                    <div t-if="state.loading" class="o_att_empty py-5">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;"/>
                        <p class="o_att_empty_title mb-1">Loading staff roster...</p>
                        <p class="text-muted small">Fetching teachers and attendance records</p>
                    </div>

                    <div t-elif="isEmpty" class="o_att_empty py-5">
                        <div class="o_empty_icon_box rounded-circle mx-auto mb-3 bg-light d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="fa fa-building-o fa-2x text-muted" aria-hidden="true"/>
                        </div>
                        <h5 class="o_att_empty_title fw-bold text-dark mb-1">Select a Department</h5>
                        <p class="text-muted small mb-0">Choose a department from the dropdown above to view staff members and track attendance.</p>
                    </div>

                    <div t-elif="noStaff" class="o_att_empty py-5">
                        <div class="o_empty_icon_box rounded-circle mx-auto mb-3 bg-light d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="fa fa-user-plus fa-2x text-muted" aria-hidden="true"/>
                        </div>
                        <h5 class="o_att_empty_title fw-bold text-dark mb-1">No Active Staff Found</h5>
                        <p class="text-muted small mb-3" style="max-width: 420px; margin: 0 auto;">
                            There are currently no active academic staff members in <strong class="text-dark" t-esc="currentDepartmentName"/>.
                        </p>
                    </div>

                    <div t-elif="hasNoMatch" class="o_att_empty py-5">
                        <div class="o_empty_icon_box rounded-circle mx-auto mb-3 bg-light d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                            <i class="fa fa-search fa-2x text-muted" aria-hidden="true"/>
                        </div>
                        <h5 class="o_att_empty_title fw-bold text-dark mb-1">No Staff Match Your Filter</h5>
                        <p class="text-muted small mb-3">Try searching with a different name or reset your search query.</p>
                        <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="clearFilters">
                            <i class="fa fa-times me-1"/> Clear Filters
                        </button>
                    </div>
                </section>

                <!-- 7. Tab 2: Department & Policy Details -->
                <section t-if="state.tab === 'details'" id="satt_details_panel" class="o_att_details"
                         role="tabpanel" aria-labelledby="satt_details_tab">
                    <h2 class="o_att_section_heading">Department &amp; Faculty Overview</h2>
                    <div class="o_att_info_row">
                        <span class="o_att_info_label">Department</span>
                        <span t-esc="currentDepartmentName || 'All Departments'"/>
                    </div>
                    <div class="o_att_info_row" t-if="currentFacultyName">
                        <span class="o_att_info_label">Faculty</span>
                        <span t-esc="currentFacultyName"/>
                    </div>
                    <div class="o_att_info_row" t-if="currentHeadName">
                        <span class="o_att_info_label">Head of Dept</span>
                        <span t-esc="currentHeadName"/>
                    </div>
                    <div class="o_att_info_row">
                        <span class="o_att_info_label">Staff Count</span>
                        <span><t t-esc="state.lines.length"/> teachers</span>
                    </div>

                    <h2 class="o_att_section_heading">University Attendance Policy</h2>
                    <div class="o_att_info_row">
                        <span class="o_att_info_label">Expected In</span>
                        <span><t t-esc="state.expectedCheckInTime || '08:00'"/></span>
                    </div>
                    <div class="o_att_info_row">
                        <span class="o_att_info_label">Expected Out</span>
                        <span><t t-esc="state.expectedCheckOutTime || '17:00'"/></span>
                    </div>
                    <div class="o_att_info_row">
                        <span class="o_att_info_label">Late Grace</span>
                        <span><t t-esc="state.graceMinutes"/> minutes</span>
                    </div>

                    <label class="o_att_section_heading" for="satt_session_notes">Department Daily Log &amp; Notes</label>
                    <textarea id="satt_session_notes" class="o_att_session_notes" rows="4"
                              t-model="state.notes"
                              t-att-disabled="!state.isAdmin || state.loading || state.saving"
                              placeholder="Add daily departmental attendance notes, memos, or supervisory remarks..."/>
                </section>

                <!-- 8. Sticky Action Bar Matching Student Attendance -->
                <footer class="o_att_actionbar">
                    <p t-att-class="'o_att_hint ' + (isDirty ? 'o_att_hint--dirty' : 'o_att_hint--clean')" aria-live="polite">
                        <span class="o_att_hint_dot" aria-hidden="true"/>
                        <span t-if="!state.isAdmin">View only · Administrator privileges required to edit</span>
                        <span t-elif="isDirty">Unsaved changes</span>
                        <span t-elif="state.lastSaved">All changes saved</span>
                        <span t-else="">Draft (not saved)</span>
                    </p>
                    <div class="o_att_actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary o_att_btn--ghost"
                                title="Set all staff members to Present"
                                t-att-disabled="!state.isAdmin || !state.lines.length || state.loading || state.saving"
                                t-on-click="markAllPresent">
                            <i class="fa fa-check-square-o me-1" aria-hidden="true"/> Mark all present
                        </button>
                        <button type="button" class="btn btn-sm btn-primary o_att_btn--primary"
                                t-att-disabled="!state.isAdmin || !state.lines.length || state.loading || state.saving"
                                t-on-click="saveAttendance">
                            <t t-if="state.saving">
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"/>
                                Saving...
                            </t>
                            <t t-else="">
                                <i class="fa fa-floppy-o me-1" aria-hidden="true"/> Save attendance
                            </t>
                        </button>
                    </div>
                </footer>
            </div>

            <!-- 9. Side Chatter Matching Student Attendance -->
            <aside class="o_att_chatter" aria-label="Staff attendance audit &amp; discussion log">
                <Chatter t-if="activeStaffAttendanceId &amp;&amp; !state.loading"
                         t-key="'att-' + activeStaffAttendanceId + '-' + state.chatterRevision"
                         threadModel="'university.staff.attendance'" threadId="activeStaffAttendanceId"
                         has_activities="true" isChatterAside="false"/>
                <Chatter t-elif="state.activeId &amp;&amp; !state.loading"
                         t-key="'teacher-' + state.activeId + '-' + state.chatterRevision"
                         threadModel="'university.teacher'" threadId="state.activeId"
                         has_activities="true" isChatterAside="false"/>
                <div t-else="" class="o_att_chatter_empty">
                    <i class="fa fa-comments-o" aria-hidden="true"/>
                    <span t-if="state.loading">Loading attendance log...</span>
                    <span t-else="">Select a staff member to view their activity and discussion thread.</span>
                </div>
            </aside>
        </div>
    </div>
</t>
</templates>
