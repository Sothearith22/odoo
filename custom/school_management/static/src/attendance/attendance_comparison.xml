<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="school_management.AttendanceComparison">
        <div class="o_att_comparison p-4">
            <!-- HEADER TOOLBAR -->
            <div class="o_att_comp_header d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                <div>
                    <h1 class="o_att_comp_title h3 fw-bold mb-1 text-dark">
                        <i class="fa fa-bar-chart me-2 text-primary" title="Attendance Comparison" aria-hidden="true"/>
                        Attendance Comparison
                    </h1>
                    <p class="text-muted small mb-0">Cross-department and class section attendance performance metrics</p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Year selector -->
                    <div class="input-group input-group-sm" style="width: auto;">
                        <span class="input-group-text bg-white text-muted">
                            <i class="fa fa-calendar me-1" title="Year" aria-hidden="true"/>Year
                        </span>
                        <input type="number" min="2000" max="2100" class="form-control form-control-sm" style="width: 85px;"
                               t-att-value="state.year"
                               t-on-change="onYearChange"
                               t-att-disabled="state.loading"/>
                    </div>

                    <!-- Department filter -->
                    <select class="form-select form-select-sm" style="width: auto; max-width: 200px;"
                            t-on-change="onDepartmentFilterChange"
                            t-att-disabled="state.loading">
                        <option value="all">All Departments</option>
                        <t t-if="state.data and state.data.departments">
                            <option t-foreach="state.data.departments" t-as="dept" t-key="dept.id"
                                    t-att-value="dept.id"
                                    t-att-selected="state.departmentFilter == dept.id"
                                    t-esc="dept.name"/>
                        </t>
                    </select>

                    <!-- View Switcher (Kanban vs Table) -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button"
                                t-att-class="'btn ' + (state.viewMode === 'kanban' ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => this.setViewMode('kanban')"
                                title="Kanban View" aria-label="Kanban View">
                            <i class="fa fa-th-large me-1" title="Kanban" aria-hidden="true"/>Kanban
                        </button>
                        <button type="button"
                                t-att-class="'btn ' + (state.viewMode === 'table' ? 'btn-primary' : 'btn-outline-secondary')"
                                t-on-click="() => this.setViewMode('table')"
                                title="Table View" aria-label="Table View">
                            <i class="fa fa-table me-1" title="Table" aria-hidden="true"/>Table
                        </button>
                    </div>

                    <!-- Refresh Button -->
                    <button class="btn btn-sm btn-outline-secondary" t-on-click="load" t-att-disabled="state.loading" title="Refresh" aria-label="Refresh">
                        <i class="fa fa-refresh me-1" t-att-class="state.loading ? 'fa-spin' : ''" title="Refresh" aria-hidden="true"/>
                        Refresh
                    </button>
                </div>
            </div>

            <!-- ERROR ALERT -->
            <div class="alert alert-danger d-flex align-items-center mb-4" t-if="state.error" role="alert">
                <i class="fa fa-exclamation-triangle me-2 fs-5" title="Error" aria-hidden="true"/>
                <span t-esc="state.error"/>
            </div>

            <!-- LOADING SPINNER -->
            <div class="text-center py-5" t-if="state.loading and !state.data">
                <i class="fa fa-spinner fa-spin fa-2x text-muted" title="Loading" aria-hidden="true"/>
                <div class="text-muted mt-2">Loading attendance comparison data...</div>
            </div>

            <!-- MAIN CONTENT -->
            <t t-if="state.data">
                <!-- KPI SUMMARY CARDS -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card shadow-sm border-0 h-100 rounded-3">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary" style="width: 52px; height: 52px;">
                                    <i class="fa fa-percent fa-lg" title="Average Attendance Rate" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Average Attendance</div>
                                    <div class="fs-4 fw-bold text-dark">
                                        <t t-esc="summary.avgRate"/>%
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card shadow-sm border-0 h-100 rounded-3">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-info-subtle text-info" style="width: 52px; height: 52px;">
                                    <i class="fa fa-building fa-lg" title="Departments" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Departments</div>
                                    <div class="fs-4 fw-bold text-dark">
                                        <t t-esc="summary.totalDepts"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card shadow-sm border-0 h-100 rounded-3">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-success-subtle text-success" style="width: 52px; height: 52px;">
                                    <i class="fa fa-graduation-cap fa-lg" title="Class Sections" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Class Sections</div>
                                    <div class="fs-4 fw-bold text-dark">
                                        <t t-esc="summary.totalSections"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-xl-3">
                        <div class="card shadow-sm border-0 h-100 rounded-3">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-warning-subtle text-warning" style="width: 52px; height: 52px;">
                                    <i class="fa fa-list-alt fa-lg" title="Attendance Records" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Total Logs</div>
                                    <div class="fs-4 fw-bold text-dark">
                                        <t t-esc="summary.totalRecords"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PERFORMANCE FILTER PILLS -->
                <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                    <span class="text-muted small fw-semibold me-1">Filter Performance:</span>
                    <button type="button"
                            t-att-class="'btn btn-sm rounded-pill ' + (state.statusFilter === 'all' ? 'btn-dark' : 'btn-outline-secondary')"
                            t-on-click="() => this.setStatusFilter('all')">
                        All Sections
                    </button>
                    <button type="button"
                            t-att-class="'btn btn-sm rounded-pill ' + (state.statusFilter === 'good' ? 'btn-success' : 'btn-outline-success')"
                            t-on-click="() => this.setStatusFilter('good')">
                        <i class="fa fa-check-circle me-1" title="Excellent" aria-hidden="true"/>
                        Excellent (&#8805; 90%)
                    </button>
                    <button type="button"
                            t-att-class="'btn btn-sm rounded-pill ' + (state.statusFilter === 'warn' ? 'btn-warning' : 'btn-outline-warning')"
                            t-on-click="() => this.setStatusFilter('warn')">
                        <i class="fa fa-exclamation-triangle me-1" title="Average" aria-hidden="true"/>
                        Average (75% - 89%)
                    </button>
                    <button type="button"
                            t-att-class="'btn btn-sm rounded-pill ' + (state.statusFilter === 'bad' ? 'btn-danger' : 'btn-outline-danger')"
                            t-on-click="() => this.setStatusFilter('bad')">
                        <i class="fa fa-times-circle me-1" title="At Risk" aria-hidden="true"/>
                        At Risk (&lt; 75%)
                    </button>
                </div>

                <!-- EMPTY STATE -->
                <div class="alert alert-info d-flex align-items-center"
                     t-if="!filteredDepartments.length" role="alert">
                    <i class="fa fa-info-circle me-2 fs-5" title="Information" aria-hidden="true"/>
                    <div>No departments or class sections match the selected filters.</div>
                </div>

                <!-- KANBAN VIEW MODE -->
                <t t-if="state.viewMode === 'kanban'">
                    <div class="o_att_dept_group mb-5"
                         t-foreach="filteredDepartments" t-as="department" t-key="department.id">
                        <!-- Department Section Header Banner -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between p-3 mb-3 bg-white rounded-3 shadow-sm border">
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary text-white rounded p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                    <i class="fa fa-university" title="Department" aria-hidden="true"/>
                                </div>
                                <div>
                                    <h4 class="h5 fw-bold mb-0 text-dark" t-esc="department.name"/>
                                    <span class="text-muted small">
                                        <t t-esc="department.filteredSections.length"/> section(s) displayed
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <div class="text-end">
                                    <div class="text-muted small">Department Attendance</div>
                                    <div class="fw-bold fs-6">
                                        <span t-att-class="department.rate &gt;= 90 ? 'text-success' : (department.rate &gt;= 75 ? 'text-warning' : 'text-danger')"
                                              t-esc="department.rate + '%'"/>
                                    </div>
                                </div>
                                <div class="progress" style="width: 120px; height: 8px;">
                                    <div t-att-class="'progress-bar ' + getRateProgressBarClass(department.rate)"
                                         role="progressbar"
                                         t-att-style="'width: ' + department.rate + '%;'"
                                         t-att-aria-valuenow="department.rate"
                                         aria-valuemin="0" aria-valuemax="100"/>
                                </div>
                            </div>
                        </div>

                        <!-- Kanban Cards Grid -->
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                            <t t-foreach="department.filteredSections" t-as="section" t-key="section.id">
                                <div class="col">
                                    <div class="card h-100 shadow-sm border rounded-3 o_att_section_card">
                                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                                            <!-- Card Header -->
                                            <div>
                                                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                                    <h5 class="card-title fw-bold text-dark text-truncate mb-0" t-att-title="section.name">
                                                        <i class="fa fa-users me-1 text-secondary" title="Class" aria-hidden="true"/>
                                                        <t t-esc="section.name"/>
                                                    </h5>
                                                    <span t-att-class="getRateBadgeClass(section.rate)"
                                                          t-esc="getRateStatusLabel(section.rate)"/>
                                                </div>

                                                <!-- Rate Gauge / Bar -->
                                                <div class="mt-3 mb-3 p-2 rounded-2 bg-light border">
                                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                                        <span class="text-muted small fw-semibold">Attendance Rate</span>
                                                        <span class="fw-bold fs-5"
                                                              t-att-class="section.rate &gt;= 90 ? 'text-success' : (section.rate &gt;= 75 ? 'text-warning' : 'text-danger')"
                                                              t-esc="section.rate + '%'"/>
                                                    </div>
                                                    <div class="progress" style="height: 8px;">
                                                        <div t-att-class="'progress-bar progress-bar-striped progress-bar-animated ' + getRateProgressBarClass(section.rate)"
                                                             role="progressbar"
                                                             t-att-style="'width: ' + section.rate + '%;'"
                                                             t-att-aria-valuenow="section.rate"
                                                             aria-valuemin="0" aria-valuemax="100"/>
                                                    </div>
                                                </div>

                                                <!-- Metric Chips -->
                                                <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                                                    <span>
                                                        <i class="fa fa-graduation-cap me-1 text-primary" title="Enrolled Students" aria-hidden="true"/>
                                                        <strong><t t-esc="section.students.length"/></strong> Enrolled
                                                    </span>
                                                    <span>
                                                        <i class="fa fa-check-square-o me-1 text-info" title="Total Logs" aria-hidden="true"/>
                                                        <strong><t t-esc="section.total"/></strong> Records
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Collapsible Student List -->
                                            <div t-if="state.expandedSections[section.id]" class="mt-2 pt-2 border-top">
                                                <div class="fw-semibold small text-muted mb-2">Student Performance:</div>
                                                <div class="o_att_student_mini_list overflow-auto" style="max-height: 180px;">
                                                    <div t-foreach="section.students" t-as="student" t-key="student.id"
                                                         class="d-flex align-items-center justify-content-between py-1 border-bottom small">
                                                        <div class="text-truncate me-2" t-att-title="student.name">
                                                            <span class="fw-semibold" t-esc="student.name"/>
                                                            <span class="text-muted ms-1" t-if="student.code" t-esc="'(' + student.code + ')'"/>
                                                        </div>
                                                        <div class="fw-bold"
                                                             t-att-class="student.rate &gt;= 90 ? 'text-success' : (student.rate &gt;= 75 ? 'text-warning' : 'text-danger')"
                                                             t-esc="student.rate + '%'"/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Card Actions Footer -->
                                            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                                <button type="button"
                                                        class="btn btn-sm btn-link p-0 text-decoration-none small text-secondary"
                                                        t-on-click="() => this.toggleSectionStudents(section.id)">
                                                    <i t-att-class="'fa me-1 ' + (state.expandedSections[section.id] ? 'fa-chevron-up' : 'fa-chevron-down')"
                                                       title="Toggle" aria-hidden="true"/>
                                                    <t t-esc="state.expandedSections[section.id] ? 'Hide Students' : 'View Students (' + section.students.length + ')'"/>
                                                </button>

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary py-1 px-2"
                                                        t-on-click="() => this.openSectionSheet(section.id)"
                                                        title="Open Attendance Sheet" aria-label="Open Attendance Sheet">
                                                    <i class="fa fa-calendar-check-o me-1" title="Sheet" aria-hidden="true"/>
                                                    Sheet
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

                <!-- TABLE VIEW MODE -->
                <t t-else="">
                    <div class="card shadow-sm border rounded-3 mb-4"
                         t-foreach="filteredDepartments" t-as="department" t-key="department.id">
                        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold text-dark">
                                <i class="fa fa-university me-2 text-primary" title="Department" aria-hidden="true"/>
                                <t t-esc="department.name"/>
                            </h5>
                            <span class="badge text-bg-light border text-muted">
                                Attendance rate: <b class="text-dark" t-esc="department.rate"/>%
                            </span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Class Section</th>
                                        <th class="text-center">Enrolled Students</th>
                                        <th class="text-center">Total Records</th>
                                        <th style="width: 250px;">Attendance Rate</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="department.filteredSections" t-as="section" t-key="section.id">
                                        <td class="fw-semibold text-dark" t-esc="section.name"/>
                                        <td class="text-center" t-esc="section.students.length"/>
                                        <td class="text-center" t-esc="section.total"/>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div t-att-class="'progress-bar ' + getRateProgressBarClass(section.rate)"
                                                         role="progressbar"
                                                         t-att-style="'width: ' + section.rate + '%;'"
                                                         t-att-aria-valuenow="section.rate"
                                                         aria-valuemin="0" aria-valuemax="100"/>
                                                </div>
                                                <span class="fw-bold small"
                                                      t-att-class="section.rate &gt;= 90 ? 'text-success' : (section.rate &gt;= 75 ? 'text-warning' : 'text-danger')"
                                                      t-esc="section.rate + '%'"/>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary py-0 px-2"
                                                    t-on-click="() => this.openSectionSheet(section.id)"
                                                    title="Open Attendance Sheet" aria-label="Open Attendance Sheet">
                                                <i class="fa fa-calendar-check-o me-1" title="Sheet" aria-hidden="true"/>
                                                Sheet
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
