<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_university_enrollment_wizard_form" model="ir.ui.view">
        <field name="name">university.enrollment.wizard.form</field>
        <field name="model">university.enrollment.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Enroll Students">
                
                <!-- Capacity Warning Ribbon -->
                <widget name="web_ribbon" title="Over Capacity!" bg_color="text-bg-danger" invisible="not capacity_warning"/>

                <sheet>
                    <div class="row">
                        <!-- Step 1 & 2: Selection -->
                        <div class="col-md-7">
                            <h4 class="text-primary mb-3">1. Select Academic Target</h4>
                            <group>
                                <field name="faculty_id"
                                       options="{'no_create': True}"
                                       placeholder="Select Faculty..."/>

                                <field name="department_id"
                                       options="{'no_create': True}"
                                       placeholder="Select Department..."/>

                                <field name="program_id"
                                       options="{'no_create': True}"
                                       placeholder="Search Major / Program..."/>
                                
                                <field name="subject_id"
                                       options="{'no_create': True}"
                                       invisible="not program_id"
                                       required="program_id"
                                       placeholder="Select Subject..."/>
                                
                                <field name="section_id"
                                       options="{'no_create': True}"
                                       invisible="not subject_id"
                                       required="subject_id"
                                       placeholder="Select Class Section..."/>
                            </group>
                            
                            <h4 class="text-primary mt-4 mb-3">2. Enrollment Configuration</h4>
                            <group>
                                <field name="enrollment_date"/>
                                <field name="status" widget="radio" options="{'horizontal': true}"/>
                            </group>
                        </div>
                        
                        <!-- Summary Panel -->
                        <div class="col-md-5">
                            <div invisible="not section_id" class="alert alert-info" role="status" style="border-radius: 8px;">
                                <h5 class="alert-heading fw-bold mb-3"><i class="fa fa-info-circle me-2"/>Section Details</h5>
                                <div class="mb-2"><strong><i class="fa fa-user me-2"/>Instructor:</strong> <field name="teacher_id" readonly="1" force_save="1"/></div>
                                <div class="mb-2"><strong><i class="fa fa-calendar me-2"/>Semester:</strong> <field name="semester_id" readonly="1" force_save="1"/></div>
                                <div class="mb-2"><strong><i class="fa fa-clock-o me-2"/>Academic Year:</strong> <field name="academic_year_id" readonly="1" force_save="1"/></div>
                                
                                <hr/>
                                
                                <div class="d-flex justify-content-between mb-1">
                                    <span>Enrolled:</span>
                                    <span class="badge text-bg-secondary"><field name="enrolled_count"/></span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span>Available Seats:</span>
                                    <span t-attf-class="badge #{record.capacity_warning.raw_value ? 'text-bg-danger' : 'text-bg-success'}">
                                        <field name="available_seats"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <strong>Selected to Enroll:</strong>
                                    <strong><field name="selected_student_count"/></strong>
                                </div>
                                <field name="capacity_warning" invisible="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Loaded Subjects -->
                    <h4 class="text-primary mt-4 mb-3" invisible="not program_id">3. Loaded Subjects for Major</h4>
                    <field name="subject_ids"
                           nolabel="1"
                           widget="many2many"
                           invisible="not program_id">
                        <list create="false" edit="false" delete="false">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="credits"/>
                            <field name="semester_number"/>
                            <field name="department_id"/>
                        </list>
                    </field>

                    <!-- Step 4: Students -->
                    <h4 class="text-primary mt-4 mb-3" invisible="not program_id">4. Selected Students</h4>
                    <field name="student_ids"
                           nolabel="1"
                           widget="many2many"
                           domain="[('status', '=', 'active'), ('program_id', '=', program_id)]"
                           invisible="not program_id"
                           required="program_id">
                        <list>
                            <field name="image_1920" widget="image" options="{'size': [32, 32]}" string="Photo"/>
                            <field name="student_id"/>
                            <field name="name"/>
                            <field name="program_id"/>
                            <field name="department_id"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_enroll_students"
                            string="Enroll Selected Students"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_university_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Enroll Students</field>
        <field name="res_model">university.enrollment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
