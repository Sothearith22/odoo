<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_university_bulk_enrollment_wizard_form" model="ir.ui.view">
        <field name="name">university.bulk.enrollment.wizard.form</field>
        <field name="model">university.bulk.enrollment.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Major Enrollment">
                <sheet>
                    <group>
                        <group string="Academic Structure">
                            <field name="faculty_id" options="{'no_create': True}"/>
                            <field name="department_id" options="{'no_create': True}"/>
                            <field name="program_id" options="{'no_create': True}"/>
                            <field name="section_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Academic Information">
                            <field name="academic_year_id" options="{'no_create': True}"/>
                            <field name="semester_id" options="{'no_create': True}"/>
                            <field name="enrollment_date"/>
                            <field name="status"/>
                        </group>
                    </group>

                    <group string="Students">
                        <field name="eligible_student_ids" invisible="1"/>
                        <div class="alert alert-info mb-2" role="alert">
                            Select students manually from the list, or use
                            <strong>Select All Eligible Students</strong> to add
                            every active student matching the selected major,
                            academic year, semester and section.
                        </div>
                        <group>
                            <button name="action_select_all_eligible_students"
                                    string="Select All Eligible Students"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-users"/>
                            <button name="action_clear_students"
                                    string="Clear Selection"
                                    type="object"
                                    class="btn-secondary"
                                    icon="fa-times"/>
                        </group>
                        <field name="student_ids"
                               nolabel="1"
                               domain="[('id', 'in', eligible_student_ids)]"
                               options="{'no_create': True}">
                            <list string="Selected Students" edit="false">
                                <field name="student_id"/>
                                <field name="name"/>
                                <field name="program_id"/>
                                <field name="status"/>
                            </list>
                        </field>
                        <field name="selected_student_count"
                               readonly="1"
                               class="text-muted"/>
                        <field name="eligible_student_count"
                               readonly="1"
                               class="text-muted"/>
                        <field name="available_seats"
                               readonly="1"
                               invisible="not section_id"/>
                        <field name="capacity_blocked"
                               invisible="1"/>
                    </group>
                    <div invisible="not capacity_blocked"
                         class="alert alert-warning mb-0"
                         role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/>
                        The selected class section is already full or will be
                        over capacity with the currently selected students.
                    </div>
                </sheet>
                <footer>
                    <button name="action_enroll_students"
                            string="Enroll Students"
                            type="object"
                            class="btn-primary"
                            icon="fa-check"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_university_bulk_enrollment_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Major Enrollment</field>
        <field name="res_model">university.bulk.enrollment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
