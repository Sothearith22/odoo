<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_attendance_take_wizard_form" model="ir.ui.view">
        <field name="name">university.attendance.take.wizard.form</field>
        <field name="model">university.attendance.take.wizard</field>
        <field name="arch" type="xml">
            <form string="Take Attendance">
                <header>
                    <button name="action_mark_all_present" type="object" string="Mark All Present" class="btn-secondary"/>
                    <button name="action_mark_all_absent" type="object" string="Mark All Absent" class="btn-secondary"/>
                    <button name="action_save" type="object" string="Save Attendance" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Pick a class section and date to load the student list, then set each
                        student's status. Only <b>present</b>, <b>absent</b>, <b>late</b> and
                        <b>excused</b> statuses are available.
                    </div>
                    <group>
                        <group>
                            <field name="section_id" required="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="notes" placeholder="Optional session notes..."/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="student_id" readonly="1"/>
                            <field name="status"
                                   decoration-success="status == 'present'"
                                   decoration-muted="status == 'excused'"
                                   decoration-info="status == 'late'"
                                   decoration-danger="status == 'absent'"/>
                            <field name="remark" placeholder="Remarks"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_attendance_take_wizard" model="ir.actions.act_window">
        <field name="name">Take Attendance</field>
        <field name="res_model">university.attendance.take.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>