<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_attendance_take_wizard_form" model="ir.ui.view">
        <field name="name">university.attendance.take.wizard.form</field>
        <field name="model">university.attendance.take.wizard</field>
        <field name="arch" type="xml">
            <form string="Take Attendance">
                <header>
                    <button name="action_mark_all_present" type="object" string="Mark All Present" class="btn-success text-white" icon="fa-check-circle"/>
                    <button name="action_mark_all_late" type="object" string="Mark All Late" class="btn-warning text-dark" icon="fa-clock-o"/>
                    <button name="action_mark_all_absent" type="object" string="Mark All Absent" class="btn-danger text-white" icon="fa-times-circle"/>
                </header>
                <sheet>
                    <div class="alert alert-info d-flex align-items-center mb-3" role="status">
                        <i class="fa fa-info-circle fa-2x me-3 text-info" title="Information"/>
                        <div>
                            Select a <strong>Class Section</strong> and <strong>Attendance Date</strong> to automatically load the enrolled student roster. Rapidly toggle student statuses using the bulk action buttons above.
                        </div>
                    </div>
                    <group>
                        <group string="Class &amp; Schedule">
                            <field name="section_id" required="1" options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group string="Session Log &amp; Topics">
                            <field name="notes" placeholder="e.g. Covered Chapter 4 Binary Search trees, in-class lab exercises..."/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <h4 class="text-dark fw-bold mb-2">Student Attendance</h4>
                        <field name="line_ids">
                            <list editable="bottom" create="0" delete="0">
                                <field name="student_id" readonly="1" decoration-bf="1"/>
                                <field name="status"
                                       widget="badge"
                                       decoration-success="status == 'present'"
                                       decoration-warning="status == 'late'"
                                       decoration-danger="status == 'absent'"
                                       decoration-muted="status == 'excused'"/>
                                <field name="remark" placeholder="Optional remark (e.g. Excused medical leave, left early...)"/>
                            </list>
                        </field>
                    </div>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save &amp; Submit Attendance" class="btn-primary" icon="fa-save"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_university_attendance_take_wizard" model="ir.actions.act_window">
        <field name="name">Take Attendance</field>
        <field name="res_model">university.attendance.take.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
