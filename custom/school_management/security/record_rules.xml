<?xml version="1.0" encoding="UTF-8"?>
<!--
    Record rules for organizational visibility.

    These provide role-based scoping for the organizational groups:
      - Teacher sees only their own profile and their assigned data.
      - Head of Department sees their department and its teachers/subjects.
      - Head of Faculty sees their faculty and its departments.

    The rules only apply to members of the corresponding role group, so they
    do not restrict the full-access Administrator or existing base users.
-->
<odoo>

    <!-- Student: access only to the student's own profile and transactions -->
    <record id="rule_student_own_profile" model="ir.rule">
        <field name="name">Student: own profile</field>
        <field name="model_id" ref="model_university_student"/>
        <field name="groups" eval="[(4, ref('group_school_student'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

