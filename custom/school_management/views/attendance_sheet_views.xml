<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_university_attendance_sheet" model="ir.actions.client">
        <field name="name">Student Attendance Management</field>
        <field name="tag">university_attendance_sheet</field>
        <field name="target">current</field>
    </record>
    <record id="view_university_attendance_session_form" model="ir.ui.view">
        <field name="name">university.attendance.session.form</field>
        <field name="model">university.attendance.session</field>
        <field name="arch" type="xml">
            <form string="Attendance Session" create="0">
                <header>
                    <button name="action_open_sheet" type="object" string="Track Attendance" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Track Attendance <field name="state" widget="badge" decoration-success="state == 'recorded'" decoration-muted="state == 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Session Information">
                            <field name="section_id" readonly="1"/>
                            <field name="recorded_by_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="date" readonly="1"/>
                            <field name="recorded_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Session Details"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
