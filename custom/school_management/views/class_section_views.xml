<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_university_class_section_list" model="ir.ui.view">
        <field name="name">university.class.section.list</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <list string="Class Sections" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="section_type"/>
                <field name="program_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <field name="classroom_id"/>
                <field name="capacity"/>
                <field name="enrolled_student_count"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_class_section_form" model="ir.ui.view">
        <field name="name">university.class.section.form</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <form string="Class Section">
                <header>
                    <button name="action_open_bulk_enroll_wizard" string="Enroll Multiple Students" type="object" class="oe_highlight"/>
                    <button name="action_open_populate_class_wizard" string="Populate Class" type="object" class="btn-secondary"/>
                    <button name="action_open_timetable_generation_wizard" string="Generate Timetable" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Section Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. CS-DBMS-Y1-A" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Program &amp; Subject">
                            <field name="section_type"/>
                            <field name="program_id"/>
                            <field name="subject_id" domain="[('program_ids', 'in', [program_id])]"/>
                            <field name="teacher_id" domain="[('subject_ids', 'in', subject_id)]"/>
                        </group>
                        <group string="Schedule &amp; Location">
                            <field name="semester_id"/>
                            <field name="classroom_id"/>
                            <field name="capacity"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Enrolled Students" name="students_tab">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'enrolled'"
                                           decoration-warning="status == 'draft'"
                                           decoration-danger="status in ['withdrawn', 'dropped']"
                                           decoration-muted="status == 'completed'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_class_section_search" model="ir.ui.view">
        <field name="name">university.class.section.search</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <search string="Search Class Sections">
                <field name="name"/>
                <field name="program_id"/>
                <field name="section_type"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Program" name="group_by_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Section Type" name="group_by_section_type" context="{'group_by': 'section_type'}"/>
                    <filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                </group>
                <searchpanel>
                    <field name="program_id" icon="fa-graduation-cap" enable_counters="1"/>
                    <field name="semester_id" icon="fa-calendar" enable_counters="1"/>
                    <field name="section_type" icon="fa-filter" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_class_section_kanban" model="ir.ui.view">
        <field name="name">university.class.section.kanban</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="program_id" quick_create="false">
                <field name="name"/>
                <field name="section_type"/>
                <field name="program_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <field name="classroom_id"/>
                <field name="capacity"/>
                <field name="enrolled_student_count"/>
                <field name="capacity_used_percent"/>
                <field name="is_full"/>
                <templates>
                    <t t-name="card">
                        <main class="ms-2 p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="fs-6 o_kanban_record_title"><field name="name"/></strong>
                                    <span t-if="record.is_full.raw_value" class="badge text-bg-danger ms-2">Full</span>
                                </div>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-tag me-1" title="Section Type"/>
                                <field name="section_type"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.program_id.value">
                                <i class="fa fa-graduation-cap me-1" title="Program"/>
                                <field name="program_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.subject_id.value">
                                <i class="fa fa-book me-1" title="Subject"/>
                                <field name="subject_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.teacher_id.value">
                                <i class="fa fa-user me-1" title="Instructor"/>
                                <field name="teacher_id"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-calendar me-1" title="Semester"/>
                                <field name="semester_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.classroom_id.value">
                                <i class="fa fa-building-o me-1" title="Room"/>
                                <field name="classroom_id"/>
                            </div>
                            <div class="mt-2 text-muted small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span><field name="enrolled_student_count"/> / <field name="capacity"/> Enrolled</span>
                                    <span><field name="capacity_used_percent"/>%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar"
                                         t-att-class="record.is_full.raw_value ? 'bg-danger' : 'bg-success'"
                                         t-att-style="'width: ' + record.capacity_used_percent.raw_value + '%'"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_university_class_section" model="ir.actions.act_window">
        <field name="name">Class Sections</field>
        <field name="res_model">university.class.section</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_university_class_section_search"/>
    </record>

</odoo>
