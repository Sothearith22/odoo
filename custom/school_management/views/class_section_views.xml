<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST / CLASS LIST VIEW FOR ADMIN -->
    <record id="view_university_class_section_list" model="ir.ui.view">
        <field name="name">university.class.section.list</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <list string="Class List" sample="1" decoration-danger="is_full" decoration-muted="not active">
                <field name="name" decoration-bf="1" string="Class Section"/>
                <field name="day_summary" string="Days" optional="show"/>
                <field name="time_summary" string="Time" optional="show"/>
                <field name="section_type" widget="badge" optional="show" string="Format"/>
                <field name="program_id" string="Major"/>
                <field name="year_level" optional="show"/>
                <field name="subject_id" optional="show"/>
                <field name="teacher_id" widget="many2one_avatar" string="Instructor"/>
                <field name="classroom_id" optional="show" string="Room"/>
                <field name="semester_id" optional="show"/>
                <field name="term_id" optional="show"/>
                <field name="timeline" optional="show"/>
                <field name="capacity" string="Capacity"/>
                <field name="enrolled_student_count" string="Enrolled"/>
                <field name="available_seats"
                       string="Spaces / Gaps"
                       decoration-success="available_seats &gt; 0"
                       decoration-danger="available_seats == 0"
                       decoration-bf="1"/>
                <field name="capacity_used_percent" widget="progressbar" string="Fill %"/>
                <field name="is_full"
                       widget="badge"
                       decoration-danger="is_full"
                       decoration-success="not is_full"
                       string="Status"/>
                <button name="action_view_schedule"
                        type="object"
                        string="Schedule"
                        icon="fa-calendar"
                        title="View Class Timetable / Schedule"/>
                <button name="action_view_enrolled_students"
                        type="object"
                        string="Students"
                        icon="fa-users"
                        title="View Enrolled Students"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_class_section_form" model="ir.ui.view">
        <field name="name">university.class.section.form</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <form string="Class Section">
                <header>
                    <button name="action_open_timetable_generation_wizard"
                            string="SCHEDULE TIMETABLE"
                            type="object"
                            class="oe_highlight"
                            groups="school_management.group_school_teacher,school_management.group_school_admin"/>
                    <button name="action_open_populate_class_wizard"
                            string="Populate Class"
                            type="object"
                            class="btn-secondary"
                            groups="school_management.group_school_teacher,school_management.group_school_admin"/>
                    <button name="action_open_bulk_enroll_wizard"
                            string="Enroll Multiple Students"
                            type="object"
                            class="btn-secondary"
                            groups="school_management.group_school_teacher,school_management.group_school_admin"/>
                    <button name="action_view_schedule"
                            string="View Interactive Schedule"
                            type="object"
                            class="btn-outline-primary"
                            icon="fa-calendar"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Full" bg_color="text-bg-warning" invisible="not is_full"/>
                    <field name="active" invisible="1"/>
                    <field name="is_full" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrolled_students"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="enrolled_student_count"/> / <field name="capacity"/>
                                </span>
                                <span class="o_stat_text">Enrolled (<field name="available_seats"/> Open)</span>
                            </div>
                        </button>
                        <button name="action_view_sessions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <div class="o_stat_info">
                                <field name="slot_count" widget="statinfo" string="Sessions"/>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Class / Section Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Mathematics" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Class Information">
                            <field name="curriculum_line_id" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}" optional="show"/>
                            <field name="program_id" string="Grade" placeholder="e.g. Grade 11"/>
                            <field name="year_level"/>
                            <field name="subject_id" string="Subject" domain="[('program_ids', 'in', [program_id])]"/>
                            <field name="teacher_id" string="Teacher" widget="many2one_avatar" domain="[('subject_ids', 'in', subject_id)]"/>
                            <field name="capacity" string="Total Capacity"/>
                            <field name="enrolled_student_count" string="Total Enrolled" readonly="1"/>
                            <field name="section_type" invisible="1"/>
                        </group>
                        <group string="Academic Session &amp; Schedule">
                            <field name="academic_year_id" string="Session" options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="semester_id" string="Semester"
                                   domain="[('academic_year_id', '=?', academic_year_id), ('active', '=', True)]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="term_id" string="Department Term"
                                   domain="[('semester_id', '=?', semester_id), ('department_id', '=?', department_id)]"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True}"/>
                            <field name="timeline" string="Timeline" readonly="1"/>
                            <field name="date_start" string="Start Date" invisible="not date_start and not date_end"/>
                            <field name="date_end" string="End Date" invisible="not date_start and not date_end"/>
                            <field name="classroom_id" string="Location"/>
                            <field name="capacity_used_percent" widget="progressbar"/>
                            <field name="day_summary" readonly="1"/>
                            <field name="time_summary" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Enrolled Students" name="students_tab">
                            <field name="enrollment_ids">
                                <list editable="bottom">
                                    <field name="student_id" options="{'no_create': True}"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-success="status == 'enrolled'"
                                           decoration-info="status == 'draft'"
                                           decoration-warning="status == 'dropped'"
                                           decoration-muted="status == 'completed'"/>
                                </list>
                                <form string="Enroll Student">
                                    <sheet>
                                        <group>
                                            <field name="student_id" options="{'no_create': True}"/>
                                            <field name="enrollment_date"/>
                                            <field name="status"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>

                        <page string="Weekly Schedule" name="weekly_schedule_tab">
                            <div class="alert alert-warning mb-2" role="alert" invisible="not schedule_warning">
                                <i class="fa fa-warning me-2" aria-hidden="true" title="Warning"/>
                                <field name="schedule_warning" readonly="1"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                <div class="d-flex gap-2">
                                    <button name="action_open_timetable_generation_wizard"
                                            string="SCHEDULE TIMETABLE"
                                            type="object"
                                            class="btn btn-primary btn-sm fw-bold"/>
                                    <button name="action_open_populate_class_wizard"
                                            string="Populate Class"
                                            type="object"
                                            class="btn btn-secondary btn-sm"/>
                                    <button name="action_view_schedule"
                                            string="Open Visual Calendar"
                                            type="object"
                                            class="btn btn-outline-primary btn-sm"
                                            icon="fa-calendar"/>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa fa-info-circle me-1"/> Weekly recurring session timetable
                                </div>
                            </div>
                            <field name="schedule_line_ids">
                                <list editable="bottom">
                                    <field name="weekday"/>
                                    <field name="timeslot_id"/>
                                    <field name="room_id"/>
                                    <field name="teacher_id"/>
                                    <field name="active" widget="boolean_toggle" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Assignment Type" name="assignments_tab">
                            <field name="assignment_ids" context="{'default_teacher_id': teacher_id, 'default_section_id': id, 'default_subject_id': subject_id}">
                                <list editable="bottom">
                                    <field name="name" string="Assignment Title"/>
                                    <field name="assignment_type" string="Type" widget="badge"/>
                                    <field name="category_id" string="Category"/>
                                    <field name="due_date" string="Due Date"/>
                                    <field name="max_score" string="Max Score"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'approved'"
                                           decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_class_section_search" model="ir.ui.view">
        <field name="name">university.class.section.search</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <search string="Search Class Sections">
                <field name="name" string="Class / Section"/>
                <field name="program_id" string="Major / Level"/>
                <field name="year_level"/>
                <field name="subject_id" string="Subject"/>
                <field name="teacher_id" string="Instructor"/>
                <field name="semester_id" string="Semester / Term"/>
                <field name="term_id" string="Department Term"/>
                <field name="classroom_id" string="Room"/>

                <separator/>
                <filter string="Classes With Spaces / Gaps"
                        name="filter_spaces"
                        domain="[('available_seats', '&gt;', 0)]"/>
                <filter string="Full Classes"
                        name="filter_full"
                        domain="[('is_full', '=', True)]"/>
                <filter string="Empty Classes"
                        name="filter_empty"
                        domain="[('enrolled_student_count', '=', 0)]"/>
                <separator/>
                <filter string="Cohort Sections"
                        name="filter_cohort"
                        domain="[('section_type', '=', 'cohort')]"/>
                <filter string="Course Sections"
                        name="filter_course"
                        domain="[('section_type', '=', 'course')]"/>
                <separator/>

                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Show Inactive" name="filter_inactive" domain="[('active', '=', False)]"/>

                <group>
                    <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                    <filter string="Department Term" name="group_by_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Major / Level" name="group_by_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Year Level" name="group_by_year_level" context="{'group_by': 'year_level'}"/>
                    <filter string="Instructor" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Format" name="group_by_section_type" context="{'group_by': 'section_type'}"/>
                    <filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Classroom" name="group_by_classroom" context="{'group_by': 'classroom_id'}"/>
                </group>

                <searchpanel>
                    <field name="semester_id" icon="fa-calendar" enable_counters="1"/>
                    <field name="program_id" icon="fa-graduation-cap" enable_counters="1"/>
                    <field name="teacher_id" icon="fa-user" enable_counters="1" select="multi"/>
                    <field name="section_type" icon="fa-filter" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_class_section_kanban" model="ir.ui.view">
        <field name="name">university.class.section.kanban</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="semester_id" quick_create="false">
                <field name="name"/>
                <field name="section_type"/>
                <field name="program_id"/>
                <field name="year_level"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <field name="term_id"/>
                <field name="classroom_id"/>
                <field name="capacity"/>
                <field name="enrolled_student_count"/>
                <field name="available_seats"/>
                <field name="capacity_used_percent"/>
                <field name="is_full"/>
                <field name="day_summary"/>
                <field name="time_summary"/>
                <templates>
                    <t t-name="card">
                        <main class="p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="fs-6 text-truncate" t-att-title="record.name.value">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <span t-if="record.is_full.raw_value" class="badge text-bg-danger">Full</span>
                                    <span t-if="!record.is_full.raw_value and record.available_seats.raw_value &gt; 0" class="badge text-bg-success">
                                        <field name="available_seats"/> Open
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex gap-1 mb-2">
                                <span class="badge text-bg-light border text-truncate">
                                    <i class="fa fa-tag me-1" title="Format"/>
                                    <field name="section_type"/>
                                </span>
                                <span t-if="record.day_summary.value" class="badge text-bg-info text-truncate">
                                    <i class="fa fa-clock-o me-1" title="Schedule"/>
                                    <field name="day_summary"/> <field name="time_summary"/>
                                </span>
                            </div>

                            <div class="text-muted small mt-1" t-if="record.program_id.value">
                                <i class="fa fa-graduation-cap me-1" title="Program / Level"/>
                                <field name="program_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.subject_id.value">
                                <i class="fa fa-book me-1" title="Subject"/>
                                <field name="subject_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.teacher_id.value">
                                <i class="fa fa-user me-1" title="Instructor"/>
                                <field name="teacher_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.classroom_id.value">
                                <i class="fa fa-building-o me-1" title="Room"/>
                                <field name="classroom_id"/>
                            </div>

                            <div class="mt-3 pt-2 border-top">
                                <div class="d-flex justify-content-between text-muted small mb-1">
                                    <span>
                                        <strong><field name="enrolled_student_count"/></strong> / <field name="capacity"/> Enrolled
                                    </span>
                                    <span class="fw-bold"><field name="capacity_used_percent"/>%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar"
                                         t-att-class="record.is_full.raw_value ? 'bg-danger' : (record.capacity_used_percent.raw_value &gt;= 80 ? 'bg-warning' : 'bg-success')"
                                         t-att-style="'width: ' + record.capacity_used_percent.raw_value + '%'"/>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3 pt-1">
                                <button name="action_view_schedule"
                                        type="object"
                                        class="btn btn-sm btn-outline-secondary"
                                        title="View Schedule">
                                    <i class="fa fa-calendar me-1"/>Schedule
                                </button>
                                <button name="action_view_enrolled_students"
                                        type="object"
                                        class="btn btn-sm btn-outline-primary"
                                        title="View Students">
                                    <i class="fa fa-users me-1"/>Students
                                </button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WINDOW ACTION FOR ADMIN CLASS LIST -->
    <record id="action_university_class_section" model="ir.actions.act_window">
        <field name="name">Class List</field>
        <field name="res_model">university.class.section</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_university_class_section_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Class Section!
            </p>
            <p>
                Manage class sections, schedule sessions, monitor enrolled students and track available seat capacity.
            </p>
        </field>
    </record>

    <!-- STUDENT ACTION: MY CLASSES -->
    <record id="action_university_class_section_student" model="ir.actions.act_window">
        <field name="name">My Classes</field>
        <field name="res_model">university.class.section</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_university_class_section_kanban"/>
        <field name="domain">[('enrollment_ids.student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="search_view_id" ref="view_university_class_section_search"/>
    </record>

</odoo>
