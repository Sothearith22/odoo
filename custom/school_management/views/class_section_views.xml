<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_university_class_section_list" model="ir.ui.view">
        <field name="name">university.class.section.list</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <list string="Class Sections" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="program_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <field name="classroom_id"/>
                <field name="capacity"/>
                <field name="enrolled_student_count"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_class_section_form" model="ir.ui.view">
        <field name="name">university.class.section.form</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <form string="Class Section">
                <header>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(school_management.action_university_enrollment)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-user-graduate"
                                context="{'search_default_section_id': id}">
                            <field name="enrolled_student_count" widget="statinfo" string="Enrolled Students"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Section Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. GM-Y1-A" required="1"/>
                        </h1>
                        <div class="text-muted">
                            <field name="semester_id" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Section Details">
                            <field name="program_id" string="Major / Program"/>
                            <field name="subject_id"
                                   domain="['|', ('program_ids', '=', False), ('program_ids', 'in', [program_id])]"/>
                            <field name="teacher_id" string="Instructor"/>
                            <field name="classroom_id"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity"/>
                            <field name="enrolled_student_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enrolled Students" name="students_tab">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="program_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status" widget="badge" decoration-success="status == 'enrolled'" decoration-info="status == 'completed'" decoration-danger="status == 'cancelled'" decoration-muted="status == 'draft'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_tab">
                            <group>
                                <field name="semester_id" readonly="1"/>
                                <field name="classroom_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_class_section_search" model="ir.ui.view">
        <field name="name">university.class.section.search</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <search string="Search Class Sections">
                <field name="name"/>
                <field name="program_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Program" name="group_by_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_class_section_kanban" model="ir.ui.view">
        <field name="name">university.class.section.kanban</field>
        <field name="model">university.class.section</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="subject_id" quick_create="false">
                <field name="name"/>
                <field name="program_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="semester_id"/>
                <field name="capacity"/>
                <field name="enrolled_student_count"/>
                <templates>
                    <t t-name="card">
                        <main class="ms-2 p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="fs-6 o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.program_id.value">
                                <i class="fa fa-graduation-cap me-1" title="Program"/>
                                <field name="program_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.subject_id.value">
                                <i class="fa fa-book me-1" title="Subject"/>
                                <field name="subject_id"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.teacher_id.value">
                                <i class="fa fa-user me-1" title="Instructor"/>
                                <field name="teacher_id"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-calendar me-1" title="Semester"/>
                                <field name="semester_id"/>
                            </div>
                            <div class="mt-2 text-muted small d-flex gap-3">
                                <span><field name="enrolled_student_count"/> / <field name="capacity"/> Enrolled</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_university_class_section" model="ir.actions.act_window">
        <field name="name">Class Sections</field>
        <field name="res_model">university.class.section</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_university_class_section_search"/>
    </record>

</odoo>
