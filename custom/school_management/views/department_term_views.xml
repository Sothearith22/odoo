<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_department_term_list" model="ir.ui.view">
        <field name="name">university.department.term.list</field>
        <field name="model">university.department.term</field>
        <field name="arch" type="xml">
            <list string="Department Terms" sample="1">
                <field name="semester_id"/>
                <field name="academic_year_id" optional="hide"/>
                <field name="faculty_id"/>
                <field name="department_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="registration_start" optional="hide"/>
                <field name="registration_end" optional="hide"/>
                <field name="add_drop_start" optional="hide"/>
                <field name="add_drop_end" optional="hide"/>
                <field name="grade_deadline" optional="hide"/>
                <field name="teaching_weeks" optional="hide"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'planned'"
                       decoration-success="state == 'running'"
                       decoration-muted="state == 'ended'"/>
            </list>
        </field>
    </record>

    <record id="view_university_department_term_form" model="ir.ui.view">
        <field name="name">university.department.term.form</field>
        <field name="model">university.department.term</field>
        <field name="arch" type="xml">
            <form string="Department Term">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="planned,running,ended"
                           readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Semester">
                            <field name="semester_id"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group string="Department">
                            <field name="faculty_id" readonly="1"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <group string="Schedule">
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="teaching_weeks" readonly="1"/>
                    </group>
                    <group string="Milestones">
                        <field name="registration_start"/>
                        <field name="registration_end"/>
                        <field name="add_drop_start"/>
                        <field name="add_drop_end"/>
                        <field name="grade_deadline"/>
                        <field name="change_reason" placeholder="Reason for extending a started term..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_university_department_term_search" model="ir.ui.view">
        <field name="name">university.department.term.search</field>
        <field name="model">university.department.term</field>
        <field name="arch" type="xml">
            <search string="Search Department Terms">
                <field name="semester_id"/>
                <field name="academic_year_id"/>
                <field name="faculty_id"/>
                <field name="department_id"/>
                <filter string="Planned" name="filter_planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Running" name="filter_running" domain="[('state', '=', 'running')]"/>
                <filter string="Ended" name="filter_ended" domain="[('state', '=', 'ended')]"/>
                <group>
                    <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Semester" name="group_by_semester" context="{'group_by': 'semester_id'}"/>
                    <filter string="Faculty" name="group_by_faculty" context="{'group_by': 'faculty_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="faculty_id" icon="fa-university" select="multi" enable_counters="1"/>
                    <field name="state" icon="fa-filter" select="multi" enable_counters="1" expand="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_university_department_term" model="ir.actions.act_window">
        <field name="name">Department Terms</field>
        <field name="res_model">university.department.term</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_university_department_term_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No department schedules found.</p>
            <p>Generate a department schedule from a semester, then adjust each department's dates as needed.</p>
        </field>
    </record>

    <record id="view_university_department_term_pivot" model="ir.ui.view">
        <field name="name">university.department.term.pivot</field>
        <field name="model">university.department.term</field>
        <field name="arch" type="xml">
            <pivot string="Department Terms">
                <field name="faculty_id" type="row"/>
                <field name="state" type="col"/>
                <field name="teaching_weeks" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_university_department_term_graph" model="ir.ui.view">
        <field name="name">university.department.term.graph</field>
        <field name="model">university.department.term</field>
        <field name="arch" type="xml">
            <graph string="Department Terms" type="bar">
                <field name="faculty_id"/>
                <field name="state"/>
                <field name="teaching_weeks" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_university_department_term_ending_soon" model="ir.actions.server">
        <field name="name">Ending Soon</field>
        <field name="model_id" ref="model_university_department_term"/>
        <field name="state">code</field>
        <field name="code">action = model.action_ending_soon()</field>
    </record>
</odoo>
