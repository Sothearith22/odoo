<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_lesson_plan_tree" model="ir.ui.view">
        <field name="name">university.lesson.plan.tree</field>
        <field name="model">university.lesson.plan</field>
        <field name="arch" type="xml">
            <list string="Lesson Plans">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="section_id"/>
                <field name="teacher_id"/>
                <field name="assignment_count" string="Assignments" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'draft'"/>
                <button name="action_view_assignments" type="object" string="Assignments" icon="fa-tasks"/>
            </list>
        </field>
    </record>

    <record id="view_university_lesson_plan_form" model="ir.ui.view">
        <field name="name">university.lesson.plan.form</field>
        <field name="model">university.lesson.plan</field>
        <field name="arch" type="xml">
            <form string="Lesson Plan">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state == 'approved'"/>
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <button name="action_view_assignments" type="object" string="Assignments" class="btn-secondary" icon="fa-tasks"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lesson Plan Title"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="section_id" string="Grade"/>
                            <field name="subject_id"/>
                            <field name="share_to" widget="radio"/>
                        </group>
                        <group>
                            <field name="teacher_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lesson Plan" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_university_lesson_plan_search" model="ir.ui.view">
        <field name="name">university.lesson.plan.search</field>
        <field name="model">university.lesson.plan</field>
        <field name="arch" type="xml">
            <search string="Search Lesson Plans">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="section_id"/>
                <field name="teacher_id"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <searchpanel>
                    <field name="subject_id" icon="fa-book" enable_counters="1"/>
                    <field name="state" icon="fa-filter" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_university_lesson_plan" model="ir.actions.act_window">
        <field name="name">Lesson Plans</field>
        <field name="res_model">university.lesson.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_university_lesson_plan_search"/>
    </record>
</odoo>
