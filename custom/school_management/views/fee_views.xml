<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_university_fee_structure_list" model="ir.ui.view">
        <field name="name">university.fee.structure.list</field>
        <field name="model">university.fee.structure</field>
        <field name="arch" type="xml">
            <list string="Fee Structures">
                <field name="name"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <field name="semester_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_university_fee_structure_form" model="ir.ui.view">
        <field name="name">university.fee.structure.form</field>
        <field name="model">university.fee.structure</field>
        <field name="arch" type="xml">
            <form string="Fee Structure">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Year 1 Admission Fees"/></h1>
                    </div>
                    <group>
                        <field name="program_id"/>
                        <field name="academic_year_id"/>
                        <field name="semester_id"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="fee_type" widget="badge"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="discount_type"/>
                            <field name="discount"/>
                            <field name="discount_amount"/>
                            <field name="amount" string="Subtotal"/>
                            <field name="total_amount" string="Total" sum="Total"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="total_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_fee_structure" model="ir.actions.act_window">
        <field name="name">Fee Structures</field>
        <field name="res_model">university.fee.structure</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LIST VIEW -->
    <record id="view_university_fee_list" model="ir.ui.view">
        <field name="name">university.fee.list</field>
        <field name="model">university.fee</field>
        <field name="arch" type="xml">
            <list string="Fee Invoices" multi_edit="1">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_structure_id" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="due_date" optional="hide"/>
                <field name="total_amount" sum="Total" widget="monetary"/>
                <field name="paid_amount" sum="Paid" widget="monetary"/>
                <field name="balance" widget="monetary"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'posted'"
                       decoration-danger="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_fee_form" model="ir.ui.view">
        <field name="name">university.fee.form</field>
        <field name="model">university.fee</field>
        <field name="arch" type="xml">
            <form string="Fee Invoice">
                <header>
                    <button name="action_post" string="Confirm Invoice" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_request_signature" string="Request Signature" type="object" invisible="state != 'posted'" class="oe_highlight" groups="base.group_system,school_management.group_school_admin"/>
                    <button name="action_print_receipt" string="Print Receipt" type="object" invisible="state != 'paid'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'canceled'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'canceled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,paid,canceled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_student" type="object" class="oe_stat_button" icon="fa-user-graduate">
                            <field name="student_id" widget="statinfo" string="Student"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-credit-card">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button name="action_view_signatures" type="object" class="oe_stat_button" icon="fa-pencil-square-o" groups="base.group_system,school_management.group_school_admin">
                            <field name="signature_count" widget="statinfo" string="Signatures"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="fee_structure_id" readonly="state != 'draft'"/>
                            <field name="admission_application_id" readonly="state != 'draft'"/>
                            <field name="academic_year_id" readonly="state != 'draft'"/>
                            <field name="semester_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="due_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details_tab">
                            <group string="Invoice Summary">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_amount" widget="monetary" readonly="1"/>
                                <field name="paid_amount" widget="monetary" readonly="1"/>
                                <field name="balance" widget="monetary" readonly="1"/>
                            </group>
                            <group string="Additional Information" groups="school_management.group_school_admin">
                                <field name="fee_structure_id" readonly="1"/>
                                <field name="admission_application_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Lines" name="lines_tab">
                            <field name="line_ids" readonly="state in ('posted', 'paid', 'canceled')">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="fee_type" widget="badge" decoration-info="fee_type == 'tuition'" decoration-warning="fee_type == 'lab'" decoration-success="fee_type == 'library'"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="discount_type"/>
                                    <field name="discount"/>
                                    <field name="discount_amount" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="amount" string="Subtotal" widget="monetary"/>
                                    <field name="total_amount" string="Total" sum="Total" widget="monetary"/>
                                    <field name="due_date"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="currency_id" invisible="1"/>
                                <field name="total_amount" widget="monetary"/>
                                <field name="paid_amount" widget="monetary"/>
                                <field name="balance" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Payments" name="payments_tab">
                            <field name="payment_ids" readonly="state in ('paid', 'canceled')">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="payment_method"/>
                                    <field name="amount" sum="Total Payments" widget="monetary"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-danger="state == 'canceled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes_tab">
                            <field name="notes" nolabel="1" placeholder="Add notes about this fee invoice..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_fee_search" model="ir.ui.view">
        <field name="name">university.fee.search</field>
        <field name="model">university.fee</field>
        <field name="arch" type="xml">
            <search string="Fee Invoice Search">
                <field name="name" string="Invoice Number"/>
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="semester_id"/>
                <field name="state"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_posted" string="Posted" domain="[('state', '=', 'posted')]"/>
                <filter name="filter_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_canceled" string="Canceled" domain="[('state', '=', 'canceled')]"/>
                <separator/>
                <filter name="filter_unpaid" string="Unpaid / Outstanding" domain="[('state', 'in', ('draft', 'posted'))]"/>
                <separator/>
                <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_by_student" string="Student" context="{'group_by': 'student_id'}"/>
                <filter name="group_by_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                <filter name="group_by_semester" string="Semester" context="{'group_by': 'semester_id'}"/>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_fee_kanban" model="ir.ui.view">
        <field name="name">university.fee.kanban</field>
        <field name="model">university.fee</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="student_id"/>
                <field name="total_amount"/>
                <field name="paid_amount"/>
                <field name="balance"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <main class="ms-2 p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="fs-6 o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-user me-1" title="Student"/>
                                <field name="student_id"/>
                            </div>
                            <div class="mt-2 text-muted small">
                                <span>Total: <field name="total_amount"/></span>
                            </div>
                            <div class="mt-2">
                                <span t-if="record.state.raw_value == 'paid'" class="badge text-bg-success">Paid</span>
                                <span t-if="record.state.raw_value == 'posted'" class="badge text-bg-warning">Posted</span>
                                <span t-if="record.state.raw_value == 'draft'" class="badge text-bg-info">Draft</span>
                                <span t-if="record.state.raw_value == 'canceled'" class="badge text-bg-danger">Canceled</span>
                                <span class="badge text-bg-secondary float-end">Balance: <field name="balance"/></span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_university_fee" model="ir.actions.act_window">
        <field name="name">Fee Invoices</field>
        <field name="res_model">university.fee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first fee invoice!
            </p>
        </field>
    </record>

    <record id="action_university_fee_student" model="ir.actions.act_window">
        <field name="name">My Fees</field>
        <field name="res_model">university.fee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

</odoo>
