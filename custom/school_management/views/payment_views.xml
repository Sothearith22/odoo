<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_university_payment_list" model="ir.ui.view">
        <field name="name">university.payment.list</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <list string="Payments" multi_edit="1">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_id" optional="hide"/>
                <field name="date" optional="show"/>
                <field name="payment_method"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-danger="state == 'canceled'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_payment_form" model="ir.ui.view">
        <field name="name">university.payment.form</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <header>
                    <button name="action_post" string="Confirm Payment" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_print_receipt" string="Print Receipt" type="object" invisible="state != 'posted'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'canceled'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'canceled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Payment Details">
                            <field name="student_id" readonly="state != 'draft'"/>
                            <field name="fee_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                        </group>
                        <group string="Processing">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="payment_method" readonly="state != 'draft'"/>
                            <field name="reference" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_payment_search" model="ir.ui.view">
        <field name="name">university.payment.search</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <group>
                    <filter string="Student" name="student" context="{'group_by': 'student_id'}"/>
                    <filter string="Payment Method" name="method" context="{'group_by': 'payment_method'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_payment_kanban" model="ir.ui.view">
        <field name="name">university.payment.kanban</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="state" quick_create="false">
                <field name="name"/>
                <field name="student_id"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="date"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <main class="ms-2 p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="fs-6 o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-user me-1" title="Student"/>
                                <field name="student_id"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-credit-card me-1" title="Payment Method"/>
                                <field name="payment_method"/>
                            </div>
                            <div class="text-muted small mt-1" t-if="record.date.value">
                                <i class="fa fa-calendar me-1" title="Payment Date"/>
                                <field name="date"/>
                            </div>
                            <div class="mt-2">
                                <span class="badge text-bg-primary"><field name="amount"/></span>
                                <span t-if="record.state.raw_value == 'posted'" class="badge text-bg-success float-end">Posted</span>
                                <span t-if="record.state.raw_value == 'draft'" class="badge text-bg-info float-end">Draft</span>
                                <span t-if="record.state.raw_value == 'canceled'" class="badge text-bg-danger float-end">Canceled</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_university_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">university.payment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first payment record!
            </p>
        </field>
    </record>

    <record id="action_university_payment_student" model="ir.actions.act_window">
        <field name="name">My Payments</field>
        <field name="res_model">university.payment</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

</odoo>