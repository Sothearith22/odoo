<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_university_payment_list" model="ir.ui.view">
        <field name="name">university.payment.list</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <list string="Payments">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_id"/>
                <field name="date"/>
                <field name="payment_method"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_payment_form" model="ir.ui.view">
        <field name="name">university.payment.form</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <header>
                    <button name="action_post" string="Confirm" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_print_receipt" string="Print Receipt" type="object" invisible="state != 'posted'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'canceled'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'canceled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="fee_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="payment_method"/>
                            <field name="reference"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_payment_search" model="ir.ui.view">
        <field name="name">university.payment.search</field>
        <field name="model">university.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="posted" domain="[('state', '=', 'posted')]"/>
                <group>
                    <filter string="Student" name="student" context="{'group_by': 'student_id'}"/>
                    <filter string="Payment Method" name="method" context="{'group_by': 'payment_method'}"/>
                    <filter string="Status" name="status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_university_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">university.payment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first payment record!
            </p>
        </field>
    </record>

</odoo>
