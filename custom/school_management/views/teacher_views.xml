<?xml version="1.0" encoding="utf-8"?>
<!--
    Academic Staff (Teacher) Views

    Includes the upgraded Teacher list / form, plus dedicated Deans and
    Heads of Department list views that reuse the same staff model (no
    duplicate person records).
-->
<odoo>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="view_university_teacher_list" model="ir.ui.view">
        <field name="name">university.teacher.list</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers" sample="1">
                <field name="image_1920" widget="image" options="{'size': [32, 32]}" string="Photo"/>
                <field name="teacher_id" decoration-bf="1"/>
                <field name="name" decoration-bf="1"/>
                <field name="position" widget="badge" optional="hide"/>
                <field name="faculty_id"/>
                <field name="department_id"/>
                <field name="parent_id" string="Manager" optional="hide"/>
                <field name="specialization" optional="show"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="status" widget="badge" decoration-muted="status == 'draft'" decoration-success="status == 'active'" decoration-danger="status == 'inactive'"/>
                <field name="is_dean" widget="badge" decoration-info="is_dean" string="Head of Faculty"/>
                <field name="is_hod" widget="badge" decoration-success="is_hod" string="HOD"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="view_university_teacher_kanban" model="ir.ui.view">
        <field name="name">university.teacher.kanban</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="image_1920"/>
                <field name="department_id"/>
                <field name="position"/>
                <field name="email"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full o_kanban_image_fill">
                            <field name="image_1920" widget="image" class="d-block w-100 h-100 object-fit-cover"/>
                        </aside>
                        <main class="ms-2">
                            <strong class="fs-5"><field name="name"/></strong>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-id-badge me-1" title="Teacher ID"/>
                                <field name="teacher_id"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-building me-1" title="Department"/>
                                <field name="department_id"/>
                            </div>
                            <div class="text-muted small" t-if="record.position.value">
                                <i class="fa fa-graduation-cap me-1" title="Position"/>
                                <field name="position"/>
                            </div>
                            <div class="text-muted small">
                                <i class="fa fa-envelope me-1" title="Email"/>
                                <field name="email"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_university_teacher_form" model="ir.ui.view">
        <field name="name">university.teacher.form</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <form string="Academic Staff">
                <header>
                    <button name="action_create_user"
                            string="Create User"
                            type="object"
                            class="oe_highlight"
                            icon="fa-user-plus"
                            groups="school_management.group_school_admin"
                            invisible="user_id != False"/>
                    <button name="action_reset_password"
                            string="Reset Password"
                            type="object"
                            class="btn-secondary"
                            icon="fa-key"
                            groups="school_management.group_school_admin"
                            invisible="user_id == False"/>
                    <button name="%(school_management.action_university_teacher_account_wizard)d"
                            string="Advanced User Creation"
                            type="action"
                            class="btn-link"
                            groups="school_management.group_school_admin"
                            invisible="user_id != False"
                            context="{'default_teacher_ids': [(6, 0, [id])]}"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,active,inactive"
                           groups="school_management.group_school_user"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sections"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users">
                            <field name="section_count" widget="statinfo" string="Class Sections"/>
                        </button>
                        <button name="action_view_assignments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                        <button name="action_view_attendance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar-check-o">
                            <field name="attendance_count" widget="statinfo" string="Attendance"/>
                        </button>
                        <button name="action_view_timetable"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="timetable_count" widget="statinfo" string="Timetable"/>
                        </button>
                        <button type="object" class="oe_stat_button" icon="fa-book">
                            <field name="subject_count" widget="statinfo" string="Subjects"/>
                        </button>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name" string="Full Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Dr. John Doe" required="1"/>
                        </h1>
                        <div class="text-muted">
                            <i class="fa fa-id-badge me-1" title="Teacher ID"/>
                            <field name="teacher_id" placeholder="e.g. TCH-001"/>
                        </div>
                    </div>

                    <notebook>
                        <page string="Personal Information" name="personal_tab">
                            <group>
                                <group string="Identity">
                                    <field name="gender" widget="radio" options="{'horizontal': true}"/>
                                    <field name="date_of_birth"/>
                                </group>
                                <group string="Contact Information">
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="address"/>
                                </group>
                                <group string="System Access" groups="school_management.group_school_admin">
                                    <field name="user_id" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Employment Information" name="employment_tab">
                            <group>
                                <group string="Academic Position">
                                    <field name="position"/>
                                    <field name="specialization"/>
                                    <field name="qualification"/>
                                    <field name="hire_date"/>
                                </group>
                                <group string="Department &amp; Faculty">
                                    <field name="department_id" readonly="status == 'active'"/>
                                    <field name="faculty_id" readonly="1"/>
                                    <field name="parent_id" domain="[('id', '!=', id)]"/>
                                </group>
                                <group string="Administrative Roles" groups="school_management.group_school_admin">
                                    <field name="is_dean" readonly="1"/>
                                    <field name="is_hod" readonly="1"/>
                                    <field name="managed_faculty_id" readonly="1" invisible="not is_dean"/>
                                    <field name="managed_department_id" readonly="1" invisible="not is_hod"/>
                                </group>
                            </group>
                        </page>

                        <page string="Teaching Information" name="teaching_tab">
                            <group string="Subjects Taught">
                                <field name="subject_ids"
                                       domain="['&amp;', ('department_id', '=', department_id), '|', ('teacher_id', '=', False), ('teacher_id', '=', id)]">
                                    <list>
                                        <field name="code"/>
                                        <field name="name"/>
                                        <field name="program_ids" widget="many2many_tags"/>
                                        <field name="credits"/>
                                        <field name="teacher_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </group>
                            <separator string="Class Sections"/>
                            <field name="section_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="subject_id"/>
                                    <field name="semester_id"/>
                                    <field name="classroom_id"/>
                                    <field name="capacity"/>
                                </list>
                            </field>
                        </page>

                        <page string="Teaching Assignments" name="assignments_tab">
                            <field name="assignment_ids_teaching">
                                <list>
                                    <field name="name"/>
                                    <field name="subject_id"/>
                                    <field name="section_id"/>
                                    <field name="due_date"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Lesson Plans" name="lesson_plans_tab">
                            <field name="lesson_plan_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="subject_id"/>
                                    <field name="section_id"/>
                                    <field name="share_to"/>
                                    <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Internal Notes" name="notes_tab">
                            <group>
                                <field name="assignment_ids" readonly="1" string="Role Appointments">
                                    <list>
                                        <field name="name"/>
                                        <field name="role" widget="badge"/>
                                        <field name="faculty_id"/>
                                        <field name="department_id"/>
                                        <field name="start_date"/>
                                        <field name="end_date"/>
                                        <field name="active" widget="boolean_toggle"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_university_teacher_search" model="ir.ui.view">
        <field name="name">university.teacher.search</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <search string="Teacher Search">
                <field name="name" string="Teacher Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="department_id"/>
                <field name="faculty_id"/>
                <field name="position"/>
                <field name="qualification"/>
                <field name="gender"/>
                <field name="status"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_is_dean" string="Dean" domain="[('is_dean', '=', True)]"/>
                <filter name="filter_is_hod" string="Head of Department" domain="[('is_hod', '=', True)]"/>
                <separator/>
                <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                <filter name="group_by_faculty" string="Faculty" context="{'group_by': 'faculty_id'}"/>
                <filter name="group_by_position" string="Position" context="{'group_by': 'position'}"/>
                <filter name="group_by_gender" string="Gender" context="{'group_by': 'gender'}"/>
                <filter name="group_by_qualification" string="Qualification" context="{'group_by': 'qualification'}"/>
            </search>
        </field>
    </record>

    <record id="view_university_teacher_hierarchy" model="ir.ui.view">
        <field name="name">university.teacher.hierarchy</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" draggable="1" icon="fa-users">
                <field name="child_ids" invisible="1"/>
                <field name="name"/>
                <field name="teacher_id"/>
                <field name="image_1920"/>
                <field name="position"/>
                <field name="department_id"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="o_hierarchy_node_header d-flex justify-content-center align-items-center">
                            <field name="image_1920" widget="image" class="rounded-circle" options="{'size': [64, 64]}"/>
                        </div>
                        <div class="d-flex flex-column text-center">
                            <field name="name" class="fw-bold"/>
                            <field name="position"/>
                            <field name="department_id" class="text-muted"/>
                            <field name="teacher_id" class="text-muted"/>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <!-- ==================== WINDOW ACTION ==================== -->
    <record id="action_university_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">university.teacher</field>
        <field name="view_mode">kanban,list,form,hierarchy</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="search_view_id" ref="view_university_teacher_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first teacher record</p>
            <p>Add academic staff and assign them to departments, positions, subjects, and class sections.</p>
        </field>
    </record>

    <record id="action_university_teacher_hierarchy_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="15"/>
        <field name="view_mode">hierarchy</field>
        <field name="view_id" ref="view_university_teacher_hierarchy"/>
        <field name="act_window_id" ref="action_university_teacher"/>
    </record>

    <record id="action_university_teacher_hierarchy" model="ir.actions.act_window">
        <field name="name">Teacher Hierarchy</field>
        <field name="res_model">university.teacher</field>
        <field name="view_mode">hierarchy</field>
        <field name="view_id" ref="view_university_teacher_hierarchy"/>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up the teacher hierarchy</p>
            <p>Assign a Manager on each teacher record to build the reporting structure.</p>
        </field>
    </record>

    <!-- ==================== DEANS LIST VIEW ==================== -->
    <record id="view_university_dean_list" model="ir.ui.view">
        <field name="name">university.dean.list</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <list string="Heads of Faculty" sample="1">
                <field name="image_1920" widget="image" options="{'size': [40, 40]}" string="Photo"/>
                <field name="name" decoration-bf="1"/>
                <field name="position"/>
                <field name="managed_faculty_id" string="Faculty"/>
                <field name="dean_appointment_start" string="Appointment Start"/>
                <field name="dean_appointment_end" string="Appointment End"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="active" widget="boolean_toggle" decoration-info="active" string="Status"/>
            </list>
        </field>
    </record>

    <!-- ==================== DEANS SEARCH VIEW ==================== -->
    <record id="view_university_dean_search" model="ir.ui.view">
        <field name="name">university.dean.search</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <search string="Search Heads of Faculty">
                <field name="name"/>
                <field name="managed_faculty_id" string="Faculty"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Faculty" name="group_by_faculty" context="{'group_by': 'managed_faculty_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== DEANS WINDOW ACTION ==================== -->
    <record id="action_university_dean" model="ir.actions.act_window">
        <field name="name">Heads of Faculty</field>
        <field name="res_model">university.teacher</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_dean', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="search_view_id" ref="view_university_dean_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No heads of faculty assigned</p>
            <p>Heads of faculty are academic staff members with an active Head of Faculty appointment.</p>
        </field>
    </record>

    <!-- ==================== HOD LIST VIEW ==================== -->
    <record id="view_university_hod_list" model="ir.ui.view">
        <field name="name">university.hod.list</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <list string="Heads of Department" sample="1">
                <field name="image_1920" widget="image" options="{'size': [40, 40]}" string="Photo"/>
                <field name="name" decoration-bf="1"/>
                <field name="position"/>
                <field name="managed_department_id" string="Department"/>
                <field name="faculty_id" string="Faculty"/>
                <field name="hod_appointment_start" string="Start Date"/>
                <field name="hod_appointment_end" string="End Date"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="active" widget="boolean_toggle" decoration-info="active" string="Status"/>
            </list>
        </field>
    </record>

    <!-- ==================== HOD SEARCH VIEW ==================== -->
    <record id="view_university_hod_search" model="ir.ui.view">
        <field name="name">university.hod.search</field>
        <field name="model">university.teacher</field>
        <field name="arch" type="xml">
            <search string="Search Heads of Department">
                <field name="name"/>
                <field name="managed_department_id" string="Department"/>
                <field name="faculty_id" string="Faculty"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Faculty" name="group_by_faculty" context="{'group_by': 'faculty_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'managed_department_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== HOD WINDOW ACTION ==================== -->
    <record id="action_university_hod" model="ir.actions.act_window">
        <field name="name">Heads of Department</field>
        <field name="res_model">university.teacher</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_hod', '=', True)]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="search_view_id" ref="view_university_hod_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No heads of department assigned</p>
            <p>Heads of Department are academic staff members with an active HOD appointment.</p>
        </field>
    </record>

    <!-- ==================== TEACHER PROFILE WINDOW ACTION ==================== -->
    <record id="action_university_teacher_profile" model="ir.actions.act_window">
        <field name="name">My Profile</field>
        <field name="res_model">university.teacher</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'delete': False, 'search_default_filter_active': 1}</field>
        <field name="search_view_id" ref="view_university_teacher_search"/>
    </record>

</odoo>