<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_grade_scale_list" model="ir.ui.view">
        <field name="name">university.grade.scale.list</field>
        <field name="model">university.grade.scale</field>
        <field name="arch" type="xml">
            <list string="Grade Scales">
                <field name="name"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_university_grade_scale_form" model="ir.ui.view">
        <field name="name">university.grade.scale.form</field>
        <field name="model">university.grade.scale</field>
        <field name="arch" type="xml">
            <form string="Grade Scale">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="min_score"/>
                            <field name="max_score"/>
                            <field name="grade_point"/>
                            <field name="is_passing"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_grade_scale" model="ir.actions.act_window">
        <field name="name">Grade Scales</field>
        <field name="res_model">university.grade.scale</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_university_assessment_category_list" model="ir.ui.view">
        <field name="name">university.assessment.category.list</field>
        <field name="model">university.assessment.category</field>
        <field name="arch" type="xml">
            <list string="Assessment Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="weight"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_university_assessment_category_form" model="ir.ui.view">
        <field name="name">university.assessment.category.form</field>
        <field name="model">university.assessment.category</field>
        <field name="arch" type="xml">
            <form string="Assessment Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="weight"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_assessment_category" model="ir.actions.act_window">
        <field name="name">Assessment Categories</field>
        <field name="res_model">university.assessment.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_university_assessment_result_list" model="ir.ui.view">
        <field name="name">university.assessment.result.list</field>
        <field name="model">university.assessment.result</field>
        <field name="arch" type="xml">
            <list string="Assessment Results">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="section_id"/>
                <field name="teacher_id"/>
                <field name="category_id"/>
                <field name="score"/>
                <field name="max_score"/>
                <field name="percentage"/>
                <field name="weighted_score"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_university_assessment_result_form" model="ir.ui.view">
        <field name="name">university.assessment.result.form</field>
        <field name="model">university.assessment.result</field>
        <field name="arch" type="xml">
            <form string="Assessment Result">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="oe_highlight" invisible="state == 'published'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="section_id"/>
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="semester_id"/>
                            <field name="category_id"/>
                            <field name="assignment_id"/>
                            <field name="submission_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="score"/>
                        <field name="max_score"/>
                        <field name="percentage"/>
                        <field name="weighted_score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_assessment_result" model="ir.actions.act_window">
        <field name="name">Assessment Results</field>
        <field name="res_model">university.assessment.result</field>
        <field name="view_mode">list,form</field>
    </record>



    <record id="action_university_assessment_result_student" model="ir.actions.act_window">
        <field name="name">My Results</field>
        <field name="res_model">university.assessment.result</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <record id="view_university_report_card_list" model="ir.ui.view">
        <field name="name">university.report.card.list</field>
        <field name="model">university.report.card</field>
        <field name="arch" type="xml">
            <list string="Report Cards">
                <field name="name"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <field name="semester_id"/>
                <field name="gpa"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-warning="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="view_university_report_card_form" model="ir.ui.view">
        <field name="name">university.report.card.form</field>
        <field name="model">university.report.card</field>
        <field name="arch" type="xml">
            <form string="Report Card">
                <header>
                    <button name="action_generate_lines" type="object" string="Generate Lines" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state == 'approved'"/>
                    <button name="action_print_report_card" type="object" string="Print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="program_id"/>
                            <field name="academic_year_id"/>
                            <field name="semester_id"/>
                        </group>
                        <group>
                            <field name="grade_scale_id"/>
                            <field name="total_credits"/>
                            <field name="gpa"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="subject_id"/>
                            <field name="credits"/>
                            <field name="final_score"/>
                            <field name="grade"/>
                            <field name="grade_point"/>
                            <field name="is_passing"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_report_card" model="ir.actions.act_window">
        <field name="name">Report Cards</field>
        <field name="res_model">university.report.card</field>
        <field name="view_mode">list,form</field>
    </record>



    <record id="action_university_report_card_student" model="ir.actions.act_window">
        <field name="name">My Report Cards</field>
        <field name="res_model">university.report.card</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <record id="view_university_transcript_list" model="ir.ui.view">
        <field name="name">university.transcript.list</field>
        <field name="model">university.transcript</field>
        <field name="arch" type="xml">
            <list string="Transcripts">
                <field name="name"/>
                <field name="student_id"/>
                <field name="program_id"/>
                <field name="total_credits"/>
                <field name="cumulative_gpa"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-warning="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="view_university_transcript_form" model="ir.ui.view">
        <field name="name">university.transcript.form</field>
        <field name="model">university.transcript</field>
        <field name="arch" type="xml">
            <form string="Transcript">
                <header>
                    <button name="action_generate_lines" type="object" string="Generate Lines" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state == 'approved'"/>
                    <button name="action_print_transcript" type="object" string="Print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated,approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="program_id"/>
                        <field name="total_credits"/>
                        <field name="cumulative_gpa"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="academic_year_id"/>
                            <field name="semester_id"/>
                            <field name="subject_id"/>
                            <field name="credits"/>
                            <field name="final_score"/>
                            <field name="grade"/>
                            <field name="grade_point"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_transcript" model="ir.actions.act_window">
        <field name="name">Transcripts</field>
        <field name="res_model">university.transcript</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="action_university_transcript_student" model="ir.actions.act_window">
        <field name="name">My Transcript</field>
        <field name="res_model">university.transcript</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('student_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
