<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_notice_board_list" model="ir.ui.view">
        <field name="name">university.notice.board.list</field>
        <field name="model">university.notice.board</field>
        <field name="arch" type="xml">
            <list string="Notice Board" sample="1">
                <field name="date"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_university_notice_board_form" model="ir.ui.view">
        <field name="name">university.notice.board.form</field>
        <field name="model">university.notice.board</field>
        <field name="arch" type="xml">
            <form string="Campus Notice">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Notice Title"/>
                        <h1>
                            <field name="name" placeholder="e.g., Midterm Exam Schedule Released"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notice Content" name="content">
                            <field name="content" options="{'collaborative': false}" placeholder="Enter notice announcement details here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_university_notice_board_search" model="ir.ui.view">
        <field name="name">university.notice.board.search</field>
        <field name="model">university.notice.board</field>
        <field name="arch" type="xml">
            <search string="Search Notices">
                <field name="name" string="Title / Content"/>
                <field name="date"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_university_notice_board" model="ir.actions.act_window">
        <field name="name">Campus Notice Board</field>
        <field name="res_model">university.notice.board</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_university_notice_board_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No campus notices posted yet.</p>
            <p>Post announcements and campus updates for students and faculty.</p>
        </field>
    </record>
</odoo>
