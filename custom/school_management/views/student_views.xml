<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="view_university_student_list" model="ir.ui.view">
        <field name="name">university.student.list</field>
        <field name="model">university.student</field>
        <field name="arch" type="xml">
            <list string="Students" sample="1">
                <header>
                    <button name="%(school_management.action_university_bulk_enrollment_wizard)d"
                            string="Enroll Students"
                            type="action"
                            class="btn-primary"
                            icon="fa-graduation-cap"/>
                </header>
                <field name="image_1920" widget="image" options="{'size': [32, 32]}" string="Photo"/>
                <field name="student_id" decoration-bf="1"/>
                <field name="name" decoration-bf="1"/>
                <field name="program_id"/>
                <field name="faculty_id"/>
                <field name="department_id"/>
                <field name="academic_year_id"/>
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'suspended'" decoration-info="status == 'graduated'" decoration-danger="status == 'dropped'"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="view_university_student_kanban" model="ir.ui.view">
        <field name="name">university.student.kanban</field>
        <field name="model">university.student</field>
        <field name="arch" type="xml">
            <kanban class="o_university_student_kanban" sample="1">
                <field name="name"/>
                <field name="student_id"/>
                <field name="faculty_id"/>
                <field name="image_1920"/>
                <field name="program_id"/>
                <field name="status"/>
                <templates>
                    <t t-name="card" class="o_university_kanban_card">
                        <main class="p-3">
                            <div class="o_kcard_head">
                                <t t-if="record.image_1920.raw_value">
                                    <img t-att-src="'/web/image/university.student/' + record.id.value + '/image_128'"
                                         class="o_kcard_avatar"
                                         alt="Student photo"/>
                                </t>
                                <t t-else="">
                                    <div class="o_kcard_avatar o_kcard_avatar_placeholder">
                                        <i class="fa fa-user" aria-hidden="true"/>
                                    </div>
                                </t>
                                <div class="o_kcard_title">
                                    <span class="o_kcard_name text-truncate" title="Open this student"><field name="name"/></span>
                                    <span class="o_kcard_id">
                                        <i class="fa fa-id-card me-1" aria-hidden="true"/>
                                        <field name="student_id"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kcard_meta" t-if="record.program_id.value">
                                <i class="fa fa-graduation-cap" aria-hidden="true"/>
                                <span><field name="program_id"/></span>
                            </div>
                            <div class="o_kcard_status">
                                <span class="o_kstatus" t-att-class="'o_kstatus_' + (record.status.raw_value || 'none')">
                                    <span class="o_kstatus_dot" aria-hidden="true"/>
                                    <span class="o_kstatus_label" t-esc="record.status.value"/>
                                </span>
                            </div>
                        </main>
                        <footer class="o_kanban_footer o_kcard_footer d-flex justify-content-between align-items-center">
                            <span class="o_kcard_footer_meta text-truncate" t-if="record.faculty_id.value">
                                <i class="fa fa-building me-1" aria-hidden="true"/>
                                <field name="faculty_id"/>
                            </span>
                            <span class="o_kcard_open text-truncate">Open <i class="fa fa-arrow-right ms-1" aria-hidden="true"/></span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_university_student_form" model="ir.ui.view">
        <field name="name">university.student.form</field>
        <field name="model">university.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_create_user"
                            string="Create Login Account"
                            type="object"
                            class="oe_highlight"
                            icon="fa-user-plus"
                            groups="school_management.group_school_admin"
                            invisible="user_id != False"/>
                    <button name="action_reset_password"
                            string="Reset Password"
                            type="object"
                            class="btn-secondary"
                            icon="fa-key"
                            groups="school_management.group_school_admin"
                            invisible="user_id == False"/>
                    <button name="action_open_enrollment_registration"
                            string="Enroll in Classes"
                            type="object"
                            class="btn-secondary"
                            icon="fa-graduation-cap"
                            groups="school_management.group_school_admin"/>
                    <button name="action_continue_student"
                            string="Continue Student"
                            type="object"
                            class="oe_highlight"
                            icon="fa-play-circle"
                            groups="school_management.group_school_admin"
                            invisible="status != 'dropped' and active"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="active,suspended,graduated,dropped"
                           groups="school_management.group_school_admin"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name" string="Student Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sothearith Kim" required="1"/>
                        </h1>
<div class="text-muted">
                        <i class="fa fa-id-card me-1" title="Student ID"/>
                        <field name="student_id" placeholder="e.g. STD-2026-001"/>
                    </div>
                    <div groups="!school_management.group_school_admin">
                        <field name="status"
                               widget="badge"
                               decoration-success="status == 'active'"
                               decoration-warning="status == 'suspended'"
                               decoration-info="status == 'graduated'"
                               decoration-danger="status == 'dropped'"/>
                    </div>
                </div>

                    <group string="Student Snapshot">
                        <group string="Academic Placement">
                            <field name="program_id"/>
                            <field name="department_id"/>
                            <field name="faculty_id"/>
                            <field name="academic_year_id"/>
                            <field name="current_semester_id"/>
                        </group>
                        <group string="Contact">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone" widget="phone"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Personal Details" name="personal_details_tab">
                            <group>
                                <group string="Identity">
                                    <field name="gender" widget="radio" options="{'horizontal': true}"/>
                                    <field name="date_of_birth"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </group>
                                <group string="System Access" groups="school_management.group_school_admin">
                                    <field name="user_id"/>
                                </group>
                            </group>
                            <group string="Address">
                                <field name="address"
                                       nolabel="1"
                                       placeholder="Street, city, province, and any other address details..."/>
                            </group>
                        </page>
                        <page string="Enrollments" name="enrollments_tab">
                            <field name="enrollment_ids">
                                <list editable="bottom">
                                    <field name="section_id"/>
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="semester_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status" widget="badge" decoration-success="status == 'enrolled'" decoration-info="status == 'completed'" decoration-danger="status == 'dropped'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fees &amp; Payments" name="fees_tab" groups="school_management.group_school_admin,school_management.group_school_student">
                            <group>
                                <group string="Fee Summary">
                                    <field name="fee_total" widget="monetary"/>
                                    <field name="fee_paid" widget="monetary"/>
                                    <field name="fee_balance" widget="monetary"/>
                                </group>
                            </group>
                            <separator string="Invoices"/>
                            <field name="fee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="due_date"/>
                                    <field name="academic_year_id"/>
                                    <field name="semester_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="total_amount" widget="monetary" sum="Total"/>
                                    <field name="paid_amount" widget="monetary" sum="Paid"/>
                                    <field name="balance" widget="monetary" sum="Balance"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'paid'" decoration-warning="state == 'posted'" decoration-danger="state == 'canceled'"/>
                                </list>
                            </field>
                            <separator string="Payments"/>
                            <field name="payment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="fee_id"/>
                                    <field name="payment_method"/>
                                    <field name="amount" widget="monetary" sum="Total Payments"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-danger="state == 'canceled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Academic Results" name="academic_results_tab" groups="school_management.group_school_admin,school_management.group_school_student">
                            <separator string="Report Cards"/>
                            <field name="report_card_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="academic_year_id"/>
                                    <field name="semester_id"/>
                                    <field name="gpa"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-warning="state == 'generated'"/>
                                </list>
                            </field>
                            <separator string="Transcripts"/>
                            <field name="transcript_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="total_credits"/>
                                    <field name="cumulative_gpa"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-warning="state == 'generated'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Submissions" name="submissions_tab">
                            <field name="submission_ids" readonly="1">
                                <list>
                                    <field name="assignment_id"/>
                                    <field name="subject_id"/>
                                    <field name="section_id"/>
                                    <field name="submitted_on"/>
                                    <field name="score"/>
                                    <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state == 'evaluated'" decoration-warning="state == 'returned'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes &amp; Remarks" name="notes_tab">
                            <field name="notes"
                                   nolabel="1"
                                   placeholder="Add administrative remarks or student background information..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_university_student_search" model="ir.ui.view">
        <field name="name">university.student.search</field>
        <field name="model">university.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name"/>
                <field name="student_id"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="department_id"/>
                <field name="faculty_id"/>
                <separator/>
                <filter string="Active Students" name="filter_status_active" domain="[('status', '=', 'active')]"/>
                <filter string="Suspended" name="filter_status_suspended" domain="[('status', '=', 'suspended')]"/>
                <filter string="Graduated" name="filter_status_graduated" domain="[('status', '=', 'graduated')]"/>
                <separator/>
                <filter string="Active Records" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived Records" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Program" name="group_by_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Academic Year" name="group_by_academic_year" context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Gender" name="group_by_gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== WINDOW ACTION ==================== -->
    <record id="action_university_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">university.student</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_university_student_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first student record</p>
            <p>Add students and manage their academic and personal records.</p>
        </field>
    </record>



    <record id="action_university_student_profile" model="ir.actions.act_window">
        <field name="name">My Profile</field>
        <field name="res_model">university.student</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('user_id', '=', uid)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="search_view_id" ref="view_university_student_search"/>
    </record>
</odoo>
