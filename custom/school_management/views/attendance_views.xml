<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_attendance_list" model="ir.ui.view">
        <field name="name">university.attendance.list</field>
        <field name="model">university.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" sample="1">
                <field name="date"/>
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="teacher_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'present'"
                       decoration-danger="status == 'absent'"/>
            </list>
        </field>
    </record>

    <record id="view_university_attendance_form" model="ir.ui.view">
        <field name="name">university.attendance.form</field>
        <field name="model">university.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="student_id"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="section_id"/>
                            <field name="teacher_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_university_attendance_search" model="ir.ui.view">
        <field name="name">university.attendance.search</field>
        <field name="model">university.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="student_id"/>
                <field name="section_id"/>
                <field name="teacher_id"/>
                <filter string="Present" name="filter_present" domain="[('status', '=', 'present')]"/>
                <filter string="Absent" name="filter_absent" domain="[('status', '=', 'absent')]"/>
                <group>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Section" name="group_by_section" context="{'group_by': 'section_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_university_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">university.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_university_attendance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No attendance records found.</p>
            <p>Record attendance for students in their class sections.</p>
        </field>
    </record>

    <menuitem
        id="menu_university_attendance"
        name="Attendance"
        parent="menu_university_academic_category"
        action="action_university_attendance"
        sequence="35"
        groups="school_management.group_school_teacher"
    />
</odoo>
