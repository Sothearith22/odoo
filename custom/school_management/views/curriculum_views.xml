<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View -->
    <record id="view_university_curriculum_search" model="ir.ui.view">
        <field name="name">university.curriculum.search</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <search string="Search Curriculums">
                <field name="name"/>
                <field name="program_id"/>
                <field name="session_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Program" name="group_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_university_curriculum_list" model="ir.ui.view">
        <field name="name">university.curriculum.list</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <list string="Curriculums">
                <field name="name"/>
                <field name="program_id"/>
                <field name="session_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_university_curriculum_form" model="ir.ui.view">
        <field name="name">university.curriculum.form</field>
        <field name="model">university.curriculum</field>
        <field name="arch" type="xml">
            <form string="Curriculum">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bachelor of CS - 2026"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_id"/>
                            <field name="session_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Curriculum Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" default_order="year_level, semester, subject_id">
                                    <field name="year_level"/>
                                    <field name="semester"/>
                                    <field name="subject_id"/>
                                    <field name="credits" readonly="1"/>
                                    <field name="required" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_university_curriculum" model="ir.actions.act_window">
        <field name="name">Curriculums</field>
        <field name="res_model">university.curriculum</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_university_curriculum_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create the first curriculum!
            </p>
            <p>
                A curriculum represents the study plan for a specific Program and Session.
            </p>
        </field>
    </record>

</odoo>
