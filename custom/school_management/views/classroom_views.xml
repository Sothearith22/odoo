<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_university_classroom_list" model="ir.ui.view">
        <field name="name">university.classroom.list</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <list string="Classrooms" sample="1" decoration-muted="status != 'available'">
                <field name="name" decoration-bf="1"/>
                <field name="building"/>
                <field name="room_type" widget="badge"/>
                <field name="capacity" string="Capacity"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-warning="status == 'occupied'"
                       decoration-danger="status == 'maintenance'"
                       decoration-muted="status == 'inactive'"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_classroom_form" model="ir.ui.view">
        <field name="name">university.classroom.form</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Room Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Lab A101" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Location &amp; Type">
                            <field name="building"/>
                            <field name="room_type"/>
                            <field name="status"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_classroom_search" model="ir.ui.view">
        <field name="name">university.classroom.search</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <search string="Search Classrooms">
                <field name="name"/>
                <field name="building"/>
                <separator/>
                <filter string="Available" name="filter_available" domain="[('status', '=', 'available')]"/>
                <filter string="Maintenance" name="filter_maintenance" domain="[('status', '=', 'maintenance')]"/>
                <filter string="Occupied" name="filter_occupied" domain="[('status', '=', 'occupied')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Building" name="group_by_building" context="{'group_by': 'building'}"/>
                    <filter string="Room Type" name="group_by_type" context="{'group_by': 'room_type'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
                <searchpanel>
                    <field name="room_type" icon="fa-building" enable_counters="1" select="multi"/>
                    <field name="status" icon="fa-circle" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_classroom_kanban" model="ir.ui.view">
        <field name="name">university.classroom.kanban</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <kanban sample="1" quick_create="false">
                <field name="name"/>
                <field name="building"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <main class="p-3 d-flex flex-column justify-content-between h-100">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="fs-5 o_kanban_record_title text-truncate me-2">
                                    <field name="name"/>
                                </strong>
                                <field name="status" widget="badge"
                                       decoration-success="status == 'available'"
                                       decoration-warning="status == 'occupied'"
                                       decoration-danger="status == 'maintenance'"
                                       decoration-muted="status == 'inactive'"/>
                            </div>
                            <div class="d-flex flex-column gap-1 text-muted small my-2">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-building text-secondary me-2" title="Building"/>
                                    <span>Building <field name="building"/></span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-tag text-secondary me-2" title="Room Type"/>
                                    <field name="room_type"/>
                                </div>
                            </div>
                            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="badge text-bg-light border text-secondary">
                                    <i class="fa fa-users me-1" title="Capacity"/>
                                    <field name="capacity"/> seats
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_university_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">university.classroom</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_university_classroom_search"/>
    </record>

</odoo>
