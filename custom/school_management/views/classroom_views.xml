<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="view_university_classroom_list" model="ir.ui.view">
        <field name="name">university.classroom.list</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <list string="Classrooms" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="building"/>
                <field name="room_type" widget="badge"/>
                <field name="capacity"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_university_classroom_form" model="ir.ui.view">
        <field name="name">university.classroom.form</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <form string="Classroom">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_title">
                        <label for="name" string="Room Name "/>
                        <h1>
                            <field name="name" placeholder="e.g. Lab A101" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Location &amp; Type">
                            <field name="building"/>
                            <field name="room_type"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_university_classroom_search" model="ir.ui.view">
        <field name="name">university.classroom.search</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <search string="Search Classrooms">
                <field name="name"/>
                <field name="building"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Building" name="group_by_building" context="{'group_by': 'building'}"/>
                    <filter string="Room Type" name="group_by_type" context="{'group_by': 'room_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- KANBAN VIEW -->
    <record id="view_university_classroom_kanban" model="ir.ui.view">
        <field name="name">university.classroom.kanban</field>
        <field name="model">university.classroom</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="room_type" quick_create="false">
                <field name="name"/>
                <field name="building"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <templates>
                    <t t-name="card">
                        <main class="ms-2 p-3">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="fs-5 o_kanban_record_title"><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-building me-1" title="Building"/>
                                <field name="building"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-tag me-1" title="Room Type"/>
                                <field name="room_type"/>
                            </div>
                            <div class="mt-2">
                                <span class="badge text-bg-secondary"><field name="capacity"/> Capacity</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="action_university_classroom" model="ir.actions.act_window">
        <field name="name">Classrooms</field>
        <field name="res_model">university.classroom</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_university_classroom_search"/>
    </record>

</odoo>