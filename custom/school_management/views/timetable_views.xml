<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_university_timeslot_list" model="ir.ui.view">
        <field name="name">university.timeslot.list</field>
        <field name="model">university.timeslot</field>
        <field name="arch" type="xml">
            <list string="Timeslots">
                <field name="name"/>
                <field name="day_of_week"/>
                <field name="start_hour" widget="float_time"/>
                <field name="end_hour" widget="float_time"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_university_timeslot_form" model="ir.ui.view">
        <field name="name">university.timeslot.form</field>
        <field name="model">university.timeslot</field>
        <field name="arch" type="xml">
            <form string="Timeslot">
                <sheet>
                    <group>
                        <field name="day_of_week"/>
                        <field name="start_hour" widget="float_time"/>
                        <field name="end_hour" widget="float_time"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_university_timeslot" model="ir.actions.act_window">
        <field name="name">Timeslots</field>
        <field name="res_model">university.timeslot</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_university_timetable_generation_wizard_form" model="ir.ui.view">
        <field name="name">university.timetable.generation.wizard.form</field>
        <field name="model">university.timetable.generation.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Timetable">
                <group>
                    <group>
                        <field name="academic_year_id"/>
                        <field name="semester_id"/>
                        <field name="start_date"/>
                        <field name="week_count"/>
                        <field name="sessions_per_week"/>
                        <field name="replace_existing_drafts"/>
                    </group>
                    <group>
                        <field name="section_ids" widget="many2many_tags"/>
                        <field name="timeslot_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_timetable" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_university_timetable_generation_wizard" model="ir.actions.act_window">
        <field name="name">Generate Timetable</field>
        <field name="res_model">university.timetable.generation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_university_timetable_slot_tree" model="ir.ui.view">
        <field name="name">university.timetable.slot.tree</field>
        <field name="model">university.timetable.slot</field>
        <field name="arch" type="xml">
            <list string="Timetable">
                <button name="action_track_attendance" type="object" string="Track Attendance" icon="fa-calendar-check-o" groups="school_management.group_school_teacher,school_management.group_school_admin"/>
                <button name="action_view_assignments" type="object" string="Assignments" icon="fa-tasks"/>
                <field name="name"/>
                <field name="session_type" widget="badge" decoration-info="session_type == 'lecture'" decoration-success="session_type == 'lab'" decoration-warning="session_type == 'exam'"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="classroom_id"/>
                <field name="start_time" string="Class Date"/>
                <field name="end_time"/>
                <field name="location" optional="hide"/>
                <field name="is_room_changed" widget="boolean_toggle" optional="show"/>
                <field name="generation_state" widget="badge" decoration-info="generation_state == 'draft'" decoration-success="generation_state == 'published'"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'completed'" 
                       decoration-warning="status == 'ongoing'"
                       decoration-info="status == 'upcoming'"
                       decoration-danger="status == 'cancelled'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'scheduled'"
                       decoration-warning="state == 'rescheduled'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="is_today" invisible="1"/>
                <field name="is_this_week" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_publish_timetable_slots" model="ir.actions.server">
        <field name="name">Publish Selected Slots</field>
        <field name="model_id" ref="model_university_timetable_slot"/>
        <field name="binding_model_id" ref="model_university_timetable_slot"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_publish()</field>
        <field name="group_ids" eval="[(4, ref('school_management.group_school_admin')), (4, ref('school_management.group_school_hod'))]"/>
    </record>

    <record id="view_university_timetable_slot_form" model="ir.ui.view">
        <field name="name">university.timetable.slot.form</field>
        <field name="model">university.timetable.slot</field>
        <field name="arch" type="xml">
            <form string="Timetable Slot">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary" invisible="generation_state == 'published'" groups="school_management.group_school_admin,school_management.group_school_hod"/>
                    <button name="action_set_draft" type="object" string="Set to Draft" class="btn-secondary" invisible="generation_state == 'draft'" groups="school_management.group_school_admin,school_management.group_school_hod"/>
                    <button name="action_track_attendance" type="object" string="Track Attendance" class="btn-primary" icon="fa-calendar-check-o" groups="school_management.group_school_teacher,school_management.group_school_admin"/>
                    <button name="action_create_assignment" type="object" string="Create Assignment" class="btn-secondary" icon="fa-plus-circle" groups="school_management.group_school_teacher,school_management.group_school_admin"/>
                    <button name="action_upload_material" type="object" string="Course Materials" class="btn-secondary" icon="fa-paperclip"/>
                    <button name="action_cancel_session" type="object" string="Cancel Session" class="btn-outline-danger" invisible="state == 'cancelled'" groups="school_management.group_school_teacher,school_management.group_school_admin" confirm="Are you sure you want to cancel this class session?"/>
                    <field name="status" widget="statusbar" statusbar_visible="upcoming,ongoing,completed"/>
                </header>
                <sheet>
                    <field name="is_today" invisible="1"/>
                    <field name="is_this_week" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object" class="oe_stat_button" icon="fa-tasks">
                            <span class="o_stat_text">Assignments</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="badge text-bg-warning mb-2" invisible="not is_room_changed">Room Changed</span>
                        <span class="badge text-bg-danger mb-2" invisible="state != 'cancelled'">Cancelled</span>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Class &amp; Subject">
                            <field name="section_id"/>
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                            <field name="session_type"/>
                            <field name="enrolled_student_count"/>
                        </group>
                        <group string="Schedule &amp; Room">
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="classroom_id"/>
                            <field name="room_capacity"/>
                            <field name="is_room_changed"/>
                            <field name="original_classroom_id" invisible="not is_room_changed"/>
                            <field name="state" widget="badge"/>
                            <field name="generation_state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Session Notes" name="notes">
                            <field name="notes" placeholder="Add lecture topics, required reading, lab instructions, or announcements for this session..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_university_timetable_slot_calendar" model="ir.ui.view">
        <field name="name">university.timetable.slot.calendar</field>
        <field name="model">university.timetable.slot</field>
        <field name="arch" type="xml">
            <calendar string="Class Timetable"
                      date_start="start_time"
                      date_stop="end_time"
                      color="subject_id"
                      mode="week"
                      scales="week,day"
                      event_limit="8"
                      quick_create="0"
                      create="0"
                      delete="0"
                      event_open_popup="true">
                <field name="subject_id"/>
                <field name="section_id" filters="1"/>
                <field name="classroom_id"/>
                <field name="teacher_id" filters="1"/>
                <field name="session_type"/>
                <field name="location"/>
                <field name="status" widget="badge"/>
                <field name="state" widget="badge"/>
            </calendar>
        </field>
    </record>

    <record id="view_university_timetable_slot_kanban" model="ir.ui.view">
        <field name="name">university.timetable.slot.kanban</field>
        <field name="model">university.timetable.slot</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" sample="1" quick_create="0">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="section_id"/>
                <field name="teacher_id"/>
                <field name="classroom_id"/>
                <field name="session_type"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="status"/>
                <field name="state"/>
                <field name="is_room_changed"/>
                <field name="enrolled_student_count"/>
                <field name="room_capacity"/>
                <field name="is_today"/>
                <field name="is_this_week"/>
                <templates>
                    <t t-name="card">
                        <main class="p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge text-bg-primary fs-6 px-2 py-1">
                                    <field name="subject_id"/>
                                </span>
                                <div class="d-flex gap-1">
                                    <span t-if="record.is_room_changed.raw_value" class="badge text-bg-warning">Room Changed</span>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'completed'"
                                           decoration-warning="status == 'ongoing'"
                                           decoration-info="status == 'upcoming'"
                                           decoration-danger="status == 'cancelled'"/>
                                </div>
                            </div>
                            <div class="fw-bold fs-5 text-dark mb-1">
                                <field name="section_id"/>
                            </div>
                            <div class="text-primary small fw-semibold mb-2">
                                <i class="fa fa-clock-o me-1" title="Class Time"/>
                                <field name="start_time" widget="datetime"/> – <field name="end_time" widget="datetime"/>
                            </div>
                            <div class="d-flex flex-column gap-1 text-muted small border-top pt-2">
                                <div t-if="record.classroom_id.value">
                                    <i class="fa fa-map-marker text-danger me-1" title="Room Location"/>
                                    <field name="classroom_id"/>
                                </div>
                                <div t-if="record.teacher_id.value">
                                    <i class="fa fa-user-circle text-secondary me-1" title="Instructor"/>
                                    <field name="teacher_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-users text-muted me-1" title="Capacity"/>
                                    <t t-esc="record.enrolled_student_count.value or 0"/> / <t t-esc="record.room_capacity.value or 0"/> Students
                                </div>
                            </div>
                            <div class="mt-2 pt-2 border-top d-flex justify-content-end gap-1">
                                <button name="action_track_attendance" type="object" class="btn btn-sm btn-outline-success" string="Attendance" icon="fa-check-circle" groups="school_management.group_school_teacher,school_management.group_school_admin">
                                    Attendance
                                </button>
                                <button name="action_view_assignments" type="object" class="btn btn-sm btn-outline-primary" string="Assignments" icon="fa-tasks">
                                    Assignments
                                </button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_university_timetable_slot_search" model="ir.ui.view">
        <field name="name">university.timetable.slot.search</field>
        <field name="model">university.timetable.slot</field>
        <field name="arch" type="xml">
            <search string="Search Timetable Slots">
                <field name="name"/>
                <field name="section_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="classroom_id"/>
                <filter string="Today" name="filter_today" domain="[('is_today', '=', True)]"/>
                <filter string="This Week" name="filter_this_week" domain="[('is_this_week', '=', True)]"/>
                <separator/>
                <filter string="Lecture" name="filter_lecture" domain="[('session_type', '=', 'lecture')]"/>
                <filter string="Lab" name="filter_lab" domain="[('session_type', '=', 'lab')]"/>
                <filter string="Exam" name="filter_exam" domain="[('session_type', '=', 'exam')]"/>
                <separator/>
                <filter string="Upcoming" name="filter_upcoming" domain="[('status', '=', 'upcoming')]"/>
                <filter string="Ongoing" name="filter_ongoing" domain="[('status', '=', 'ongoing')]"/>
                <filter string="Completed" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="Room Changed" name="filter_room_changed" domain="[('is_room_changed', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('generation_state', '=', 'draft')]"/>
                <filter string="Published" name="filter_published" domain="[('generation_state', '=', 'published')]"/>
                <group>
                    <filter string="Teacher" name="group_by_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Section" name="group_by_section" context="{'group_by': 'section_id'}"/>
                    <filter string="Subject" name="group_by_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Session Type" name="group_by_type" context="{'group_by': 'session_type'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                </group>
                <searchpanel>
                    <field name="section_id" icon="fa-users" enable_counters="1"/>
                    <field name="subject_id" icon="fa-book" enable_counters="1"/>
                    <field name="session_type" icon="fa-tags" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Unified OWL Schedule Client Action -->
    <record id="action_university_schedule_view" model="ir.actions.client">
        <field name="name">University Schedule</field>
        <field name="tag">university_schedule_view</field>
        <field name="target">main</field>
    </record>

    <!-- Standard Act Window for backend management -->
    <record id="action_university_timetable_slot" model="ir.actions.act_window">
        <field name="name">Class Timetable</field>
        <field name="res_model">university.timetable.slot</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="search_view_id" ref="view_university_timetable_slot_search"/>
        <field name="context">{'default_mode': 'week', 'calendar_mode': 'week'}</field>
    </record>

    <record id="action_university_timetable_slot_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_university_timetable_slot_calendar"/>
        <field name="act_window_id" ref="action_university_timetable_slot"/>
    </record>

    <record id="action_university_timetable_slot_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_university_timetable_slot_kanban"/>
        <field name="act_window_id" ref="action_university_timetable_slot"/>
    </record>

    <record id="action_university_timetable_slot_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_university_timetable_slot_tree"/>
        <field name="act_window_id" ref="action_university_timetable_slot"/>
    </record>

    <record id="action_university_timetable_slot_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="4"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_university_timetable_slot_form"/>
        <field name="act_window_id" ref="action_university_timetable_slot"/>
    </record>

    <!-- Legacy Action preserved, now defaulting to published slots -->
    <record id="action_university_timetable_slot_student" model="ir.actions.act_window">
        <field name="name">Schedule (Backend)</field>
        <field name="res_model">university.timetable.slot</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="domain">[('generation_state', '=', 'published')]</field>
        <field name="context">{'default_mode': 'week', 'calendar_mode': 'week', 'create': False, 'edit': False, 'delete': False}</field>
        <field name="search_view_id" ref="view_university_timetable_slot_search"/>
    </record>

    <record id="action_university_timetable_slot_teacher" model="ir.actions.act_window">
        <field name="name">My Timetable (Backend)</field>
        <field name="res_model">university.timetable.slot</field>
        <field name="view_mode">calendar,kanban,list,form</field>
        <field name="domain">[('teacher_id.user_id', '=', uid), ('generation_state', '=', 'published')]</field>
        <field name="context">{'default_mode': 'week', 'calendar_mode': 'week'}</field>
        <field name="search_view_id" ref="view_university_timetable_slot_search"/>
    </record>
</odoo>
