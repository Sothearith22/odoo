<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_school_dashboard_form" model="ir.ui.view">
        <field name="name">school.dashboard.form</field>
        <field name="model">school.dashboard</field>
        <field name="arch" type="xml">
            <form string="Dashboard" edit="false" delete="false" class="o_school_dashboard">
                <field name="currency_id" invisible="1"/>
                <div class="d-flex flex-row w-100 h-100 o_school_dashboard_layout" style="background-color: #f8f9fa;">
                    
                    <!-- Responsive Sidebar (Offcanvas on mobile, sticky block on desktop) -->
                    <div class="sidebar-container offcanvas-lg offcanvas-start shadow d-flex flex-column" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel" 
                         style="background-color: #6f5aa8; position: sticky; top: 0; height: 100vh; overflow-y: auto; transition: width 0.3s ease; z-index: 1040;">
                         
                        <!-- Sidebar Header -->
                        <div class="offcanvas-header border-bottom border-light border-opacity-25 p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center flex-grow-1 overflow-hidden">
                                <i class="fa fa-university fa-2x text-white me-3 sidebar-icon" title="University"></i>
                                <h4 class="offcanvas-title mb-0 fw-bold text-white text-nowrap sidebar-text" id="sidebarMenuLabel">University</h4>
                            </div>
                            <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
                        </div>
                        
                        <!-- Sidebar Navigation Items -->
                        <div class="offcanvas-body p-2 d-flex flex-column gap-1 overflow-auto flex-grow-1 sidebar-body">
                            
                            <!-- Dashboard -->
                            <div class="nav-item mb-2">
                                <button type="object" name="action_open_students" class="btn w-100 text-start text-white px-3 py-2 rounded-3 fw-bold border-0 d-flex align-items-center sidebar-btn" style="background-color: rgba(255,255,255,0.2);" data-bs-toggle="tooltip" data-bs-placement="right" title="Dashboard">
                                    <i class="fa fa-dashboard fa-lg sidebar-icon"></i><span class="sidebar-text ms-2">Dashboard</span>
                                </button>
                            </div>
                            
                            <!-- Structure -->
                            <div class="nav-item">
                                <button class="btn w-100 text-start text-white px-3 py-2 rounded-3 fw-bold border-0 sidebar-btn d-flex align-items-center justify-content-between collapsed" 
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapseStructure" aria-expanded="false" data-bs-toggle-tooltip="tooltip" data-bs-placement="right" title="Structure">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <i class="fa fa-sitemap fa-lg sidebar-icon opacity-75"></i><span class="sidebar-text ms-2 text-nowrap">Structure</span>
                                    </div>
                                    <i class="fa fa-chevron-down small opacity-50 sidebar-arrow"></i>
                                </button>
                                <div class="collapse" id="collapseStructure">
                                    <div class="d-flex flex-column ps-4 pe-2 py-1 gap-1 sidebar-submenu">
                                        <button name="action_open_faculties" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Faculties</button>
                                        <button name="action_open_departments" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Departments</button>
                                        <button name="action_open_programs" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Programs</button>
                                        <button name="action_open_subjects" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Subjects</button>
                                        <button name="action_open_sections" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Class Sections</button>
                                        <button name="action_open_classrooms" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Classrooms</button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Students -->
                            <div class="nav-item">
                                <button class="btn w-100 text-start text-white px-3 py-2 rounded-3 fw-bold border-0 sidebar-btn d-flex align-items-center justify-content-between collapsed" 
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapseStudents" aria-expanded="false" data-bs-toggle-tooltip="tooltip" data-bs-placement="right" title="Students">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <i class="fa fa-graduation-cap fa-lg sidebar-icon opacity-75"></i><span class="sidebar-text ms-2 text-nowrap">Students</span>
                                    </div>
                                    <i class="fa fa-chevron-down small opacity-50 sidebar-arrow"></i>
                                </button>
                                <div class="collapse" id="collapseStudents">
                                    <div class="d-flex flex-column ps-4 pe-2 py-1 gap-1 sidebar-submenu">
                                        <button name="action_open_students" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">All Students</button>
                                        <button name="action_open_enrollments" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Enrollment</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Teachers -->
                            <div class="nav-item">
                                <button class="btn w-100 text-start text-white px-3 py-2 rounded-3 fw-bold border-0 sidebar-btn d-flex align-items-center justify-content-between collapsed" 
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapseTeachers" aria-expanded="false" data-bs-toggle-tooltip="tooltip" data-bs-placement="right" title="Teachers">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <i class="fa fa-chalkboard-teacher fa-lg sidebar-icon opacity-75"></i><span class="sidebar-text ms-2 text-nowrap">Teachers</span>
                                    </div>
                                    <i class="fa fa-chevron-down small opacity-50 sidebar-arrow"></i>
                                </button>
                                <div class="collapse" id="collapseTeachers">
                                    <div class="d-flex flex-column ps-4 pe-2 py-1 gap-1 sidebar-submenu">
                                        <button name="action_open_teachers" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">All Teachers</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Academic -->
                            <div class="nav-item">
                                <button class="btn w-100 text-start text-white px-3 py-2 rounded-3 fw-bold border-0 sidebar-btn d-flex align-items-center justify-content-between collapsed" 
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapseAcademic" aria-expanded="false" data-bs-toggle-tooltip="tooltip" data-bs-placement="right" title="Academic">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <i class="fa fa-calendar fa-lg sidebar-icon opacity-75"></i><span class="sidebar-text ms-2 text-nowrap">Academic</span>
                                    </div>
                                    <i class="fa fa-chevron-down small opacity-50 sidebar-arrow"></i>
                                </button>
                                <div class="collapse" id="collapseAcademic">
                                    <div class="d-flex flex-column ps-4 pe-2 py-1 gap-1 sidebar-submenu">
                                        <button name="action_open_academic_years" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Academic Years</button>
                                        <button name="action_open_sections" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Class Schedules</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Finance -->
                            <div class="nav-item">
                                <button class="btn w-100 text-start text-white px-3 py-2 rounded-3 fw-bold border-0 sidebar-btn d-flex align-items-center justify-content-between collapsed" 
                                        type="button" data-bs-toggle="collapse" data-bs-target="#collapseFinance" aria-expanded="false" data-bs-toggle-tooltip="tooltip" data-bs-placement="right" title="Finance">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <i class="fa fa-file-invoice-dollar fa-lg sidebar-icon opacity-75"></i><span class="sidebar-text ms-2 text-nowrap">Finance</span>
                                    </div>
                                    <i class="fa fa-chevron-down small opacity-50 sidebar-arrow"></i>
                                </button>
                                <div class="collapse" id="collapseFinance">
                                    <div class="d-flex flex-column ps-4 pe-2 py-1 gap-1 sidebar-submenu">
                                        <button name="action_open_fees" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Invoices</button>
                                        <button name="action_open_payments" type="object" class="btn btn-link w-100 text-start text-white px-3 py-1 rounded-3 text-decoration-none border-0 sidebar-btn small">Payments</button>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Main Content Wrapper (Header + Dashboard) -->
                    <div class="flex-grow-1 d-flex flex-column" style="min-width: 0;">
                        
                        <!-- Top Header -->
                        <div class="bg-white p-3 px-4 shadow-sm d-flex justify-content-between align-items-center sticky-top z-1 border-bottom">
                            <div class="d-flex align-items-center">
                                <!-- Mobile offcanvas toggle -->
                                <button class="btn btn-light d-lg-none me-3 border-0 shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                                    <i class="fa fa-bars fa-lg text-primary" title="Menu"></i>
                                </button>
                                <!-- Desktop slim sidebar toggle. Not a <label for>: Odoo requires that to be a field. -->
                                <div class="d-none d-lg-inline-block me-3 position-relative rounded shadow-sm bg-light" style="width: 38px; height: 38px;">
                                    <input type="checkbox" class="o_sidebar_toggle" title="Toggle sidebar"
                                           style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 1; margin: 0;"/>
                                    <div class="d-flex align-items-center justify-content-center h-100 w-100">
                                        <i class="fa fa-bars fa-lg text-primary" title="Toggle sidebar"></i>
                                    </div>
                                </div>
                                
                                <div>
                                    <h3 class="fw-bold mb-0 text-dark">University Management</h3>
                                    <div class="text-muted small d-none d-md-block">Overview of academic structure, people, courses, and operations</div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button name="action_create_student" type="object" class="btn btn-primary btn-sm shadow-sm rounded-pill px-3">
                                    <i class="fa fa-user-plus me-1" title="New Student"></i><span class="d-none d-md-inline">New Student</span>
                                </button>
                                <button name="action_create_enrollment" type="object" class="btn btn-outline-primary btn-sm shadow-sm rounded-pill px-3 d-none d-md-inline-block">
                                    <i class="fa fa-clipboard-check me-1" title="Enroll Student"></i>Enroll Student
                                </button>
                                <button name="action_create_fee" type="object" class="btn btn-outline-primary btn-sm shadow-sm rounded-pill px-3 d-none d-md-inline-block">
                                    <i class="fa fa-file-invoice-dollar me-1" title="New Fee Invoice"></i>New Fee Invoice
                                </button>
                            </div>
                        </div>

                        <!-- Dashboard Content Area -->
                        <div class="p-4 pt-0 flex-grow-1 overflow-auto bg-light">
                            <!-- Custom CSS for Form View overrides and slim sidebar -->
                            <style>
                                .o_form_view .o_form_sheet_bg { padding: 0 !important; background: none !important; }
                                .o_form_view .o_form_sheet { padding: 0 !important; max-width: 100% !important; margin: 0 !important; border: none !important; }
                                .sidebar-btn:hover { background-color: rgba(255, 255, 255, 0.1) !important; }
                                .sidebar-container { width: 260px; background-color: #6f5aa8 !important; }
                                /* Slim sidebar: checkbox lives in the header, so use :has() instead of sibling ~ */
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container { width: 75px !important; }
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .sidebar-text,
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .sidebar-arrow,
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .sidebar-submenu { display: none !important; }
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .sidebar-icon { margin-right: 0 !important; font-size: 1.25rem; }
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .offcanvas-header { justify-content: center !important; padding-left: 0 !important; padding-right: 0 !important; }
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .sidebar-btn { justify-content: center !important; padding-left: 0 !important; padding-right: 0 !important; }
                                .o_school_dashboard_layout:has(.o_sidebar_toggle:checked) .sidebar-container .nav-item .collapse { display: none !important; }
                                .hover-shadow-sm { transition: box-shadow 0.2s ease, transform 0.2s ease; }
                                .hover-shadow-sm:hover { box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.1) !important; transform: translateY(-2px); }
                            </style>


                    <!-- 1. PRIMARY METRICS (CLICKABLE KPI CARDS) -->
                    <div class="row g-3 mb-4">
                        <!-- Students -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <button name="action_open_students" type="object" class="btn p-0 text-start w-100 h-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 h-100 bg-white" style="border-left: 4px solid #4f46e5 !important;">
                                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Students</span>
                                            <div class="fs-2 fw-bold text-dark"><field name="student_count"/></div>
                                        </div>
                                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: #eef2ff; color: #4f46e5; width: 48px; height: 48px;">
                                            <i class="fa fa-graduation-cap fa-lg" title="Students"></i>
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </div>

                        <!-- Teachers -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <button name="action_open_teachers" type="object" class="btn p-0 text-start w-100 h-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 h-100 bg-white" style="border-left: 4px solid #10b981 !important;">
                                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Teachers</span>
                                            <div class="fs-2 fw-bold text-dark"><field name="teacher_count"/></div>
                                        </div>
                                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: #ecfdf5; color: #10b981; width: 48px; height: 48px;">
                                            <i class="fa fa-chalkboard-teacher fa-lg" title="Teachers"></i>
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </div>

                        <!-- Programs -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <button name="action_open_programs" type="object" class="btn p-0 text-start w-100 h-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 h-100 bg-white" style="border-left: 4px solid #f59e0b !important;">
                                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Programs</span>
                                            <div class="fs-2 fw-bold text-dark"><field name="program_count"/></div>
                                        </div>
                                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: #fffbeb; color: #f59e0b; width: 48px; height: 48px;">
                                            <i class="fa fa-certificate fa-lg" title="Programs"></i>
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </div>

                        <!-- Departments -->
                        <div class="col-12 col-sm-6 col-xl-3">
                            <button name="action_open_departments" type="object" class="btn p-0 text-start w-100 h-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 h-100 bg-white" style="border-left: 4px solid #06b6d4 !important;">
                                    <div class="card-body p-3 d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="text-muted text-uppercase fw-semibold small d-block mb-1">Departments</span>
                                            <div class="fs-2 fw-bold text-dark"><field name="department_count"/></div>
                                        </div>
                                        <div class="rounded-circle p-3 d-flex align-items-center justify-content-center" style="background-color: #ecfeff; color: #06b6d4; width: 48px; height: 48px;">
                                            <i class="fa fa-building fa-lg" title="Departments"></i>
                                        </div>
                                    </div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- 2. SECONDARY ACADEMIC CARDS (4 COMPACT STATS) -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <button name="action_open_faculties" type="object" class="btn p-0 text-start w-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between hover-shadow-sm">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #f3f4f6;">
                                            <i class="fa fa-university text-secondary" title="Faculties"></i>
                                        </div>
                                        <span class="text-muted small fw-semibold">Faculties</span>
                                    </div>
                                    <span class="fs-5 fw-bold text-dark"><field name="faculty_count"/></span>
                                </div>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button name="action_open_subjects" type="object" class="btn p-0 text-start w-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between hover-shadow-sm">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #f3f4f6;">
                                            <i class="fa fa-book text-secondary" title="Subjects"></i>
                                        </div>
                                        <span class="text-muted small fw-semibold">Subjects</span>
                                    </div>
                                    <span class="fs-5 fw-bold text-dark"><field name="subject_count"/></span>
                                </div>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button name="action_open_sections" type="object" class="btn p-0 text-start w-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between hover-shadow-sm">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #f3f4f6;">
                                            <i class="fa fa-users text-secondary" title="Class Sections"></i>
                                        </div>
                                        <span class="text-muted small fw-semibold">Class Sections</span>
                                    </div>
                                    <span class="fs-5 fw-bold text-dark"><field name="section_count"/></span>
                                </div>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button name="action_open_classrooms" type="object" class="btn p-0 text-start w-100 border-0 bg-transparent">
                                <div class="card shadow-sm border-0 bg-white p-3 d-flex flex-row align-items-center justify-content-between hover-shadow-sm">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #f3f4f6;">
                                            <i class="fa fa-door-open text-secondary" title="Classrooms"></i>
                                        </div>
                                        <span class="text-muted small fw-semibold">Classrooms</span>
                                    </div>
                                    <span class="fs-5 fw-bold text-dark"><field name="classroom_count"/></span>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- 3. STUDENT STATISTICS BREAKDOWN -->
                    <div class="card shadow-sm border-0 mb-4 bg-white">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold text-dark">
                                <i class="fa fa-pie-chart text-primary me-2" title="Student Status Breakdown"></i>Student Academic Status Breakdown
                            </h5>
                            <button name="action_open_students" type="object" class="btn btn-sm btn-link text-decoration-none p-0 text-primary">
                                View All Students <i class="fa fa-arrow-right ms-1" title="Arrow"></i>
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4 text-center">
                                <div class="col-6 col-md-3 border-end">
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">
                                        <span class="badge rounded-pill bg-success-subtle text-success me-1 px-2">●</span>Active
                                    </div>
                                    <div class="fs-3 fw-bold text-success"><field name="active_student_count"/></div>
                                </div>
                                <div class="col-6 col-md-3 border-end">
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">
                                        <span class="badge rounded-pill bg-info-subtle text-info me-1 px-2">●</span>Graduated
                                    </div>
                                    <div class="fs-3 fw-bold text-info"><field name="graduated_student_count"/></div>
                                </div>
                                <div class="col-6 col-md-3 border-end">
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">
                                        <span class="badge rounded-pill bg-warning-subtle text-warning me-1 px-2">●</span>Suspended
                                    </div>
                                    <div class="fs-3 fw-bold text-warning"><field name="suspended_student_count"/></div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">
                                        <span class="badge rounded-pill bg-danger-subtle text-danger me-1 px-2">●</span>Dropped
                                    </div>
                                    <div class="fs-3 fw-bold text-danger"><field name="dropped_student_count"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. FEE STATUS -->
                    <div class="card shadow-sm border-0 mb-4 bg-white">
                        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                            <h5 class="mb-0 fw-bold text-dark">
                                <i class="fa fa-money text-success me-2" title="Fee Status"></i>Fee Status
                            </h5>
                            <button name="action_open_fees" type="object" class="btn btn-sm btn-link text-decoration-none p-0 text-primary">
                                View All Invoices <i class="fa fa-arrow-right ms-1" title="Arrow"></i>
                            </button>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4 text-center">
                                <div class="col-6 col-md-3 border-end">
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">Invoices</div>
                                    <div class="fs-3 fw-bold text-dark"><field name="fee_count"/></div>
                                </div>
                                <div class="col-6 col-md-3 border-end">
                                    <button name="action_open_payments" type="object" class="btn p-0 text-center w-100 border-0 bg-transparent">
                                        <div class="text-muted small text-uppercase fw-semibold mb-2">Paid</div>
                                        <div class="fs-3 fw-bold text-success"><field name="total_paid_fees" widget="monetary"/></div>
                                    </button>
                                </div>
                                <div class="col-6 col-md-3 border-end">
                                    <button name="action_open_unpaid_fees" type="object" class="btn p-0 text-center w-100 border-0 bg-transparent">
                                        <div class="text-muted small text-uppercase fw-semibold mb-2">Unpaid</div>
                                        <div class="fs-3 fw-bold text-danger"><field name="total_unpaid_fees" widget="monetary"/></div>
                                    </button>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small text-uppercase fw-semibold mb-2">Scholarship</div>
                                    <div class="fs-3 fw-bold text-info"><field name="total_scholarships" widget="monetary"/></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 5. BOTTOM ROW: OPERATIONS & ROADMAP -->
                    <div class="row g-4">
                        <!-- Quick Academic Operations -->
                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100 bg-white">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold text-dark">
                                        <i class="fa fa-bolt text-warning me-2" title="Quick Actions"></i>Quick Operations
                                    </h5>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-grid gap-2">
                                        <button name="action_open_academic_years" type="object" class="btn btn-light text-start d-flex justify-content-between align-items-center py-2 px-3">
                                            <span><i class="fa fa-calendar-check-o text-primary me-2" title="Calendar"></i>Academic Years &amp; Semesters</span>
                                            <i class="fa fa-chevron-right text-muted small" title="Go"></i>
                                        </button>
                                        <button name="action_open_sections" type="object" class="btn btn-light text-start d-flex justify-content-between align-items-center py-2 px-3">
                                            <span><i class="fa fa-users text-success me-2" title="Sections"></i>Class Sections &amp; Schedules</span>
                                            <i class="fa fa-chevron-right text-muted small" title="Go"></i>
                                        </button>
                                        <button name="action_open_enrollments" type="object" class="btn btn-light text-start d-flex justify-content-between align-items-center py-2 px-3">
                                            <span><i class="fa fa-clipboard-list text-info me-2" title="Enrollments"></i>Student Course Enrollments</span>
                                            <i class="fa fa-chevron-right text-muted small" title="Go"></i>
                                        </button>
                                        <button name="action_open_fees" type="object" class="btn btn-light text-start d-flex justify-content-between align-items-center py-2 px-3">
                                            <span><i class="fa fa-file-invoice-dollar text-success me-2" title="Fees"></i>Fee Invoices &amp; Payments</span>
                                            <i class="fa fa-chevron-right text-muted small" title="Go"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- System Modules Status -->
                        <div class="col-12 col-md-6">
                            <div class="card shadow-sm border-0 h-100 bg-white">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold text-dark">
                                        <i class="fa fa-cubes text-info me-2" title="Modules Status"></i>System Capabilities
                                    </h5>
                                </div>
                                <div class="card-body p-3">
                                    <ul class="list-group list-group-flush small">
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                            <span><i class="fa fa-check-circle text-success me-2" title="Active"></i>Structure (Faculties, Depts, Programs)</span>
                                            <span class="badge bg-success">Active</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                            <span><i class="fa fa-check-circle text-success me-2" title="Active"></i>Academic Calendar &amp; Class Sections</span>
                                            <span class="badge bg-success">Active</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                            <span><i class="fa fa-clock-o text-muted me-2" title="Next"></i>Attendance &amp; Examination System</span>
                                            <span class="badge bg-secondary">Next Phase</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                                            <span><i class="fa fa-check-circle text-success me-2" title="Active"></i>Fees, Invoicing &amp; Payments</span>
                                            <span class="badge bg-success">Active</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                        </div>
                    </div>
                </div>
            </form>
        </field>
    </record>

    <!-- ==================== WINDOW ACTION ==================== -->
    <record id="action_school_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">school.dashboard</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="school_dashboard_default"/>
        <field name="target">current</field>
    </record>
